#!/usr/bin/env wand
uses {Clock, FS.Write, IO, Net.Listen, Proc, Random, Shared}

-- The wmd server. Run it from the repo as ./wmd, or from a game directory
-- as wand github.com/wand-lang/wmd/wmd.

import Args
import IO
import Proc

let main = import ./driver/main

match Args.parse main.Opts.decoder (Proc.args ()) with
| Ok o -> main.run! o
| Error e -> (IO.println_err "wmd: %{e}"; Proc.exit 2)
