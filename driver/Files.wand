uses {FS.Read, FS.Write}

-- Library files by blueprint path: checking and saving them for the editor,
-- and moving one to another directory. Who may edit which is the realms'
-- to say.
--
-- A save goes parse, check, gate, format, write. The check reads the
-- source as typed, so its line numbers are the editor's buffer lines; the
-- file written is the formatted text.

import FS
import List
import Option
import Path
import Regex
import Result
import String
import Wand

let Driver = import ../driver

-- Lower-case words of letters, digits and _ between slashes, as
-- /r/home/ann/lamp. There is no `..`, so a path cannot leave the Library.
let valid? path = Regex.match? r/^(\/[a-z0-9_]+)+$/ path

-- The file of a blueprint path under the Library root `lib`.
let file_of (lib: Path) path = Path.join lib (Path.of_string ".%{path}.wand")

-- The directories a blueprint's file is in, from the Library root: r and
-- learning for /r/learning/lever.
let _dir path =
  List.reverse
    (List.drop 1 (List.reverse (List.filter (fn s -> s != "") (String.split "/" path))))

-- Where the relative import `rel` leads from the directories `dir`.
let _follow dir rel =
  List.fold_left
    (fn acc seg -> if seg == ".." then List.reverse (List.drop 1 (List.reverse acc))
      else if seg == "." || seg == "" then acc
      else List.concat acc [seg])
    dir
    (String.split "/" rel)

-- `source`, the file of `from`, written as the file of `to`: each relative
-- import names the same file from its new directory. /r/learning/lever
-- imports ../../std/driver, and its copy in /r/home/ann imports
-- ../../../std/driver.
let moved from to source =
  let fixed line =
    match Regex.capture r/^(.*import )(\.\.?\/\S+)(.*)$/ line with
    | [_, head, rel, tail] -> "%{head}%{Driver.import_from to "/%{String.join "/" (_follow (_dir from) rel)}"}%{tail}"
    | _ -> line
  in
  String.join "\n" (List.map fixed (String.lines source))

-- The effects Library code may perform. Raise is not in a check's effects:
-- a Library call that raises is a fault the driver catches.
let allowed_effects = ["Random"]

let _problem message =
  Driver.Problem(severity = "error", line = 1, col = 1, message = message)

let _problems (c: Wand.Checked) =
  List.map
    (fn (d: Wand.Diagnostic) -> Driver.Problem(
      severity = d.severity,
      line = d.line,
      col = d.col,
      message = d.message
    ))
    c.diagnostics

let _errors? problems = List.any? (fn (p: Driver.Problem) -> p.severity == "error") problems

-- Check `source` as the file of `path` in `lib`, then gate it: a file that
-- performs any effect but Random is refused, whatever its `uses` line
-- says.
let check (lib: Path) path source =
  match Wand.check_at (file_of lib path) source with
  | Error why -> Driver.Outcome(
    action = "check",
    path = path,
    ok = false,
    problems = [_problem why]
  )
  | Ok c -> (
    let refused =
      List.filter (fn e -> !(List.any? (fn a -> a == e) allowed_effects)) c.effects;
    let problems =
      List.concat
        (_problems c)
        (List.map
          (fn e -> _problem "the file performs %{e}; Library code may perform only Random")
          refused);
    Driver.Outcome(
      action = "check",
      path = path,
      ok = !(_errors? problems),
      problems = problems,
      effects = c.effects
    )
  )

-- Write `text` to the file of `path`, making its directory first.
let _write (lib: Path) path text =
  let file = file_of lib path;
  Result.and_then (fn _ -> FS.write_atomic file text) (FS.mkdir (Path.dirname file))

-- Check, gate, format and save. Nothing is written unless all pass.
let save (lib: Path) path source = (
  let checked = Driver.Outcome(check lib path source, action = "save");
  if !checked.ok then checked
  else match Wand.format source with
    | Error why -> Driver.Outcome(checked, ok = false, problems = [_problem why])
    | Ok text -> (
      match _write lib path text with
      | Error why -> Driver.Outcome(checked, ok = false, problems = [_problem why])
      | Ok _ -> Driver.Outcome(checked, text = Some text)
    )
)

-- Save as it is, to keep unfinished work: formatted when it parses.
let draft (lib: Path) path source = (
  let text = Result.default source (Wand.format source);
  match _write lib path text with
  | Error why -> Driver.Outcome(
    action = "draft",
    path = path,
    ok = false,
    problems = [_problem why]
  )
  | Ok _ -> Driver.Outcome(action = "draft", path = path, ok = true, text = Some text)
)

-- What is in the directory of blueprint path `path`, sorted: each directory
-- with a / after it, and each blueprint by its name, as shop/ and lamp.
-- None when there is no such directory.
let list (lib: Path) path =
  let dir = Path.join lib (Path.of_string ".%{path}");
  if !(FS.dir? dir) then None
  else
    Some
      (List.sort
        (List.filter_map
          (fn p ->
            let name = Path.to_string (Path.basename p);
            if FS.dir? p then Some "%{name}/"
            else if String.ends_with? ".wand" name && !(String.starts_with? "test_" name) then
              Some (String.slice 0 (String.length name - 5) name)
            else None)
          (Result.default [] (FS.list_dir dir))))

-- Whether the file of `path` is there yet.
let exists? (lib: Path) path = FS.exists? (file_of lib path)

-- The source of the file of `path`, or None when there is no such file.
let read (lib: Path) path =
  let file = file_of lib path;
  if FS.exists? file then Result.to_option (FS.read_file file) else None

-- `s` split at the first `sep`: what is before it and what is after.
let _split_once sep s =
  match String.split sep s with
  | [first :: rest] when rest != [] -> Some (first, String.join sep rest)
  | _ -> None

-- `v` written as the inside of a Wand string: a backslash, a quote and the
-- start of an interpolation each escaped, so any text reads back as typed.
let _escaped v =
  v |> String.replace "\\" "\\\\" |> String.replace `"` `\"` |> String.replace "\%{" "\\\%{"

-- The line of Wand for the exit `name` to `to`, with what `look` that way
-- shows, when it has a view.
let exit_line name to (view: Option String) =
  match view with
  | Some v -> `%{name} = Driver.Exit(to = "%{to}", view = Some "%{_escaped v}")`
  | None -> `%{name} = Driver.Exit(to = "%{to}")`

-- `source` with the exit `name` to `to` added to the exits below its
-- /dig marker, or None when it has no marker, as a room written by hand.
let with_exit name to (view: Option String) source =
  let opening = "let exits = {";
  let entry = exit_line name to view;
  Option.and_then
    (fn (before, after) -> Option.map
      (fn (between, rest) ->
        let added =
          if String.starts_with? "}" (String.trim_left rest) then entry else "\n  %{entry},";
        "%{before}%{Driver.dig_marker}%{between}%{opening}%{added}%{rest}")
      (_split_once opening after))
    (_split_once Driver.dig_marker source)
