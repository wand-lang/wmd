uses {FS.Read, FS.Write, Random, Shared}

-- The editor through the driver: /edit, the ed commands, and the checks
-- and saves they ask for. Each test works on a copy of ../lib in a
-- temporary directory, so a save never touches the real mudlib.

import FS
import List
import Option
import Path
import Shared
import String

let {test, group} = import Test
let blueprints = import ./blueprints
let core = import ../lib/std/core
let engine = import ./engine
let snapshot = import ./snapshot
let world = import ./world

let at = "2026-09-30T12:00:00Z"

let ann = world.session_id 0

let bo = world.session_id 1

let ann_body = "/std/player#0"

let editor = "/realm/editor/room#0"

let line sid text = world.queue (world.Line sid at text)

let lines sid texts = List.map (line sid) texts

let signed_up sid name = [
  world.open_next at,
  line sid name,
  line sid "2000-05-01",
  line sid "%{name}-password",
  line sid "%{name}-password"
]

let ann_in = List.concat (signed_up ann "ann") [world.emptied ann]

let both_in =
  List.concat ann_in (List.concat (signed_up bo "bo") [world.emptied ann, world.emptied bo])

-- Ann as an admin, who may edit any file.
let admin (w: world.World) =
  match world.account "ann" w with
  | Some a -> world.add_account world.Account(a, role = "admin") w
  | None -> w

-- Ann in the editor on a new file, /home/ann/lamp, with nothing heard yet.
let editing = List.concat ann_in [line ann "/edit /home/ann/lamp", world.emptied ann]

let heard sid (w: world.World) =
  List.filter
    (fn l -> l != "")
    (List.map
      (fn l -> String.replace "\xff\xfc\x01" "" (String.replace "\xff\xfb\x01" "" l))
      (world.outbox sid w))

let heard? sid text (w: world.World) = List.any? (fn l -> l == text) (heard sid w)

-- Play `changes` on a copy of the mudlib, then give `check` the world and
-- the copy's root.
let on_copy! changes check =
  with FS.temp_dir "wmd_ed_" as d -> (
    let lib = Path.join d ./lib;
    FS.copy_tree! ./lib lib;
    let start =
      world.World(
        world.with_pepper "test pepper",
        lib_root = lib,
        listing = Some (Path.join d ./blueprints.wand)
      );
    with Shared.make start as state -> (
      engine.boot blueprints.lib state at;
      List.each (fn f -> (Shared.update state f; engine.step blueprints.lib state)) changes;
      check (Shared.get state) lib
    )
  )

let lamp lib = Path.join lib ./home/ann/lamp.wand

group "opening" (fn () -> [
  test "a builder may not edit outside their home" (fn t ->
    on_copy! (List.concat ann_in [line ann "/edit /realm/commons/garden"]) (fn w _ ->
      t.eq
        [
          "You may not edit /realm/commons/garden. A builder edits the files in /home/<name>/."
        ]
        (heard ann w))),
  test "a path that is not a mudlib path" (fn t ->
    on_copy! (List.concat ann_in [line ann "/edit /home/ann/../../std/core"]) (fn w _ ->
      t.eq
        ["'/home/ann/../../std/core' is not a mudlib path. One looks like /home/ann/lamp."]
        (heard ann w))),
  test "a new file in your home opens the editor, and the room sees you go" (fn t ->
    on_copy! (List.concat both_in [line ann "/edit /home/ann/lamp"]) (fn w _ ->
      t.eq (true, Some editor, true) (
        heard? ann "/home/ann/lamp is a new file." w,
        world.env_of ann_body w,
        heard? bo "Ann leaves for the editor." w
      ))),
  test "an admin edits the room they are in with /edit here" (fn t ->
    on_copy! (List.concat ann_in [admin, line ann "/edit here", world.emptied ann, line ann "1p"]) (fn w _ ->
      t.eq ["uses {Random}"] (heard ann w))),
  test "no one else may be moved into your editor" (fn t ->
    on_copy! (List.concat both_in [line ann "/edit /home/ann/lamp"]) (fn w _ ->
      let ctx = engine.ctx_for w "/std/player#1" "/std/player#1";
      t.eq
        (Error "may not move /std/player#1 into %{editor}")
        (engine.allowed ctx (core.Move "/std/player#1" editor) w)))
])

group "the buffer" (fn () -> [
  test "a adds lines, spaces kept, until a lone ." (fn t ->
    on_copy! (List.concat
      editing
      (List.concat (lines ann ["a", "let x =", "  1", "."]) [
        world.emptied ann,
        line ann ",n"
      ])
    ) (fn w _ ->
      t.eq ["1\tlet x =", "2\t  1"] (heard ann w))),
  test "a line that starts with / is text while adding" (fn t ->
    on_copy! (List.concat
      editing
      (List.concat (lines ann ["a", "/who", "."]) [world.emptied ann, line ann "p"])
    ) (fn w _ ->
      t.eq ["/who"] (heard ann w))),
  test "and a driver command while not" (fn t ->
    on_copy! (List.concat editing [line ann "/who"]) (fn w _ ->
      t.eq ["1 connected: Ann."] (heard ann w))),
  test "i inserts before a line" (fn t ->
    on_copy! (List.concat
      editing
      (List.concat (lines ann ["a", "b", ".", "1i", "a", "."]) [
        world.emptied ann,
        line ann ",p"
      ])
    ) (fn w _ ->
      t.eq ["a", "b"] (heard ann w))),
  test "c changes lines" (fn t ->
    on_copy! (List.concat
      editing
      (List.concat (lines ann ["a", "a", "b", "c", ".", "2c", "B", "."]) [
        world.emptied ann,
        line ann ",p"
      ])
    ) (fn w _ ->
      t.eq ["a", "B", "c"] (heard ann w))),
  test "d deletes lines" (fn t ->
    on_copy! (List.concat
      editing
      (List.concat (lines ann ["a", "a", "b", "c", ".", "1,2d"]) [
        world.emptied ann,
        line ann ",p"
      ])
    ) (fn w _ ->
      t.eq ["c"] (heard ann w))),
  test "s replaces the first on each line, and g every one" (fn t ->
    on_copy! (List.concat
      editing
      (List.concat (lines ann ["a", "aa", "aa", ".", "1s/a/b/", "2s/a/b/g"]) [
        world.emptied ann,
        line ann ",p"
      ])
    ) (fn w _ ->
      t.eq ["ba", "bb"] (heard ann w))),
  test "a line past the end" (fn t ->
    on_copy! (List.concat
      editing
      (List.concat (lines ann ["a", "a", "."]) [world.emptied ann, line ann "5p"])
    ) (fn w _ ->
      t.eq ["There is no line 5; the buffer has 1."] (heard ann w)))
])

group "checking and saving" (fn () -> [
  test "t shows an error at its buffer line" (fn t ->
    on_copy! (List.concat
      editing
      (List.concat (lines ann ["a", "let x: Int = 1", `let y: Int = "a"`, "."]) [
        world.emptied ann,
        line ann "t"
      ])
    ) (fn w _ ->
      t.ok (List.any? (String.starts_with? "2:") (heard ann w)))),
  test "t shows the effects of a file that checks" (fn t ->
    on_copy! (List.concat
      editing
      (List.concat (lines ann ["a", "uses {Random}", "import Random", "let roll () = Random.int 1 6", "."]) [
        world.emptied ann,
        line ann "t"
      ])
    ) (fn w _ ->
      t.eq ["No errors. Effects: Random."] (heard ann w))),
  test "the gate refuses a file that writes files, whatever its uses line says" (fn t ->
    on_copy! (List.concat
      editing
      (List.concat (lines ann [
        "a",
        "uses {FS.Write}",
        "import FS",
        `let g () = FS.write_file ./a "b"`,
        "."
      ]) [world.emptied ann, line ann "w"])
    ) (fn w lib ->
      t.eq (true, false) (
        heard? ann "1:1: the file performs FS.Write; mudlib code may perform only Random" w,
        FS.exists? (lamp lib)
      ))),
  test "w formats and saves" (fn t ->
    on_copy! (List.concat
      editing
      (List.concat (lines ann ["a", "let x=1", "."]) [world.emptied ann, line ann "w"])
    ) (fn w lib ->
      t.eq (
        [
          "Saved /home/ann/lamp: 1 lines. It runs after the next restart.",
          "Formatting changed 1 lines. ,n shows them."
        ],
        "let x = 1\n"
      ) (heard ann w, FS.read_file! (lamp lib)))),
  test "w writes nothing when the file has an error" (fn t ->
    on_copy! (List.concat editing (lines ann ["a", `let x: Int = "a"`, ".", "w"])) (fn _ lib ->
      t.not_ok (FS.exists? (lamp lib)))),
  test "w! keeps unfinished work" (fn t ->
    on_copy! (List.concat editing (lines ann ["a", "let x =", ".", "w!"])) (fn _ lib ->
      t.eq "let x =\n" (FS.read_file! (lamp lib)))),
  test "a new blueprint goes into the list the next start loads" (fn t ->
    on_copy! (List.concat
      editing
      (lines ann [
        "a",
        "uses {Random}",
        "import JSON",
        "let core = import ../../std/core",
        "let room = import ../../std/room",
        "implement core.Blueprint =",
        `  let create _ _ = core.Init(object = room.room "A lamp" "It is off.")`,
        ".",
        "w"
      ])
    ) (fn _ lib ->
      t.ok
        (String.contains?
          `("/home/ann/lamp", `
          (FS.read_file! (Path.join (Path.dirname lib) ./blueprints.wand)))))
])

-- Formatting takes out the second blank line, so line 4 is line 3 now,
-- and . still names `let y = 2`.
test "after a save, the current line is the same line of code" (fn t ->
  on_copy! (List.concat
    editing
    (List.concat (lines ann ["a", "let x=1", "", "", "let y=2", ".", "w"]) [
      world.emptied ann,
      line ann ".n"
    ])
  ) (fn w _ ->
    t.eq ["3\tlet y = 2"] (heard ann w)))

group "the event log" (fn () -> [
  test "a save logs its effects, and a refused one its errors" (fn t ->
    on_copy! (List.concat
      editing
      (lines ann [
        "a",
        `let x: Int = "a"`,
        ".",
        "w",
        "1c",
        "uses {Random}",
        "import Random",
        "let x () = Random.int 1 6",
        ".",
        "w"
      ])
    ) (fn w _ ->
      t.eq
        [("save_refused", "1:14: expected Int, got String"), ("save", "effects: Random")]
        (List.filter_map
          (fn (e: world.Event) -> if String.starts_with? "save" e.event then
              Some (e.event, Option.default "" e.text)
            else None)
          w.events))),
  test "the editor's spawn and removal are logged" (fn t ->
    on_copy! (List.concat editing [line ann "q"]) (fn w _ ->
      t.eq
        [("spawn", Some editor), ("remove", Some editor)]
        (List.filter_map
          (fn (e: world.Event) -> if (e.event == "spawn" || e.event == "remove") && e.object == Some editor then
              Some (e.event, e.object)
            else None)
          w.events)))
])

group "leaving" (fn () -> [
  test "q refuses while there are unsaved changes" (fn t ->
    on_copy! (List.concat
      editing
      (List.concat (lines ann ["a", "x", "."]) [world.emptied ann, line ann "q"])
    ) (fn w _ ->
      t.eq (
        ["You have unsaved changes. Save them with w or w!, or leave without them with Q."],
        Some editor
      ) (heard ann w, world.env_of ann_body w))),
  test "Q goes back to the room it was opened from, and the editor is gone" (fn t ->
    on_copy! (List.concat ann_in [
      line ann "north",
      line ann "/edit /home/ann/lamp",
      line ann "a",
      line ann "x",
      line ann ".",
      line ann "Q"
    ]) (fn w _ ->
      t.eq (Some "/realm/commons/garden#0", None) (
        world.env_of ann_body w,
        Option.map (fn (i: world.Instance) -> i.id) (world.instance editor w)
      ))),
  test "the room sees you come back" (fn t ->
    on_copy! (List.concat both_in [line ann "/edit /home/ann/lamp", line ann "q"]) (fn w _ ->
      t.ok (heard? bo "Ann comes back from the editor." w))),
  test "a restart keeps the buffer" (fn t ->
    on_copy! (List.concat editing (lines ann ["a", "kept", "."])) (fn w lib ->
      let path = Path.join (Path.dirname lib) ./world.json;
      with Shared.make w as state -> (
        engine.snapshot! state path at;
        with Shared.make world.World(world.with_pepper "test pepper", lib_root = lib) as again -> (
          let _ =
            Option.map
              (fn f -> engine.restore blueprints.lib again f at)
              (snapshot.read! path);
          let saved (x: world.World) =
            Option.map
              (fn (i: world.Instance) -> i.object.save ())
              (world.instance editor x);
          t.eq (saved w) (saved (Shared.get again))
        )
      )))
])
