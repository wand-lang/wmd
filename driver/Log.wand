uses {FS.Write, Shared}

-- The event log: append-only JSON Lines, one file per day, written by the
-- driver alone.

import FS
import JSON
import List
import Path
import Shared
import String

import ./World

-- One event as one line of JSON. A field that is None is left out.
let line (e: World.Event) = "%{JSON.stringify (World.Event.encoder e)}\n"

-- The file for the day of the event, such as logs/2026-10-02.jsonl.
let file dir (e: World.Event) =
  Path.join dir (Path.of_string "%{String.slice 0 10 e.at}.jsonl")

-- One append is one write, so lines from two events never interleave.
let append! dir (e: World.Event) = FS.append! (file dir e) (line e)

-- Write the events not yet logged. They are taken out in one step: the
-- update answers the world before it emptied them.
let flush! state dir =
  let (before: World.Current) = Shared.update state World.all_logged;
  List.each (fn e -> append! dir e) before.events
