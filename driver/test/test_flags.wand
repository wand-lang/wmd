uses {FS.Read, FS.Write, Random, Shared}

-- Flagging a room, a thing or a person, and a Keymaster's review.

import ../Engine
import ../Library
import ../World
import List

import Option
import Shared
import String

let {test, group} = import Test

let start = Library.with_lib! ./_lib (World.with_pepper "test pepper")

let at = "2026-09-30T12:00:00Z"

let ann = World.session_id 0

let bo = World.session_id 1

let cy = World.session_id 2

let square = "/r/square#0"

let garden = "/r/garden#0"

let lever = "/r/lever#0"

let line sid text = World.queue (World.Line sid at text)

let played changes =
  with Shared.make start as state -> (
    Engine.boot state at;
    List.each (fn f -> (Shared.update state f; Engine.step state)) changes;
    Shared.get state
  )

let heard sid (w: World.Current) = List.filter (fn l -> l != "") (World.outbox sid w)

let heard? sid text (w: World.Current) = List.any? (fn l -> l == text) (heard sid w)

let heard_any? sid part (w: World.Current) = List.any? (String.contains? part) (heard sid w)

let signed_up sid name = [
  World.open_next at,
  line sid name,
  line sid "2000-05-01",
  line sid "%{name}-password",
  line sid "%{name}-password",
  line sid "sign rules"
]

let make_keymaster name (w: World.Current) =
  match World.account name w with
  | Some a -> World.add_account World.Account(a, role = "keymaster") w
  | None -> w

-- Ann, a Keymaster, Bo and Cy, all in the square, with the lever Bo's, and
-- nothing heard yet.
let all_in = List.flatten [
  signed_up ann "ann",
  signed_up bo "bo",
  signed_up cy "cy",
  [
    make_keymaster "ann",
    World.set_owner lever (Some "bo"),
    World.emptied ann,
    World.emptied bo,
    World.emptied cy
  ]
]

let after changes = played (List.concat all_in changes)

let only_flag (w: World.Current) = List.head w.flags

-- Three people flag the lever.
let three_flags = [
  line ann "/flag lever it says something rude",
  line cy "/flag lever rude",
  World.emptied bo,
  line bo "/flag lever mine, but rude"
]

group "flagging" (fn () -> [
  test "a flag keeps who, what, why, and what it was" (fn t ->
    let w = after [line cy "/flag lever it says something rude"];
    let f = only_flag w;
    t.eq (Some ("cy", "object", lever, Some "bo", "it says something rude"), true, true) (
      Option.map (fn (f: World.Flag) -> (f.by, f.kind, f.target, f.owner, f.reason)) f,
      Option.map
        (fn (f: World.Flag) -> String.contains? "--- /r/lever.wand ---" f.evidence)
        f == Some true,
      heard? cy "Thank you. A Keymaster will look at it." w
    )),
  test "the owner is told what and why, and not who" (fn t ->
    let w = after [line cy "/flag lever it says something rude"];
    t.eq
      [
        "Your object /r/lever#0 was flagged: it says something rude. A Keymaster will look at it."
      ]
      (heard bo w)),
  test "here is the room" (fn t ->
    t.eq
      (Some ("room", square))
      (Option.map
        (fn (f: World.Flag) -> (f.kind, f.target))
        (only_flag (after [line cy "/flag here too loud"])))),
  test "a flag needs a reason" (fn t ->
    t.eq ["Say why: /flag lever <why>."] (heard cy (after [line cy "/flag lever"]))),
  test "a person is reported, not flagged" (fn t ->
    t.eq
      ["To tell the Keymasters about a person, /report them."]
      (heard cy (after [line cy "/flag bo rude"]))),
  test "a report keeps what the person said lately" (fn t ->
    let w =
      after [
        line bo "say Hello.",
        line bo "say Something unkind.",
        line cy "/report bo was unkind"
      ];
    t.eq
      (Some (
        "person",
        "bo",
        `
say Hello.
say Something unkind.`
      ))
      (Option.map (fn (f: World.Flag) -> (f.kind, f.target, f.evidence)) (only_flag w))),
  test "the person reported is not told" (fn t ->
    t.eq false (heard_any? bo "report" (after [line cy "/report bo was unkind"])))
])

group "three flags" (fn () -> [
  test "take a thing out of view, and stop it" (fn t ->
    let w =
      after
        (List.concat three_flags [World.emptied cy, line cy "look", line cy "pull lever"]);
    t.eq (true, true, true) (
      heard_any? cy "something waiting for a Keymaster" w,
      heard? cy "That is waiting for a Keymaster." w,
      heard?
        bo
        "Your object /r/lever#0 is out of view until a Keymaster has looked at it."
        w
    )),
  test "from one person count once" (fn t ->
    let w =
      after [
        line cy "/flag lever rude",
        line cy "/flag lever rude",
        line cy "/flag lever rude"
      ];
    t.eq
      (Some false)
      (Option.map (fn (i: World.Instance) -> i.held) (World.instance lever w))),
  test "make a room private" (fn t ->
    let w = after [line ann "/flag here a", line bo "/flag here b", line cy "/flag here c"];
    t.eq (Some false) (Option.map World.public? (World.instance square w)))
])

group "review" (fn () -> [
  test "only a Keymaster sees the flags" (fn t ->
    t.eq
      ["Only a Keymaster or a Steward reviews flags."]
      (heard bo (after [line bo "/flags"]))),
  test "/flags lists the open ones" (fn t ->
    let w = after [line cy "/flag lever rude", World.emptied ann, line ann "/flags"];
    t.eq [`#1 object /r/lever#0, by cy at 2026-09-30T12:00:00Z: rude`] (heard ann w)),
  test "/flags 1 shows the evidence" (fn t ->
    let w = after [line cy "/flag lever rude", World.emptied ann, line ann "/flags 1"];
    t.ok (heard? ann "It has been pulled 0 times." w)),
  test "dismissing the last open flag lets a held thing back" (fn t ->
    let w =
      after
        (List.concat three_flags [
          line ann "/resolve 1 dismiss",
          line ann "/resolve 2 dismiss"
        ]);
    let held = Option.map (fn (i: World.Instance) -> i.held) (World.instance lever w);
    let w3 =
      after
        (List.concat three_flags [
          line ann "/resolve 1 dismiss",
          line ann "/resolve 2 dismiss",
          line ann "/resolve 3 dismiss"
        ]);
    t.eq (Some true, Some false) (
      held,
      Option.map (fn (i: World.Instance) -> i.held) (World.instance lever w3)
    )),
  test "remove takes the thing away and closes its flags" (fn t ->
    let w = after (List.concat three_flags [line ann "/resolve 2 remove copied work"]);
    t.eq (None, [], true) (
      World.instance lever w,
      World.open_flags lever w,
      heard_any? bo "A Keymaster removed your object /r/lever#0" w
    )),
  test "warn tells the owner" (fn t ->
    let w =
      after [
        line cy "/flag lever rude",
        World.emptied bo,
        line ann "/resolve 1 warn please fix it"
      ];
    t.eq ["A Keymaster warns you about object /r/lever#0: rude. please fix it"] (heard bo w)),
  test "pause ends the owner's session, and /unpause lets them back" (fn t ->
    let w = after [line cy "/report bo was unkind", line ann "/resolve 1 pause"];
    let back =
      after [
        line cy "/report bo was unkind",
        line ann "/resolve 1 pause",
        line ann "/unpause bo"
      ];
    t.eq (true, true, false) (
      World.closing? bo w,
      Option.map (fn (a: World.Account) -> a.paused) (World.account "bo" w) == Some true,
      Option.map (fn (a: World.Account) -> a.paused) (World.account "bo" back) == Some true
    )),
  test "a resolved flag stays resolved" (fn t ->
    let w =
      after [
        line cy "/flag lever rude",
        line ann "/resolve 1 dismiss",
        World.emptied ann,
        line ann "/resolve 1 warn"
      ];
    t.eq ["Flag #1 is resolved already: dismiss."] (heard ann w)),
  test "only a room is made private, and only a thing removed" (fn t ->
    let w =
      after [
        line cy "/flag lever rude",
        line cy "/flag here loud",
        World.emptied ann,
        line ann "/resolve 1 private",
        line ann "/resolve 2 remove"
      ];
    t.eq
      ["Only a room is made private.", "Only a thing is removed. A room is made private."]
      (heard ann w))
])
