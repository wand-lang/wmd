-- The world's pure pieces: sessions and their outboxes, the input queue,
-- and the events. Commands are tested through the engine, in
-- test_engine.wand.

import ../World
import List

import Map

let {test, group} = import Test

let at = "2026-09-30T12:00:00Z"

let events (w: World.World) = List.map (fn (e: World.Event) -> e.event) w.events

group "sessions" (fn () -> [
  test "are numbered in the order they open" (fn t ->
    let w = World.empty |> World.open_next at |> World.open_next at;
    t.eq ["session:0", "session:1"] (List.sort (Map.keys w.sessions))),
  test "a new one waits for the driver to greet it" (fn t ->
    t.eq true (World.pending? "session:0" (World.open_next at World.empty))),
  test "closing one queues its Gone and forgets its outbox" (fn t ->
    let w = World.empty |> World.open_next at |> World.close "session:0" at;
    t.eq (None, None, ["connect", "disconnect"]) (
      World.session "session:0" w,
      Map.get "session:0" w.outboxes,
      events w
    ))
])

group "outboxes" (fn () -> [
  test "a line told to a session is waiting in its outbox" (fn t ->
    t.eq
      ["hi", "there"]
      (World.empty
      |> World.open_next at
      |> World.tell "session:0" "hi\nthere"
      |> World.outbox "session:0")),
  test "emptied leaves nothing, and a closed session closed" (fn t ->
    let w = World.empty |> World.open_next at |> World.tell "session:0" "hi";
    t.eq ([], None) (
      World.outbox "session:0" (World.emptied "session:0" w),
      Map.get "session:1" (World.emptied "session:1" w).outboxes
    )),
  test "a full outbox closes the session" (fn t ->
    let full =
      List.fold_left
        (fn w _ -> World.tell "session:0" "x" w)
        (World.open_next at World.empty)
        (List.range 1 World.outbox_cap);
    t.eq (false, true) (
      World.closing? "session:0" full,
      World.closing? "session:0" (World.tell "session:0" "one more" full)
    ))
])

test "all_logged takes every event out" (fn t ->
  t.eq [] (World.all_logged (World.open_next at World.empty)).events)

let noon = 2026-09-30T12:00:00Z

-- A world where `/clock#0` has a heartbeat.
let beating = World.World(World.empty, beating = Map.set "/clock#0" true Map.empty)

group "how long the driver may sleep" (fn () -> [
  test "for ever, with nothing to tick" (fn t ->
    t.ok (World.sleep_for 2s noon World.empty == None)),
  test "until the next heartbeat, while something has one" (fn t ->
    t.eq (Some 2s, Some 500ms) (
      World.sleep_for 2s noon beating,
      World.sleep_for 500ms noon beating
    )),
  test "until the soonest call-out, when nothing has a heartbeat" (fn t ->
    let w =
      World.empty
      |> World.call_out "/timer#0" (noon + 15m) "ring"
      |> World.call_out "/timer#0" (noon + 30s) "ring";
    t.eq (Some 30s) (World.sleep_for 2s noon w)),
  test "not at all, when a call-out is late" (fn t ->
    t.eq
      (Some 0s)
      (World.sleep_for
        2s
        (noon + 5s)
        (World.call_out "/timer#0" (noon + 1s) "ring" World.empty)))
])
