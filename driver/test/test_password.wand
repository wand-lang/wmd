import String

let {test} = import Test
let password = import ../password

let stored = password.hash "pepper" "salt" "open sesame"

test "the right password matches" (fn t ->
  t.ok (password.matches? "pepper" stored "open sesame"))
test "a wrong one does not" (fn t ->
  t.not_ok (password.matches? "pepper" stored "open sesame!"))
test "nor the right one under another pepper" (fn t ->
  t.not_ok (password.matches? "other" stored "open sesame"))
test "the stored form names its method and salt, and not the password" (fn t ->
  t.eq (true, false) (
    String.starts_with? "hmac-sha256$salt$" stored,
    String.contains? "open sesame" stored
  ))
test "another salt makes another hash" (fn t ->
  t.not_eq stored (password.hash "pepper" "other" "open sesame"))
test "a stored form it cannot read matches nothing" (fn t ->
  t.not_ok (password.matches? "pepper" "plain" "plain"))
