uses {FS.Read, FS.Write, Random, Shared}

-- The editor through the driver: /edit, the ed commands, and the checks
-- and saves they ask for. Each test works on a copy of lib/ in a
-- temporary directory, so a save never touches the real Library.

import ../Engine
import ../Library
import ../Snapshot
import ../World
import FS
import List
import Map
import Option
import Path

import Resource
import Result
import Shared
import String

let {test, group} = import Test
let Driver = import ../../driver

let at = "2026-09-30T12:00:00Z"

let ann = World.session_id 0

let bo = World.session_id 1

let ann_body = "/std/player#0"

let editor = "/r/editor/room#0"

let line sid text = World.queue (World.Line sid at text)

let lines sid texts = List.map (line sid) texts

let signed_up sid name = [
  World.open_next at,
  line sid name,
  line sid "2000-05-01",
  line sid "%{name}-password",
  line sid "%{name}-password",
  line sid "sign rules"
]

let ann_in = List.concat (signed_up ann "ann") [World.emptied ann]

let both_in =
  List.concat ann_in (List.concat (signed_up bo "bo") [World.emptied ann, World.emptied bo])

-- Ann as a Keymaster, who may edit any file.
let keymaster (w: World.Current) =
  match World.account "ann" w with
  | Some a -> World.add_account World.Account(a, role = "keymaster") w
  | None -> w

-- Ann in the editor on a new file, /r/home/ann/lamp, with nothing heard yet.
let editing = List.concat ann_in [line ann "/edit /r/home/ann/lamp", World.emptied ann]

let heard sid (w: World.Current) =
  List.filter
    (fn l -> l != "")
    (List.map
      (fn l -> String.replace "\xff\xfc\x01" "" (String.replace "\xff\xfb\x01" "" l))
      (World.outbox sid w))

let heard? sid text (w: World.Current) = List.any? (fn l -> l == text) (heard sid w)

-- The Library, loaded once. It is the real lib/, because a file loads only
-- when it imports the driver's own std/driver.wand: a copy of lib/ would
-- declare another Driver.Blueprint.
let loaded = Library.load_all! ./_lib

-- Ann's home, where a test saves. It must not exist before a test, and
-- it is removed after one, so the Library is left as it was found.
let home = ./_lib/r/home/ann

let _clean () = (
  let _ = FS.delete_tree home;
  match FS.list_dir ./_lib/r/home with
  | Ok [] -> (let _ = FS.delete_tree ./_lib/r/home; ())
  | _ -> ()
)

-- `on_lib!`, for a test that changes files outside Ann's home: each of
-- `kept` is read first and written back after.
let keeping! kept changes check =
  let before = List.map (fn f -> (f, FS.read_file! f)) kept;
  with Resource.make (fn () -> ()) (fn () -> List.each (fn (f, text) -> FS.write_file! f text) before) as _ ->
  on_lib! changes check

-- Play `changes` on the Library, then give `check` the world and the
-- Library's root.
and on_lib! changes check =
  if FS.exists? home then
    Result.get! (Error "%{home} exists: the editor tests save there, and remove it after")
  else with Resource.make (fn () -> ()) (fn () -> _clean ()) as _ ->
  with Shared.make (Library.into loaded (World.with_pepper "test pepper")) as state -> (
    Engine.boot state at;
    List.each (fn f -> (Shared.update state f; Engine.step state)) changes;
    check (Shared.get state) ./_lib
  )

let lamp lib = Path.join lib ./r/home/ann/lamp.wand

group "opening" (fn () -> [
  test "a builder may not edit outside their home" (fn t ->
    on_lib! (List.concat ann_in [line ann "/edit /r/garden"]) (fn w _ ->
      t.eq
        [
          "You may not edit /r/garden. A Citizen edits the files in their home, /r/home/<name>/."
        ]
        (heard ann w))),
  test "a path that is not a Library path" (fn t ->
    on_lib! (List.concat ann_in [line ann "/edit /r/home/ann/../../std/driver"]) (fn w _ ->
      t.eq
        [
          "'/r/home/ann/../../std/driver' is not a Library path. One looks like /r/home/ann/lamp."
        ]
        (heard ann w))),
  test "a new file in your home opens the editor, and the room sees you go" (fn t ->
    on_lib! (List.concat both_in [line ann "/edit /r/home/ann/lamp"]) (fn w _ ->
      t.eq (true, Some editor, true) (
        heard? ann "/r/home/ann/lamp is a new file." w,
        World.env_of ann_body w,
        heard? bo "Ann leaves for the editor." w
      ))),
  test "a Keymaster edits the room they are in with /edit here" (fn t ->
    on_lib! (List.concat ann_in [keymaster, line ann "/edit here", World.emptied ann, line ann "1p"]) (fn w _ ->
      t.eq ["uses {Random}"] (heard ann w))),
  test "the editor says how to leave it, where a room lists its exits" (fn t ->
    on_lib! (List.concat ann_in [line ann "/edit /r/home/ann/lamp"]) (fn w _ ->
      t.eq (true, false) (
        heard? ann "q leaves the editor." w,
        heard? ann "There is no way out." w
      ))),
  test "no one else may be moved into your editor" (fn t ->
    on_lib! (List.concat both_in [line ann "/edit /r/home/ann/lamp"]) (fn w _ ->
      let ctx = Engine.ctx_for w "/std/player#1" "/std/player#1";
      t.eq
        (Error "may not move /std/player#1 into %{editor}")
        (Engine.allowed ctx (Driver.Move "/std/player#1" editor) w)))
])

group "the buffer" (fn () -> [
  test "a adds lines, spaces kept, until a lone ." (fn t ->
    on_lib! (List.concat
      editing
      (List.concat (lines ann ["a", "let x =", "  1", "."]) [
        World.emptied ann,
        line ann ",n"
      ])
    ) (fn w _ ->
      t.eq ["1\tlet x =", "2\t  1"] (heard ann w))),
  test "a line that starts with / is text while adding" (fn t ->
    on_lib! (List.concat
      editing
      (List.concat (lines ann ["a", "/who", "."]) [World.emptied ann, line ann "p"])
    ) (fn w _ ->
      t.eq ["/who"] (heard ann w))),
  test "and a driver command while not" (fn t ->
    on_lib! (List.concat editing [line ann "/who"]) (fn w _ ->
      t.eq ["1 connected: Ann."] (heard ann w))),
  test "i inserts before a line" (fn t ->
    on_lib! (List.concat
      editing
      (List.concat (lines ann ["a", "b", ".", "1i", "a", "."]) [
        World.emptied ann,
        line ann ",p"
      ])
    ) (fn w _ ->
      t.eq ["a", "b"] (heard ann w))),
  test "c changes lines" (fn t ->
    on_lib! (List.concat
      editing
      (List.concat (lines ann ["a", "a", "b", "c", ".", "2c", "B", "."]) [
        World.emptied ann,
        line ann ",p"
      ])
    ) (fn w _ ->
      t.eq ["a", "B", "c"] (heard ann w))),
  test "d deletes lines" (fn t ->
    on_lib! (List.concat
      editing
      (List.concat (lines ann ["a", "a", "b", "c", ".", "1,2d"]) [
        World.emptied ann,
        line ann ",p"
      ])
    ) (fn w _ ->
      t.eq ["c"] (heard ann w))),
  test "s replaces the first on each line, and g every one" (fn t ->
    on_lib! (List.concat
      editing
      (List.concat (lines ann ["a", "aa", "aa", ".", "1s/a/b/", "2s/a/b/g"]) [
        World.emptied ann,
        line ann ",p"
      ])
    ) (fn w _ ->
      t.eq ["ba", "bb"] (heard ann w))),
  test "a line past the end" (fn t ->
    on_lib! (List.concat
      editing
      (List.concat (lines ann ["a", "a", "."]) [World.emptied ann, line ann "5p"])
    ) (fn w _ ->
      t.eq ["There is no line 5; the buffer has 1."] (heard ann w)))
])

group "checking and saving" (fn () -> [
  test "t shows an error at its buffer line" (fn t ->
    on_lib! (List.concat
      editing
      (List.concat (lines ann ["a", "let x: Int = 1", `let y: Int = "a"`, "."]) [
        World.emptied ann,
        line ann "t"
      ])
    ) (fn w _ ->
      t.ok (List.any? (String.starts_with? "2:") (heard ann w)))),
  test "t shows the effects of a file that checks" (fn t ->
    on_lib! (List.concat
      editing
      (List.concat (lines ann ["a", "uses {Random}", "import Random", "let roll () = Random.int 1 6", "."]) [
        World.emptied ann,
        line ann "t"
      ])
    ) (fn w _ ->
      t.eq ["No errors. Effects: Random."] (heard ann w))),
  test "the gate refuses a file that writes files, whatever its uses line says" (fn t ->
    on_lib! (List.concat
      editing
      (List.concat (lines ann [
        "a",
        "uses {FS.Write}",
        "import FS",
        `let g () = FS.write_file ./a "b"`,
        "."
      ]) [World.emptied ann, line ann "w"])
    ) (fn w lib ->
      t.eq (true, false) (
        heard? ann "1:1: the file performs FS.Write; Library code may perform only Random" w,
        FS.exists? (lamp lib)
      ))),
  test "w formats and saves" (fn t ->
    on_lib! (List.concat
      editing
      (List.concat (lines ann ["a", "let x=1", "."]) [World.emptied ann, line ann "w"])
    ) (fn w lib ->
      t.eq (
        ["Saved /r/home/ann/lamp: 1 lines.", "Formatting changed 1 lines. ,n shows them."],
        "let x = 1\n"
      ) (heard ann w, FS.read_file! (lamp lib)))),
  test "w writes nothing when the file has an error" (fn t ->
    on_lib! (List.concat editing (lines ann ["a", `let x: Int = "a"`, ".", "w"])) (fn _ lib ->
      t.not_ok (FS.exists? (lamp lib)))),
  test "w! keeps unfinished work" (fn t ->
    on_lib! (List.concat editing (lines ann ["a", "let x =", ".", "w!"])) (fn _ lib ->
      t.eq "let x =\n" (FS.read_file! (lamp lib)))),
  test "a new blueprint loads when it is saved" (fn t ->
    on_lib! (List.concat
      editing
      (lines ann [
        "a",
        "uses {Random}",
        "import JSON",
        "let Driver = import ../../../std/driver",
        "let Room = import ../../../std/room",
        "implement Driver.Blueprint =",
        `  let create _ _ = Driver.Init(object = Room.room "A lamp" "It is off.")`,
        ".",
        "w"
      ])
    ) (fn w _ ->
      t.eq (true, true) (
        Map.has? "/r/home/ann/lamp" w.lib,
        heard? ann "Updated /r/home/ann/lamp: 0 instances on the new code." w
      )))
])

-- Formatting takes out the second blank line, so line 4 is line 3 now,
-- and . still names `let y = 2`.
test "after a save, the current line is the same line of code" (fn t ->
  on_lib! (List.concat
    editing
    (List.concat (lines ann ["a", "let x=1", "", "", "let y=2", ".", "w"]) [
      World.emptied ann,
      line ann ".n"
    ])
  ) (fn w _ ->
    t.eq ["3\tlet y = 2"] (heard ann w)))

group "the event log" (fn () -> [
  test "a save logs its effects, and a refused one its errors" (fn t ->
    on_lib! (List.concat
      editing
      (lines ann [
        "a",
        `let x: Int = "a"`,
        ".",
        "w",
        "1c",
        "uses {Random}",
        "import Random",
        "let x () = Random.int 1 6",
        ".",
        "w"
      ])
    ) (fn w _ ->
      t.eq
        [("save_refused", "1:14: expected Int, got String"), ("save", "effects: Random")]
        (List.filter_map
          (fn (e: World.Event) -> if String.starts_with? "save" e.event then
              Some (e.event, Option.default "" e.text)
            else None)
          w.events))),
  test "the editor's spawn and removal are logged" (fn t ->
    on_lib! (List.concat editing [line ann "q"]) (fn w _ ->
      t.eq
        [("spawn", Some editor), ("remove", Some editor)]
        (List.filter_map
          (fn (e: World.Event) -> if (e.event == "spawn" || e.event == "remove") && e.object == Some editor then
              Some (e.event, e.object)
            else None)
          w.events)))
])

group "leaving" (fn () -> [
  test "q refuses while there are unsaved changes" (fn t ->
    on_lib! (List.concat
      editing
      (List.concat (lines ann ["a", "x", "."]) [World.emptied ann, line ann "q"])
    ) (fn w _ ->
      t.eq (
        ["You have unsaved changes. Save them with w or w!, or leave without them with Q."],
        Some editor
      ) (heard ann w, World.env_of ann_body w))),
  test "Q goes back to the room it was opened from, and the editor is gone" (fn t ->
    on_lib! (List.concat ann_in [
      line ann "north",
      line ann "/edit /r/home/ann/lamp",
      line ann "a",
      line ann "x",
      line ann ".",
      line ann "Q"
    ]) (fn w _ ->
      t.eq (Some "/r/garden#0", None) (
        World.env_of ann_body w,
        Option.map (fn (i: World.Instance) -> i.id) (World.instance editor w)
      ))),
  test "the room sees you come back" (fn t ->
    on_lib! (List.concat both_in [line ann "/edit /r/home/ann/lamp", line ann "q"]) (fn w _ ->
      t.ok (heard? bo "Ann comes back from the editor." w))),
  test "a restart keeps the buffer" (fn t ->
    on_lib! (List.concat editing (lines ann ["a", "kept", "."])) (fn w _ ->
      with FS.temp_dir "wmd_ed_" as d -> (
        let path = Path.join d ./world.json;
        with Shared.make w as state -> (
          Engine.snapshot! state path at;
          with Shared.make (Library.into loaded (World.with_pepper "test pepper")) as again -> (
            let _ = Option.map (fn f -> Engine.restore again f at) (Snapshot.read! path);
            let saved (x: World.Current) =
              Option.map
                (fn (i: World.Instance) -> i.object.save ())
                (World.instance editor x);
            t.eq (saved w) (saved (Shared.get again))
          )
        )
      )))
])

let lever = ./_lib/r/lever.wand

-- Ann as a Keymaster in the editor on the lever's file, after one pull.
let on_lever = List.concat ann_in [keymaster, line ann "pull lever", line ann "/edit lever"]

let lever_pulls (w: World.Current) =
  Option.map
    (fn (i: World.Instance) -> i.object.long (Engine.ctx_for w i.id ann_body))
    (World.instance "/r/lever#0" w)

group "reloading" (fn () -> [
  test "w moves the instances onto the new code, with their state" (fn t ->
    keeping! [lever] (List.concat on_lever [line ann ",s/pulled/yanked/", line ann "w", line ann "q"]) (fn w _ ->
      t.eq (Some "It has been yanked 1 times.", true) (
        lever_pulls w,
        heard? ann "Updated /r/lever: 1 instances on the new code." w
      ))),
  -- The field is renamed and loses its default, so the saved {"pulls": 1}
  -- has nothing the new State can be made from.
  -- The field is renamed and loses its default, so the saved {"pulls": 1}
  -- has nothing the new State can be made from.
  test "an instance the new code cannot read stays on the old code" (fn t ->
    keeping! [lever] (List.concat on_lever [
      line ann ",s/pulls/times/g",
      line ann ",s/times: Int = 0/times: Int/",
      line ann ",s/make State()/make State(times = 0)/",
      line ann "w",
      line ann "q"
    ]) (fn w _ ->
      t.eq (Some "It has been pulled 1 times.", true) (
        lever_pulls w,
        List.any?
          (String.contains?
            "Kept on the old code, because the new code cannot read their saved state: /r/lever#0.")
          (heard ann w)
      ))),
  test "a file that does not load changes nothing" (fn t ->
    keeping! [lever] (List.concat on_lever [
      line ann `,s/pulls + 1/pulls + "x"/`,
      line ann "w!",
      line ann "q",
      line ann "/update lever"
    ]) (fn w _ ->
      t.eq (Some "It has been pulled 1 times.", true) (
        lever_pulls w,
        List.any? (String.starts_with? "/r/lever was not updated: ") (heard ann w)
      ))),
  test "a builder may not update a file outside their home" (fn t ->
    on_lib! (List.concat ann_in [World.emptied ann, line ann "/update lever"]) (fn w _ ->
      t.eq ["You may not update /r/lever."] (heard ann w)))
])

group "resetting" (fn () -> [
  test "/reset makes an instance again, as create makes a new one" (fn t ->
    on_lib! (List.concat ann_in [keymaster, line ann "pull lever", line ann "/reset lever"]) (fn w _ ->
      t.eq (Some "It has been pulled 0 times.", true) (
        lever_pulls w,
        heard? ann "Reset /r/lever#0." w
      ))),
  test "the starting actions run again: a reset square makes another lever" (fn t ->
    on_lib! (List.concat ann_in [keymaster, line ann "/reset here"]) (fn w _ ->
      t.eq 2 (List.length (World.instances_of "/r/lever" w)))),
  test "/reset me keeps your name" (fn t ->
    on_lib! (List.concat ann_in [line ann "/reset me", World.emptied ann, line ann "/who ann"]) (fn w _ ->
      t.ok (heard? ann "Ann looks like a person." w))),
  test "a builder may not reset what they may not edit" (fn t ->
    on_lib! (List.concat ann_in [World.emptied ann, line ann "/reset lever"]) (fn w _ ->
      t.eq ["You may not reset /r/lever#0."] (heard ann w)))
])

let editor_file = ./_lib/r/editor/room.wand

test "an editor that faults on its new code goes back to the one before" (fn t ->
  keeping! [editor_file] (List.concat ann_in [
    keymaster,
    line ann "/edit /r/editor/room",
    line
      ann
      `,s/| "h" -> _tell ctx _help/| "h" -> _tell ctx (Result.get! (Error "broken"))/`,
    line ann "w",
    World.emptied ann,
    line ann "h",
    line ann "h"
  ]) (fn w _ ->
    t.eq (true, true, true) (
      heard? ann "Something went wrong with The editor." w,
      heard? ann "The editor is back on its version from before the last /update of it." w,
      List.any? (String.starts_with? "Lines are numbered from 1.") (heard ann w)
    )))

-- Ann as a Keymaster, having made the lever loop forever when pulled: a
-- function of its own that calls itself, and `pull` calling it first.
let looping_lever = List.concat ann_in [
  keymaster,
  line ann "/edit lever",
  line
    ann
    ",s/let make (s: State) =/let spin (n: Int) = spin (n + 1) and make (s: State) =/",
  line
    ann
    ",s/run = fn ctx _ -> Driver.Reply(/run = fn ctx _ -> if spin 0 then Driver.nothing else Driver.Reply(/",
  line ann "w",
  line ann "q",
  World.emptied ann
]

let pulls n = List.map (fn _ -> line ann "pull lever") (List.range 1 n)

let faults_of (w: World.Current) =
  List.filter_map
    (fn (e: World.Event) -> if e.event == "fault" then e.text else None)
    w.events

group "limits" (fn () -> [
  test "a verb that never ends is stopped, and the world goes on" (fn t ->
    keeping! [lever] (List.concat looping_lever [line ann "pull lever", line ann "look"]) (fn w _ ->
      t.eq (true, ["ran out of steps after 100000"], true) (
        heard? ann "Something went wrong with brass lever." w,
        faults_of w,
        heard? ann "The Commons" w
      ))),
  test "an object that faults five times in a row stops working" (fn t ->
    keeping! [lever] (List.concat looping_lever (pulls 6)) (fn w _ ->
      t.eq (true, true, 5) (
        heard?
          ann
          "brass lever has stopped working. Its builder can fix it and /update it, or /reset it."
          w,
        heard? ann "brass lever is not working." w,
        List.length (faults_of w)
      ))),
  test "/reset gives a stopped object a new start" (fn t ->
    keeping! [lever] (List.concat
      looping_lever
      (List.concat (pulls 5) [
        World.emptied ann,
        line ann "/reset lever",
        line ann "pull lever"
      ])
    ) (fn w _ ->
      t.eq ["Reset /r/lever#0.", "Something went wrong with brass lever."] (heard ann w))),
  test "a line too long to show is refused" (fn t ->
    keeping! [lever] (List.concat ann_in [
      keymaster,
      line ann "/edit lever",
      line ann "1a",
      line ann "import String",
      line ann ".",
      line ann `,s/"You pull the lever. Clunk."/(String.repeat 9000 "x")/`,
      line ann "w",
      line ann "q",
      World.emptied ann,
      line ann "pull lever"
    ]) (fn w _ ->
      t.eq (false, true) (
        List.any? (fn l -> String.length l > 8192) (heard ann w),
        List.any?
          (fn (e: World.Event) -> e.event == "refused"
          && e.text == Some "a line of 9000 characters, and the most is 8192")
          w.events
      ))),
  test "a saved state too big to keep is left out of the snapshot" (fn t ->
    keeping! [lever] (List.concat ann_in [
      keymaster,
      line ann "/edit lever",
      line ann "1a",
      line ann "import String",
      line ann ".",
      line
        ann
        `,s/save = fn () -> State.encoder s/save = fn () -> JSON.of_string (String.repeat 70000 "x")/`,
      line ann "w",
      line ann "q"
    ]) (fn w _ ->
      with FS.temp_dir "wmd_ed_" as d ->
      with Shared.make w as state -> (
        Engine.snapshot! state (Path.join d ./world.json) at;
        t.ok
          (List.any?
            (fn (e: World.Event) -> e.event == "fault"
            && e.actor == "/r/lever#0"
            && e.text == Some "save: its saved state is 70002 bytes, and the most is 65536")
            (Shared.get state).events)
      )))
])
