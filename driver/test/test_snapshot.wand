uses {FS.Read, FS.Write, Random, Shared}

-- A world saved to world.json and made again from it.

import FS
import JSON
import List
import Map
import Option
import Path
import Shared
import String

let {test, group} = import Test
import ../Library
import ../Engine
import ../Snapshot
import ../World

let Driver = import ../../driver

-- A new world, with the Library in lib/ loaded and passwords hashed with a
-- test pepper.
let start = Library.with_lib! ./lib (World.with_pepper "test pepper")

let at = "2026-09-30T12:00:00Z"

let ann = World.session_id 0

let line text = World.queue (World.Line ann at text)

-- Ann signs up and pulls the lever twice.
let _changes = [
  World.open_next at,
  line "ann",
  line "2000-05-01",
  line "ann-password",
  line "ann-password",
  line "sign rules",
  line "pull lever",
  line "pull lever"
]

let _play state = List.each (fn f -> (Shared.update state f; Engine.step state)) _changes

-- Play, save to `path`, and give back the world as it was saved.
let saved! path =
  with Shared.make start as state -> (
    Engine.boot state at;
    _play state;
    Engine.snapshot! state path at;
    Shared.get state
  )

-- A new world made from the file at `path`.
let restored! path =
  with Shared.make start as state ->
  match Snapshot.read! path with
  | Some f -> (Engine.restore state f at; Engine.boot state at)
  | None -> Shared.get state

let _where (w: World.Current) =
  List.sort (List.map (fn (i: World.Instance) -> (i.id, i.env)) (Map.values w.instances))

let _lever (w: World.Current) =
  Option.and_then (fn (i: World.Instance) -> i.saved) (World.instance "/r/lever#0" w)

group "a snapshot" (fn () -> [
  test "brings back the accounts, the objects and where each one is" (fn t ->
    with FS.temp_dir "wmd_snap_" as d -> (
      let path = Path.join d ./world.json;
      let before = saved! path;
      let after = restored! path;
      t.eq (Map.keys before.accounts, _where before) (Map.keys after.accounts, _where after)
    )),
  test "brings back each object's own state" (fn t ->
    with FS.temp_dir "wmd_snap_" as d -> (
      let path = Path.join d ./world.json;
      let _ = saved! path;
      t.eq (Some (JSON.parse! `{"pulls": 2}`)) (_lever (restored! path))
    )),
  test "keeps the password hash and never the pepper" (fn t ->
    with FS.temp_dir "wmd_snap_" as d -> (
      let path = Path.join d ./world.json;
      let _ = saved! path;
      let text = FS.read_file! path;
      t.eq (true, false) (
        String.contains? "hmac-sha256$" text,
        String.contains? "test pepper" text
      )
    )),
  test "saves again only what changed" (fn t ->
    with FS.temp_dir "wmd_snap_" as d -> (
      let path = Path.join d ./world.json;
      with Shared.make start as state -> (
        Engine.boot state at;
        _play state;
        Engine.snapshot! state path at;
        Shared.update state (line "pull lever");
        Engine.step state;
        let (w: World.Current) = Shared.get state;
        t.eq ([], []) (
          List.filter
            (fn (i: World.Instance) -> Option.none? i.saved && i.id != "/r/lever#0")
            (Map.values w.instances),
          List.filter
            (fn (i: World.Instance) -> Option.some? i.saved && i.id == "/r/lever#0")
            (Map.values w.instances)
        )
      )
    ))
])

test "brings back who made each object and when, and each account's home" (fn t ->
  with FS.temp_dir "wmd_snap_" as d -> (
    let path = Path.join d ./world.json;
    let before = saved! path;
    let after = restored! path;
    let made (w: World.Current) =
      Option.map
        (fn (i: World.Instance) -> (i.creator, i.created, i.modified))
        (World.instance "/r/lever#0" w);
    t.eq (made before, Map.values before.accounts) (made after, Map.values after.accounts)
  ))

-- A file written before a field was added still reads: the field gets its
-- default.
test "a file without the newer fields still reads" (fn t ->
  with FS.temp_dir "wmd_snap_" as d -> (
    let path = Path.join d ./world.json;
    FS.write_file!
      path
      `{"version": 1, "accounts": [{"name": "Ann", "body": "/std/player#0", "password": "x", "role": "keymaster"}], "instances": [{"id": "/std/player#0", "blueprint": "/std/player", "env": "/r/square#0", "state": {"name": "Ann"}}]}`;
    t.eq
      (Some (None, None))
      (Option.map
        (fn (f: Snapshot.File) -> (
          Option.and_then (fn (a: World.Account) -> a.home) (List.head f.accounts),
          Option.and_then (fn (s: Snapshot.Saved) -> s.created) (List.head f.instances)
        ))
        (Snapshot.read! path))
  ))

let _owners (w: World.Current) =
  List.sort
    (List.map (fn (i: World.Instance) -> (i.id, i.owner, i.size)) (Map.values w.instances))

test "brings back who owns each object, and the size of its state" (fn t ->
  with FS.temp_dir "wmd_snap_" as d -> (
    let path = Path.join d ./world.json;
    let before = saved! path;
    let after = restored! path;
    t.eq (_owners before, true) (
      _owners after,
      List.any? (fn (_, owner, size) -> owner == Some "ann" && size > 0) (_owners after)
    )
  ))

-- A file from before owners were kept: a body is its account's, and the
-- rest is the owner of its file.
test "a file without owners gets them on restore" (fn t ->
  with FS.temp_dir "wmd_snap_" as d -> (
    let path = Path.join d ./world.json;
    FS.write_file!
      path
      `{"version": 1, "accounts": [{"name": "Ann", "body": "/std/player#0", "password": "x"}], "instances": [{"id": "/std/player#0", "blueprint": "/std/player", "env": "/r/square#0", "state": {"name": "Ann"}}, {"id": "/r/square#0", "blueprint": "/r/square", "state": {}}]}`;
    let w = restored! path;
    t.eq (Some "ann", None) (
      World.owner_of "/std/player#0" w,
      World.owner_of "/r/square#0" w
    )
  ))

let _access (w: World.Current) =
  List.sort
    (List.map
      (fn (i: World.Instance) -> (i.id, i.allowed, i.locked))
      (Map.values w.instances))

test "brings back which rooms are private, who is invited, and which things are locked" (fn t ->
  with FS.temp_dir "wmd_snap_" as d -> (
    let path = Path.join d ./world.json;
    let before =
      with Shared.make start as state -> (
        Engine.boot state at;
        _play state;
        Shared.update state (fn w ->
          w
          |> World.set_allowed "/r/square#0" (Driver.Only [])
          |> World.invite "/r/square#0" "Bo"
          |> World.set_locked "/r/lever#0" false);
        Engine.snapshot! state path at;
        Shared.get state
      );
    t.eq (_access before) (_access (restored! path))
  ))

test "brings back flags, held things, signings, notices and pauses" (fn t ->
  with FS.temp_dir "wmd_snap_" as d -> (
    let path = Path.join d ./world.json;
    let before =
      with Shared.make start as state -> (
        Engine.boot state at;
        _play state;
        Shared.update state (fn w ->
          w
          |> World.add_flag World.Flag(
            id = 1,
            by = "ann",
            kind = "object",
            target = "/r/lever#0",
            reason = "rude",
            at = 2026-09-30T12:00:00Z,
            evidence = "brass lever"
          )
          |> World.set_held "/r/lever#0" true
          |> World.set_paused "ann" true
          |> World.notice "ann" "Your lever was flagged.");
        Engine.snapshot! state path at;
        Shared.get state
      );
    let after = restored! path;
    let held (w: World.Current) =
      Option.map (fn (i: World.Instance) -> i.held) (World.instance "/r/lever#0" w);
    t.eq (before.flags, held before, Map.values before.accounts) (
      after.flags,
      held after,
      Map.values after.accounts
    )
  ))

test "keeps when each account was made" (fn t ->
  with FS.temp_dir "wmd_snap_" as d -> (
    let path = Path.join d ./world.json;
    let _ = saved! path;
    t.eq
      (Some 2026-09-30T12:00:00Z)
      (Option.and_then
        (fn (a: World.Account) -> a.created)
        (World.account "ann" (restored! path)))
  ))

test "names the roles of an older file anew, and dates its accounts by their bodies" (fn t ->
  with FS.temp_dir "wmd_snap_" as d -> (
    let path = Path.join d ./world.json;
    let before = saved! path;
    let file = Snapshot.of_world before;
    let older =
      Snapshot.File(
        file,
        accounts =
          List.map
            (fn (a: World.Account) -> World.Account(a, role = "admin", created = None))
            file.accounts
      );
    let after =
      with Shared.make start as state -> (Engine.restore state older at; Shared.get state);
    t.eq
      (Some ("keymaster", Some 2026-09-30T12:00:00Z))
      (Option.map (fn (a: World.Account) -> (a.role, a.created)) (World.account "ann" after))
  ))

test "keeps requests, the rooms that joined a realm, and who built what" (fn t ->
  with FS.temp_dir "wmd_snap_" as d -> (
    let path = Path.join d ./world.json;
    let before =
      with Shared.make start as state -> (
        Engine.boot state at;
        _play state;
        Shared.update state (fn w ->
          w
          |> World.add_request World.Request(
            id = 1,
            by = "ann",
            kind = "join",
            realm = "/r/learning",
            rooms = ["/r/home/ann/shop"],
            at = 2026-09-30T12:00:00Z
          )
          |> World.adopt ["/r/home/ann/shop"] "/r/learning"
          |> World.set_built "/r/home/ann/shop" "ann");
        Engine.snapshot! state path at;
        Shared.get state
      );
    let after = restored! path;
    t.eq (before.requests, before.adopted, before.built) (
      after.requests,
      after.adopted,
      after.built
    )
  ))
