uses {FS.Write, Shared}

-- The log is tested with no files: a handler keeps each append.

import ../Log
import ../World

import List
import Shared

let {test, group} = import Test

let at = "2026-10-02T14:03:11Z"

let login = World.Event(at = at, event = "login", actor = "session:1", name = Some "Ann")

group "a line" (fn () -> [
  test "is one JSON object, with no field that is None" (fn t ->
    t.eq
      "{\"at\":\"2026-10-02T14:03:11Z\",\"event\":\"login\",\"actor\":\"session:1\",\"name\":\"Ann\"}\n"
      (Log.line login)),
  test "goes in the file for its day" (fn t ->
    t.eq ./logs/2026-10-02.jsonl (Log.file ./logs login))
])

-- Log what the world holds, and give back each (path, text) appended and
-- the events left in the world.
let flushed! (w: World.World) =
  with Shared.make w as state ->
  with Shared.make [] as appended -> (
    handle Log.flush! state ./logs with
    | FS!append (path, text) k -> (
      Shared.update appended (fn a -> List.concat a [(path, text)]);
      k ()
    );
    (Shared.get appended, List.length (Shared.get state).events)
  )

test "flush writes each event once and takes it out of the world" (fn t ->
  let w = World.empty |> World.open_next at |> World.open_next at;
  let (appended, left) = flushed! w;
  t.eq ([./logs/2026-10-02.jsonl, ./logs/2026-10-02.jsonl], 0) (
    List.map (fn (p, _) -> p) appended,
    left
  ))
