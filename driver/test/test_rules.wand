uses {FS.Read, FS.Write, Random, Shared}

-- Signing the rules, /help, notices and paused accounts.

import ../Engine
import ../Library
import ../World
import List
import Map
import Option

import Result
import Shared
import String

let {test, group} = import Test
let Driver = import ../../driver

let start =
  World.Current(
    Library.with_lib! ./_lib (World.with_pepper "test pepper"),
    help = Library.help! ./_lib
  )

let at = "2026-09-30T12:00:00Z"

let ann = World.session_id 0

let ann_body = "/std/player#0"

let line sid text = World.queue (World.Line sid at text)

let played changes =
  with Shared.make start as state -> (
    Engine.boot state at;
    List.each (fn f -> (Shared.update state f; Engine.step state)) changes;
    Shared.get state
  )

let heard sid (w: World.Current) = List.filter (fn l -> l != "") (World.outbox sid w)

let heard? sid text (w: World.Current) = List.any? (fn l -> l == text) (heard sid w)

-- Ann signed up, and not yet signed the rules.
let unsigned = [
  World.open_next at,
  line ann "ann",
  line ann "2000-05-01",
  line ann "ann-password",
  line ann "ann-password"
]

let signed = List.concat unsigned [line ann "sign rules"]

-- Ann quits, and logs in again in a new session.
let again =
  let sid = World.session_id 1;
  [
    line ann "/quit",
    World.close ann at,
    World.open_next at,
    line sid "ann",
    line sid "ann-password"
  ]

let rules_v2 (w: World.Current) =
  World.Current(
    w,
    help =
      Map.set
        "rules"
        (String.replace
          "version 1."
          "version 2."
          (Option.default "" (Map.get "rules" w.help)))
        w.help
  )

group "signing the rules" (fn () -> [
  test "a new account wakes in the Rules Hall, and reads them there" (fn t ->
    let w = played unsigned;
    t.eq (Some "/r/rules/hall#0", true) (
      World.env_of ann_body w,
      heard? ann "The rules of WMD, version 1." w
    )),
  test "nothing but reading and signing works before signing" (fn t ->
    let w =
      played
        (List.concat unsigned [World.emptied ann, line ann "say Hi.", line ann "/eval 1"]);
    t.eq
      [
        "First read the rules on the wall, then sign them: sign rules.",
        "First read the rules on the wall, then sign them: sign rules."
      ]
      (heard ann w)),
  test "signing takes the body to the Commons, and keeps the version" (fn t ->
    let w = played signed;
    t.eq (Some "/r/square#0", Some 1, ["signed"]) (
      World.env_of ann_body w,
      Option.and_then
        (fn (a: World.Account) -> Option.map (fn (s: World.Signed) -> s.version) a.rules)
        (World.account "ann" w),
      List.filter
        (fn e -> e == "signed")
        (List.map (fn (e: World.Event) -> e.event) w.events)
    )),
  test "a signed account wakes where it was" (fn t ->
    t.eq (Some "/r/square#0") (World.env_of ann_body (played (List.concat signed again)))),
  test "new rules are signed again at the next login" (fn t ->
    t.eq
      (Some "/r/rules/hall#0")
      (World.env_of ann_body (played (List.flatten [signed, [rules_v2], again])))),
  test "only the Rules Hall may say the rules were signed" (fn t ->
    let w = played signed;
    t.eq (false, true) (
      Result.ok?
        (Engine.allowed
          (Engine.ctx_for w "/r/square#0" ann_body)
          (Driver.Acknowledge ann_body)
          w),
      Result.ok?
        (Engine.allowed
          (Engine.ctx_for w "/r/rules/hall#0" ann_body)
          (Driver.Acknowledge ann_body)
          w)
    ))
])

group "/help" (fn () -> [
  test "lists the topics" (fn t ->
    t.eq
      [
        "Help topics: commands, guide, lesson1, lesson2, lesson3, lesson4, lesson5, lesson6, rules. Type /help and a topic."
      ]
      (heard ann (played (List.concat signed [World.emptied ann, line ann "/help"])))),
  test "shows a topic" (fn t ->
    t.ok
      (heard?
        ann
        "The rules of WMD, version 1."
        (played (List.concat signed [World.emptied ann, line ann "/help rules"])))),
  test "works before signing" (fn t ->
    t.ok
      (heard?
        ann
        "The rules of WMD, version 1."
        (played (List.concat unsigned [World.emptied ann, line ann "/help rules"]))))
])

group "accounts" (fn () -> [
  test "a notice kept while asleep is told at the next login" (fn t ->
    let w =
      played
        (List.flatten [
          signed,
          [
            line ann "/quit",
            World.close ann at,
            World.notice "ann" "Your lamp was flagged."
          ],
          again
        ]);
    t.ok (heard? (World.session_id 1) "Your lamp was flagged." w)),
  test "a paused account may not log in" (fn t ->
    let w =
      played
        (List.flatten [
          signed,
          [line ann "/quit", World.close ann at, World.set_paused "ann" true],
          again
        ]);
    t.eq (true, None) (
      heard? (World.session_id 1) "A Keymaster has paused Ann. What is your name?" w,
      Option.and_then
        (fn (s: World.Session) -> s.body)
        (World.session (World.session_id 1) w)
    ))
])
