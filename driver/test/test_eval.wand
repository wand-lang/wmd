uses {FS.Read, FS.Write, Random, Shared}

-- /eval through the driver: an expression, checked, gated and run under
-- the limits, as a mudlib file is.

import List
import Option
import Shared
import String

let {test, group} = import Test
let engine = import ../engine
let mudlib = import ../mudlib
let world = import ../world

let at = "2026-09-30T12:00:00Z"

let ann = world.session_id 0

let line text = world.queue (world.Line ann at text)

let start = world.World(world.with_pepper "test pepper", lib = (mudlib.load_all! ./lib).lib)

-- Ann logged in, with nothing heard yet, then `lines` typed.
let played lines =
  with Shared.make start as state -> (
    engine.boot state at;
    List.each
      (fn f -> (Shared.update state f; engine.step state))
      (List.concat
        [
          world.open_next at,
          line "ann",
          line "2000-05-01",
          line "ann-password",
          line "ann-password",
          world.emptied ann
        ]
        (List.map line lines));
    Shared.get state
  )

let heard (w: world.World) = List.filter (fn l -> l != "") (world.outbox ann w)

group "/eval" (fn () -> [
  test "a value is shown with its type" (fn t ->
    t.eq ["=> 4 : Int"] (heard (played ["/eval 1 + 3"]))),
  test "ctx is the player's, where they stand" (fn t ->
    t.eq
      [`=> ["/realm/commons/lever#0", "/std/player#0"] : List String`]
      (heard (played ["/eval List.sort (ctx.world.contents ctx.here)"]))),
  test "the standard modules and Random can be used" (fn t ->
    t.eq ["=> true : Bool"] (heard (played ["/eval Random.int 1 6 <= 6"]))),
  test "a list of actions is applied as the player's" (fn t ->
    let w = played [`/eval [core.Spawn "/realm/commons/lever" ctx.here]`];
    t.eq (["=> 1 actions"], 2) (
      heard w,
      List.length (world.instances_of "/realm/commons/lever" w)
    )),
  test "an expression that does not check says why" (fn t ->
    t.ok
      (List.any?
        (String.contains? "String and Int are not the same type")
        (heard (played [`/eval 1 + "a"`])))),
  test "a module it may not use is not there" (fn t ->
    t.ok (List.any? (String.contains? "Shell") (heard (played ["/eval Shell.run! $(ls)"])))),
  test "an expression that never ends is stopped" (fn t ->
    t.eq
      ["Something went wrong: ran out of steps after 100000"]
      (heard (played ["/eval (let spin (n: Int) = spin (n + 1); spin 0)"]))),
  test "each one is logged, with the steps it took" (fn t ->
    t.ok
      (List.any?
        (fn (e: world.Event) -> e.event == "eval"
        && String.starts_with? "1 + 3 (" (Option.default "" e.text))
        (played ["/eval 1 + 3"]).events)),
  test "with no expression, an editor buffer whose w runs it" (fn t ->
    t.ok
      (List.any?
        (fn l -> l == "=> 3 : Int")
        (heard (played ["/eval", "a", "1 +", "2", ".", "w", "q"]))))
])
