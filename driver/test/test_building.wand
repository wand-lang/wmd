uses {FS.Read, FS.Write, Random, Shared}

-- Building out a home: /dig, /files, and the file a room is in.

import ../Engine
import ../Library
import ../World
import FS
import List
import Option
import Resource
import Result
import Shared
import String

let {test, group} = import Test

let Driver = import ../../driver

let loaded = Library.load_all! ./_lib

let at = "2026-09-30T12:00:00Z"

let dee = World.session_id 0

let dee_body = "/std/player#0"

let line text = World.queue (World.Line dee at text)

-- Dee's home, where these tests build. It must not exist before a test,
-- and it is removed after one, so the Library is left as it was found.
let home = ./_lib/r/home/dee

let _clean () = (
  let _ = FS.delete_tree home;
  match FS.list_dir ./_lib/r/home with
  | Ok [] -> (let _ = FS.delete_tree ./_lib/r/home; ())
  | _ -> ()
)

-- Dee signs up and plays `changes`; `check` gets the world.
let built! changes check =
  if FS.exists? home then
    Result.get!
      (Error "%{home} exists: the building tests build there, and remove it after")
  else with Resource.make (fn () -> ()) (fn () -> _clean ()) as _ ->
  with Shared.make (Library.into loaded (World.with_pepper "test pepper")) as state -> (
    Engine.boot state at;
    List.each
      (fn f -> (Shared.update state f; Engine.step state))
      (List.concat
        [
          World.open_next at,
          line "dee",
          line "2000-05-01",
          line "dee-password",
          line "dee-password",
          line "sign rules",
          World.emptied dee
        ]
        changes);
    check (Shared.get state)
  )

let heard (w: World.Current) = List.filter (fn l -> l != "") (World.outbox dee w)

let where (w: World.Current) = World.env_of dee_body w

-- Dee's first room, dug from the Commons, and Dee in it.
let in_hall = [
  line "/dig hall hall",
  line `/eval [Driver.Move ctx.actor "/r/home/dee/hall"]`,
  World.emptied dee
]

group "/dig" (fn () -> [
  test "from a room not yours, makes a room in your home and says how to go there" (fn t ->
    built! [line "/dig hall hall"] (fn w ->
      t.eq
        [
          `Dug a room at /r/home/dee/hall. No exit leads there from The Commons. Go there with /eval [Driver.Move ctx.actor "/r/home/dee/hall"]`
        ]
        (heard w))),
  test "from your own room, adds the exit and leads back" (fn t ->
    built! (List.concat in_hall [line "/dig east shop/front", line "east", line "west"]) (fn w ->
      t.eq (true, Some "/r/home/dee/hall#0") (
        List.any? (fn l -> l == "Dug east to /r/home/dee/shop/front.") (heard w),
        where w
      ))),
  test "names a direction with its short form, so e goes that way and w comes back" (fn t ->
    built! (List.concat in_hall [line "/dig east shop/front", line "e", line "w"]) (fn w ->
      t.eq (true, true, Some "/r/home/dee/hall#0") (
        Result.map
          (String.contains? `"e*ast" = Driver.Exit(to = "/r/home/dee/shop/front")`)
          (FS.read_file ./_lib/r/home/dee/hall.wand) == Ok true,
        Result.map
          (String.contains? `"w*est" = Room.exit "/r/home/dee/hall"`)
          (FS.read_file ./_lib/r/home/dee/shop/front.wand) == Ok true,
        where w
      ))),
  test "makes the directories it needs" (fn t ->
    built! (List.concat in_hall [line "/dig east shop/front"]) (fn _ ->
      t.ok (FS.exists? ./_lib/r/home/dee/shop/front.wand))),
  test "will not dig an exit the room has" (fn t ->
    built! (List.concat in_hall [
      line "/dig east shop/front",
      World.emptied dee,
      line "/dig east shop/back"
    ]) (fn w ->
      t.eq ["A new room has an exit east already."] (heard w))),
  test "digs only where you may build" (fn t ->
    built! [line "/dig door /r/home/bo/den"] (fn w ->
      t.eq ["You may not make /r/home/bo/den."] (heard w)))
])

group "/files" (fn () -> [
  test "lists your home" (fn t ->
    built! (List.concat in_hall [line "/dig east shop/front", World.emptied dee, line "/files"]) (fn w ->
      t.eq ["/r/home/dee/:", "  hall", "  shop/"] (heard w))),
  test "lists a directory in it" (fn t ->
    built! (List.concat in_hall [line "/dig east shop/front", World.emptied dee, line "/files shop"]) (fn w ->
      t.eq ["/r/home/dee/shop/:", "  front"] (heard w))),
  test "lists only where you may build" (fn t ->
    built! [line "/files /r/learning"] (fn w ->
      t.eq ["You may not list /r/learning."] (heard w)))
])

group "look" (fn () -> [
  test "shows the room's file to whoever may edit it" (fn t ->
    built! (List.concat in_hall [line "look"]) (fn w ->
      t.ok (List.any? (fn l -> l == "File: /r/home/dee/hall") (heard w)))),
  test "and not to anyone else" (fn t ->
    built! [line "look"] (fn w ->
      t.not_ok (List.any? (fn l -> l == "File: /r/square") (heard w))))
])

group "looking through an exit" (fn () -> [
  test "shows its view, when it has one" (fn t ->
    built! [line "look west"] (fn w ->
      t.eq
        ["Through the open door to the west, a long hall lined with numbered doors."]
        (heard w))),
  test "and otherwise the room on the other side" (fn t ->
    built! [line "look north"] (fn w ->
      t.eq
        ["The Garden", "A small walled garden. A path leads back south to the Commons."]
        (heard w)))
])

group "short forms" (fn () -> [
  test "a name with a * answers to any start of it as long as the part before the *" (fn t ->
    t.eq
      [true, true, true, false, false]
      (List.map (Driver.names? "l*ook") ["l", "loo", "look", "looks", "x"])),
  test "and one without answers only in full" (fn t ->
    t.eq [true, false] (List.map (Driver.names? "go") ["go", "g"])),
  test "an exit is found by a short form, and shown without its *" (fn t ->
    t.eq (Some "north", Some "north", None) (
      Option.map
        (fn (n, _) -> n)
        (Driver.exit_named "n" {"n*orth" = Driver.Exit(to = "/r/a")}),
      Option.map
        (fn (n, _) -> n)
        (Driver.exit_named "north" {"n*orth" = Driver.Exit(to = "/r/a")}),
      Option.map
        (fn (n, _) -> n)
        (Driver.exit_named "x" {"n*orth" = Driver.Exit(to = "/r/a")})
    )),
  test "an exit's name may be several words, in any case" (fn t ->
    t.eq
      [Some "The Commons", Some "The Commons", Some "The Commons", None]
      (List.map (fn typed -> Option.map
        (fn (n, _) -> n)
        (Driver.exit_named typed {"The Commons" = Driver.Exit(to = "/r/square")})
      ) ["the commons", "THE  Commons", "  the commons ", "the"])),
  test "a verb answers to a short form" (fn t ->
    built! (List.concat in_hall [line "lo"]) (fn w ->
      t.ok (List.any? (fn l -> l == "A new room") (heard w))))
])
