uses {FS.Read, FS.Write}

-- Library files by blueprint path.

import ../Files

import FS
import Option
import Path
import String

let Driver = import ../../driver

let {test, group} = import Test

group "a file moved to another directory" (fn () -> [
  test "imports the same files from its new place" (fn t ->
    t.eq
      "let Driver = import ../../../std/driver\nlet Room = import ../../../std/room"
      (Files.moved
        "/r/learning/lever"
        "/r/home/ann/lever"
        "let Driver = import ../../std/driver\nlet Room = import ../../std/room")),
  test "keeps an import of a file beside it beside it" (fn t ->
    t.eq
      "import ../../learning/orc"
      (Files.moved "/r/learning/orcs" "/r/home/ann/orcs" "import ./orc")),
  test "leaves every other line as it was" (fn t ->
    t.eq
      "uses {Random}\n\nimport JSON\nlet x = 1"
      (Files.moved
        "/r/learning/lever"
        "/r/home/ann/lever"
        "uses {Random}\n\nimport JSON\nlet x = 1")),
  test "goes up as far as the two places differ" (fn t ->
    t.eq
      "let Driver = import ../std/driver"
      (Files.moved "/r/home/ann/lever" "/r/lever" "let Driver = import ../../../std/driver"))
])

group "a room /dig makes" (fn () -> [
  test "imports from its own directory" (fn t ->
    t.eq
      "../../../../std/driver"
      (Driver.import_from "/r/home/ann/shop/front" "/std/driver")),
  test "takes one more exit below the marker" (fn t ->
    let made =
      "%{Driver.dig_marker}\nlet exits = {\n  west = Room.exit \"/r/home/ann/hall\"\n}";
    t.eq
      (Some true)
      (Option.map
        (fn s -> String.contains? `east = Driver.Exit(to = "/r/home/ann/shop/back"),` s)
        (Files.with_exit "east" "/r/home/ann/shop/back" None made))),
  test "fills an empty exits block" (fn t ->
    t.eq
      (Some "%{Driver.dig_marker}\nlet exits = {up = Driver.Exit(to = \"/r/a\")}")
      (Files.with_exit "up" "/r/a" None "%{Driver.dig_marker}\nlet exits = {}")),
  test "leaves a room written by hand alone" (fn t ->
    t.eq None (Files.with_exit "up" "/r/a" None "let exits = {}")),
  test "writes a view, escaped, so it reads back as typed" (fn t ->
    t.eq
      "up = Driver.Exit(to = \"/r/a\", view = Some \"A sign: \\\"Keep out\\\" \\\\ \\\%{name}\")"
      (Files.exit_line "up" "/r/a" (Some "A sign: \"Keep out\" \\ \%{name}")))
])

test "lists a directory: each blueprint by its name, and each directory with a /" (fn t ->
  with FS.temp_dir "wmd_files_" as lib -> (
    FS.mkdir! (Path.join lib ./r/home/ann/shop);
    FS.write_file! (Path.join lib ./r/home/ann/lamp.wand) "";
    FS.write_file! (Path.join lib ./r/home/ann/notes.txt) "";
    t.eq (Some ["lamp", "shop/"], None) (
      Files.list lib "/r/home/ann",
      Files.list lib "/r/home/bo"
    )
  ))
