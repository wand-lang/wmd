-- The driver's world: every object instance and where it is, the sessions
-- and their outboxes, the accounts, the input waiting for the driver, and
-- the events not yet logged.
--
-- Every function here is pure and takes the world last, so a change is a
-- pipeline. Session fibers change only their own session, outbox and the
-- input queue; everything else is changed by the one driver fiber.

import Int
import JSON
import List
import Map
import Option
import Result
import String

import ./Inspiration

let Core = import ../lib/std/core

-- One object in the world. `object` is what the blueprint's `create`
-- built, or the `next` of its last reply. `saved` is what its `save` gave
-- at the last snapshot, and None once it has changed since, so a snapshot
-- calls `save` only on what changed. `creator` is the actor whose command
-- made it: a player, or an object acting on its own, such as a room that
-- makes its furniture. It is None for what the driver made. `created`
-- and `modified` are the times of the inputs that made it and last
-- changed it.
--
-- `owner` is the account, by its key, whose Capacity the object counts
-- against and whose Inspiration its work spends. It is None for what the
-- admins own, as the driver and every realm say. `size` is how many
-- bytes its saved state was at the last snapshot.
--
-- `allowed` says who may enter a room, besides its owner and the Keymasters:
-- everyone, or only the accounts it names. An object that is `locked` is
-- moved only by what its owner owns.
type Instance(
  id: String,
  blueprint: String,
  object: Core.Object,
  env: Option String = None,
  saved: Option JSON = None,
  creator: Option String = None,
  created: Option String = None,
  modified: Option String = None,
  owner: Option String = None,
  size: Int = 0,
  allowed: Core.Allowed = Core.Only [],
  locked: Bool = true,
  -- Held for review after enough flags: it shows as waiting for a Keymaster,
  -- and runs nothing, until a Keymaster resolves its flags.
  held: Bool = false,
  -- How many of its calls in a row have faulted. It is not saved: a
  -- restart gives every object a new start.
  faults: Int = 0
)

-- One connection. `body` is None until login.
type Session(id: String, body: Option String = None, closing: Bool = false)

-- An account: its name as written, its body, its password as
-- "./password" keeps one, and its role, "citizen" or "keymaster". `created`
-- is when it was made, which for a Citizen is when it passed the age check
-- at signup: the date of birth is never kept. `home` is
-- the room its body goes home to, when not the arrival room, and
-- `last_seen` when its session last ended. `inspiration` starts full: the
-- full amount at the epoch is full at any time after. `explored` is every
-- room that has given it an exploring bonus, and when. `rules` is
-- the version of the rules it signed and when. `notices` wait for its next
-- login. A `paused` account may not log in. `banned` is the accounts, by
-- key, that may not enter any room this one owns.
type Account(
  name: String,
  body: String,
  password: String,
  role: String = "citizen",
  created: Option DateTime = None,
  home: Option String = None,
  last_seen: Option String = None,
  inspiration: Inspiration.Inspiration = Inspiration.Inspiration(amount = 1000, at = 1970-01-01T00:00:00Z),
  explored: Map DateTime = {},
  rules: Option Signed = None,
  notices: List String = [],
  paused: Bool = false,
  banned: List String = []
)

-- The version of the rules an account signed, and when.
type Signed(version: Int, at: DateTime)

-- A flag: `by`, an account, says `target` breaks the rules. `kind` is
-- "room", "object" or "person". `evidence` is what the target was when it
-- was flagged, so editing it later does not change what a Keymaster sees.
type Flag(
  id: Int,
  by: String,
  kind: String,
  target: String,
  owner: Option String = None,
  reason: String,
  at: DateTime,
  evidence: String,
  open: Bool = true,
  resolution: Option String = None
)

-- What a session hands the driver.
type Input =
  Connect String String
  | Line String String String
  | Gone String String (Option String)

-- A call-out: the verb `verb` of `target`, to run once at `due`. `id` tells
-- apart two that are otherwise the same.
type Callout(id: Int, target: String, due: DateTime, verb: String)

-- A request to a realm's Stewards, as a flag is to the Keymasters: `by`,
-- an account, asks the realm `realm` to take its `rooms`, by blueprint
-- path, the entrance first, as they were when it asked. `kind` is "join",
-- for rooms its own that join the realm and stay its own, or "open", for
-- rooms it built inside the realm under a contract, which the realm owns.
-- `changed` is each of those files saved since it asked. `outcome` is
-- "approved", "declined: <reason>" or "withdrawn".
type Request(
  id: Int,
  by: String,
  kind: String,
  realm: String,
  rooms: List String,
  at: DateTime,
  changed: List String = [],
  open: Bool = true,
  outcome: Option String = None
)

-- One line of the event log. A field that does not apply is None, and the
-- log line leaves it out.
type Event(
  at: String,
  event: String,
  actor: String,
  name: Option String = None,
  verb: Option String = None,
  room: Option String = None,
  text: Option String = None,
  object: Option String = None
)

type World(
  instances: Map Instance,
  sessions: Map Session,
  outboxes: Map (List String),
  accounts: Map Account,
  inputs: List Input,
  events: List Event,
  -- How many sessions have opened: the next session's number.
  opened: Int,
  -- The server's secret, from WMD_PEPPER. Held here, and never written to
  -- world.json.
  pepper: String = "",
  -- Set by the timer and cleared by the snapshot, which the driver fiber
  -- takes, so a snapshot never sees an object halfway through a change.
  snapshot_due: Bool = false,
  -- When the input the driver is working on arrived: what `ctx.time` says.
  -- Set on the driver's working copy only; nothing else reads it.
  now: DateTime = 1970-01-01T00:00:00Z,
  -- The mudlib directory, where the editor reads and saves files.
  lib_root: Path = ./lib,
  -- Every blueprint the driver can spawn, by path, such as /std/player:
  -- each file's module, as loaded at start or by /update since.
  lib: Map Core.Blueprint = {},
  -- Every realm, by the path of its file, such as /r/home: the files that
  -- implement Core.Realm as well as Core.Blueprint.
  realms: Map Core.Realm = {},
  -- The editor as it was before the last /update of it, for an editor that
  -- faults on its new code to go back to.
  editor_before: Option Core.Blueprint = None
,
  -- Help topics, by name: the text files in the mudlib's help/.
  help: Map String = {},
  -- Every flag, oldest first, open and resolved.
  flags: List Flag = [],
  -- The last lines each body said, for a report. They are not saved.
  said: Map (List String) = {},
  -- The instances with a heartbeat, by id, so the driver sees whether there
  -- is anything to tick without looking at every object.
  beating: Map Bool = {},
  -- The call-outs not yet run, soonest first.
  callouts: List Callout = [],
  -- How many call-outs have been made: the next one's id.
  callouts_made: Int = 0,
  -- Every request to a realm, oldest first, open and closed.
  requests: List Request = [],
  -- The rooms that joined a realm outside its directory, by blueprint
  -- path, and the realm each joined.
  adopted: Map String = {},
  -- Who built each room or thing, by its blueprint path: the Citizen whose
  -- save made its file, whoever owns it now.
  built: Map String = {},
  -- The room each reviewer came from, by their body, while they visit a
  -- request. It is not saved.
  visiting: Map String = {}
)

let empty =
  World(
    instances = Map.empty,
    sessions = Map.empty,
    outboxes = Map.empty,
    accounts = Map.empty,
    inputs = [],
    events = [],
    opened = 0
  )

-- The most lines an outbox holds. A session whose outbox is full is closed.
let outbox_cap = 1000

-- ── Ids ────────────────────────────────────────────────────────────────

-- The blueprint of an instance id: /r/lever#0 is
-- /r/lever.
let blueprint_of id = Option.default id (List.head (String.split "#" id))

-- An exit or a Move may name a blueprint, meaning its first instance.
let resolve id = if String.contains? "#" id then id else "%{id}#0"

let session? id = String.starts_with? "session:" id

-- ── Instances ──────────────────────────────────────────────────────────

let instance id (w: World) = Map.get (resolve id) w.instances

let put (i: Instance) (w: World) =
  World(
    w,
    instances = Map.set i.id i w.instances,
    beating = if Option.some? i.object.heartbeat then Map.set i.id true w.beating
      else Map.delete i.id w.beating
  )

let env_of id (w: World) = Option.and_then (fn (i: Instance) -> i.env) (instance id w)

let contents id (w: World) =
  List.map
    (fn (i: Instance) -> i.id)
    (List.filter (fn (i: Instance) -> i.env == Some (resolve id)) (Map.values w.instances))

let set_object id (o: Core.Object) at (w: World) =
  match instance id w with
  | Some i -> put Instance(i, object = o, saved = None, modified = Some at, faults = 0) w
  | None -> w

-- A call on the object faulted, or one did not: how many in a row did.
let faulted id (w: World) =
  match instance id w with
  | Some i -> put Instance(i, faults = i.faults + 1) w
  | None -> w

let worked id (w: World) =
  match instance id w with
  | Some i when i.faults > 0 -> put Instance(i, faults = 0) w
  | _ -> w

-- Who made an object and when, as a snapshot kept them.
let set_made id creator created modified (w: World) =
  match instance id w with
  | Some i -> put Instance(i, creator = creator, created = created, modified = modified) w
  | None -> w

-- ── Ownership ──────────────────────────────────────────────────────────

let owner_of id (w: World) = Option.and_then (fn (i: Instance) -> i.owner) (instance id w)

let set_owner id owner (w: World) =
  match instance id w with
  | Some i -> put Instance(i, owner = owner) w
  | None -> w

-- The instances `owner` owns.
let owned owner (w: World) =
  List.filter (fn (i: Instance) -> i.owner == Some owner) (Map.values w.instances)

-- How many bytes of saved state `owner`'s instances had at the last
-- snapshot.
let saved_bytes owner (w: World) =
  List.fold_left (fn n (i: Instance) -> n + i.size) 0 (owned owner w)

-- The instances of blueprint `bp`, by id.
let instances_of bp (w: World) =
  List.map
    (fn (i: Instance) -> i.id)
    (List.filter (fn (i: Instance) -> i.blueprint == bp) (Map.values w.instances))

-- Use `b` for blueprint `path` from now on.
let set_blueprint path (b: Core.Blueprint) (w: World) = World(w, lib = Map.set path b w.lib)

-- Use `r` for the realm whose file is `path` from now on.
let set_realm path (r: Core.Realm) (w: World) = World(w, realms = Map.set path r w.realms)

-- Take an object out of the world, with its call-outs.
let remove id (w: World) =
  let full = resolve id;
  World(
    w,
    instances = Map.delete full w.instances,
    beating = Map.delete full w.beating,
    callouts = List.filter (fn (c: Callout) -> c.target != full) w.callouts
  )

let move id dest (w: World) =
  match instance id w with
  | Some i -> put Instance(i, env = Some (resolve dest)) w
  | None -> w

-- The next free instance number of a blueprint: one past the highest in
-- use, so a gap left by a restore or a removal is never filled twice.
let next_number bp (w: World) =
  List.fold_left
    (fn n (i: Instance) -> if i.blueprint != bp then n
      else match Result.to_option
        (String.to_int (Option.default "" (List.get 1 (String.split "#" i.id)))) with
        | Some k -> if k + 1 > n then k + 1 else n
        | None -> n
    )
    0
    (Map.values w.instances)

-- ── Accounts ───────────────────────────────────────────────────────────

-- Accounts are keyed by the lower-case name, so Ann and ANN are one.
let account name (w: World) = Map.get (String.lower name) w.accounts

let add_account (a: Account) (w: World) =
  World(w, accounts = Map.set (String.lower a.name) a w.accounts)

-- The account whose body is `body`.
let account_of body (w: World) =
  List.find (fn (a: Account) -> a.body == body) (Map.values w.accounts)

let _put_account body f (w: World) =
  match account_of body w with
  | Some a -> add_account (f a) w
  | None -> w

let set_home body room (w: World) =
  _put_account body (fn a -> Account(a, home = Some room)) w

let seen body at (w: World) = _put_account body (fn a -> Account(a, last_seen = Some at)) w

-- Change the account with key `name`.
let _put_named name f (w: World) =
  match account name w with
  | Some a -> add_account (f a) w
  | None -> w

let spend name cost now (w: World) =
  _put_named
    name
    (fn a -> Account(a, inspiration = Inspiration.spend now cost a.inspiration))
    w

-- An exploring bonus, for the first visit to `room`.
let inspire name room now (w: World) =
  _put_named
    name
    (fn a -> Account(
      a,
      inspiration = Inspiration.earn now Inspiration.bonus a.inspiration,
      explored = Map.set room now a.explored
    ))
    w

-- ── Sessions ───────────────────────────────────────────────────────────

let session sid (w: World) = Map.get sid w.sessions

let _put_session (s: Session) (w: World) = World(w, sessions = Map.set s.id s w.sessions)

-- True when the session should end, or is gone already.
let closing? sid (w: World) =
  match session sid w with
  | Some s -> s.closing
  | None -> true

let close_soon sid (w: World) =
  match session sid w with
  | Some s -> _put_session Session(s, closing = true) w
  | None -> w

-- The session a body is attached to.
let session_of body (w: World) =
  List.find (fn (s: Session) -> s.body == Some body) (Map.values w.sessions)

let attach sid body (w: World) =
  match session sid w with
  | Some s -> _put_session Session(s, body = Some body) w
  | None -> w

let outbox sid (w: World) = Option.default [] (Map.get sid w.outboxes)

-- Add lines to one session's outbox. A full outbox closes the session
-- instead, so one session that does not read cannot grow without bound.
let tell_session sid text (w: World) =
  match Map.get sid w.outboxes with
  | Some lines -> if List.length lines >= outbox_cap then close_soon sid w
    else World(
      w,
      outboxes = Map.set sid (List.concat lines (String.split "\n" text)) w.outboxes
    )
  | None -> w

-- Tell a session, or the session a body is attached to. A body with no
-- session is asleep and hears nothing.
let tell id text (w: World) =
  if session? id then tell_session id text w
  else match session_of (resolve id) w with
    | Some s -> tell_session s.id text w
    | None -> w

-- Empty an outbox. Its writer takes the lines from the world this was
-- applied to, which Shared.update answers. A session that closed in the
-- meantime stays closed.
let emptied sid (w: World) =
  match Map.get sid w.outboxes with
  | Some _ -> World(w, outboxes = Map.set sid [] w.outboxes)
  | None -> w

-- ── Input and events ───────────────────────────────────────────────────

let queue (i: Input) (w: World) = World(w, inputs = List.concat w.inputs [i])

-- When an input arrived.
let at_of (i: Input) =
  match i with
  | Connect _ at -> at
  | Line _ at _ -> at
  | Gone _ at _ -> at

-- True while the driver has not finished with something a session sent.
let pending? sid (w: World) =
  List.any?
    (fn i -> match i with
      | Connect s _ -> s == sid
      | Line s _ _ -> s == sid
      | Gone _ _ _ -> false
    )
    w.inputs

-- Remove the first `n` inputs: the ones the driver took.
let dequeued n (w: World) = World(w, inputs = List.drop n w.inputs)

let emit ev (w: World) = World(w, events = List.concat w.events [ev])

-- Take every event out. The logger writes the ones in the world this was
-- applied to, which Shared.update answers.
let all_logged (w: World) = World(w, events = [])

-- ── Connections ────────────────────────────────────────────────────────

-- A new session. The driver greets it when it takes the Connect.
let open sid at (w: World) =
  World(
    w,
    sessions = Map.set sid Session(id = sid) w.sessions,
    outboxes = Map.set sid [] w.outboxes
  )
  |> queue (Connect sid at)
  |> emit Event(at = at, event = "connect", actor = sid)

-- The id of the `n`th session to open.
let session_id n = "session:%{n}"

-- A new session, numbered in the order sessions opened. Its id is
-- `session_id` of the `opened` in the world this was applied to.
let open_next at (w: World) = open (session_id w.opened) at World(w, opened = w.opened + 1)

-- Remove a session and its outbox. Its body stays in the world, asleep;
-- the driver tells the room when it takes the Gone.
let close sid at (w: World) =
  match session sid w with
  | None -> w
  | Some s ->
    World(w, sessions = Map.delete sid w.sessions, outboxes = Map.delete sid w.outboxes)
    |> queue (Gone sid at s.body)
    |> emit Event(at = at, event = "disconnect", actor = sid, object = s.body)

-- ── Snapshots ──────────────────────────────────────────────────────────

-- Keep what an object's `save` gave, until the object changes again.
let keep_saved id (j: JSON) (w: World) =
  match instance id w with
  | Some i -> put Instance(i, saved = Some j, size = String.length (JSON.stringify j)) w
  | None -> w

let snapshot_due (w: World) = World(w, snapshot_due = true)

let snapshot_taken (w: World) = World(w, snapshot_due = false)

let snapshot_due? (w: World) = w.snapshot_due

-- ── Time ───────────────────────────────────────────────────────────────

-- Keep `cs` soonest first. Two due at the same time stay in the order
-- they were made.
let _soonest cs = List.sort_by (fn (c: Callout) -> c.due) cs

-- Run the verb `verb` of `target` at `due`.
let call_out target due verb (w: World) =
  World(
    w,
    callouts =
      _soonest
        (List.concat w.callouts [
          Callout(id = w.callouts_made, target = resolve target, due = due, verb = verb)
        ]),
    callouts_made = w.callouts_made + 1
  )

-- The call-outs of `target` not yet run.
let callouts_of target (w: World) =
  List.filter (fn (c: Callout) -> c.target == resolve target) w.callouts

-- The call-outs whose time has come by `now`, oldest first.
let due now (w: World) = List.filter (fn (c: Callout) -> c.due <= now) w.callouts

let pending_callout? n (w: World) = List.any? (fn (c: Callout) -> c.id == n) w.callouts

-- A call-out has run, or will not.
let ran n (w: World) =
  World(w, callouts = List.filter (fn (c: Callout) -> c.id != n) w.callouts)

let drop_callouts target (w: World) =
  World(
    w,
    callouts = List.filter (fn (c: Callout) -> c.target != resolve target) w.callouts
  )

-- The call-outs a snapshot kept. New ones are numbered after them.
let restore_callouts cs (w: World) =
  World(
    w,
    callouts = _soonest cs,
    callouts_made =
      List.fold_left (fn n (c: Callout) -> Int.max n (c.id + 1)) w.callouts_made cs
  )

-- Whether there is anything to tick: an object with a heartbeat, or a
-- call-out not yet run.
let ticking? (w: World) = Map.size w.beating > 0 || w.callouts != []

-- How long the driver may sleep before it must tick: `left`, the time to
-- the next heartbeat, while some object has one, and otherwise until the
-- soonest call-out. A call-out already due is 0s. None when there is
-- nothing to tick.
let sleep_for (left: Duration) (now: DateTime) (w: World) =
  if Map.size w.beating > 0 then Some left
  else Option.map (fn (c: Callout) -> c.due - now) (List.head w.callouts)

-- A new world that hashes passwords with `pepper`.
let with_pepper pepper = World(empty, pepper = pepper)

-- ── Access ─────────────────────────────────────────────────────────────

let _put_instance id f (w: World) =
  match instance id w with
  | Some i -> put (f i) w
  | None -> w

let set_allowed id (allowed: Core.Allowed) (w: World) =
  _put_instance id (fn i -> Instance(i, allowed = allowed)) w

-- Whether a room is open to everyone.
let public? (i: Instance) = i.allowed == Core.Everyone

-- Let one more account into a private room. A public room lets in everyone
-- already.
let invite id name (w: World) =
  _put_instance
    id
    (fn i -> match i.allowed with
      | Core.Only names -> Instance(
        i,
        allowed = Core.Only(List.unique (List.concat names [String.lower name]))
      )
      | Core.Everyone -> i
    )
    w

let uninvite id name (w: World) =
  _put_instance
    id
    (fn i -> match i.allowed with
      | Core.Only names -> Instance(
        i,
        allowed = Core.Only(List.filter (fn n -> n != String.lower name) names)
      )
      | Core.Everyone -> i
    )
    w

let set_locked id locked (w: World) =
  _put_instance id (fn i -> Instance(i, locked = locked)) w

-- Who may enter and the lock, as a snapshot kept them.
let set_access id (allowed: Core.Allowed) locked (w: World) =
  _put_instance id (fn i -> Instance(i, allowed = allowed, locked = locked)) w

-- Keep the account `banned` out of every room the account `by` owns, or no
-- longer.
let ban by banned (w: World) =
  _put_named
    by
    (fn a -> Account(a, banned = List.unique (List.concat a.banned [String.lower banned])))
    w

let unban by banned (w: World) =
  _put_named
    by
    (fn a -> Account(a, banned = List.filter (fn n -> n != String.lower banned) a.banned))
    w

-- Whether the account `owner` bans the account `key`.
let banned? owner key (w: World) =
  match account owner w with
  | Some a -> List.any? (fn n -> n == key) a.banned
  | None -> false

-- ── The rules, notices and pauses ──────────────────────────────────────

let sign name version at (w: World) =
  _put_named name (fn a -> Account(a, rules = Some Signed(version, at))) w

-- Tell the account `name` something now if it is awake, and at its next
-- login if not.
let notice name text (w: World) =
  match account name w with
  | Some a -> if Option.some? (session_of a.body w) then tell a.body text w
    else add_account Account(a, notices = List.concat a.notices [text]) w
  | None -> w

-- Take an account's notices out, to tell them.
let noticed name (w: World) = _put_named name (fn a -> Account(a, notices = [])) w

let set_paused name paused (w: World) =
  _put_named name (fn a -> Account(a, paused = paused)) w

-- ── Flags ──────────────────────────────────────────────────────────────

-- The most lines kept of what one body said.
let said_cap = 20

-- Keep a line a body said, for a report.
let said_by body text (w: World) =
  let lines = List.concat (Option.default [] (Map.get body w.said)) [text];
  World(w, said = Map.set body (List.drop (List.length lines - said_cap) lines) w.said)

let add_flag (f: Flag) (w: World) = World(w, flags = List.concat w.flags [f])

let flag n (w: World) = List.find (fn (f: Flag) -> f.id == n) w.flags

let resolve_flag n resolution (w: World) =
  World(
    w,
    flags =
      List.map
        (fn (f: Flag) -> if f.id == n then Flag(f, open = false, resolution = Some resolution)
          else f)
        w.flags
  )

-- The open flags on `target`.
let open_flags target (w: World) =
  List.filter (fn (f: Flag) -> f.open && f.target == target) w.flags

let set_held id held (w: World) = _put_instance id (fn i -> Instance(i, held = held)) w

-- ── Requests ───────────────────────────────────────────────────────────

let add_request (r: Request) (w: World) = World(w, requests = List.concat w.requests [r])

let request n (w: World) = List.find (fn (r: Request) -> r.id == n) w.requests

-- Close request `n` with `outcome`.
let close_request n outcome (w: World) =
  World(
    w,
    requests =
      List.map
        (fn (r: Request) -> if r.id == n then Request(r, open = false, outcome = Some outcome)
          else r)
        w.requests
  )

-- The file of `path` was saved: each open request it is in notes it.
let touched path (w: World) =
  World(
    w,
    requests =
      List.map
        (fn (r: Request) -> if r.open && List.any? (fn p -> p == path) r.rooms then
            Request(r, changed = List.unique (List.concat r.changed [path]))
          else r)
        w.requests
  )

-- The rooms `rooms` join the realm `realm`, or leave the realm they joined.
let adopt rooms realm (w: World) =
  World(w, adopted = List.fold_left (fn m p -> Map.set p realm m) w.adopted rooms)

let unadopt rooms (w: World) =
  World(w, adopted = List.fold_left (fn m p -> Map.delete p m) w.adopted rooms)

-- The Citizen `key` built the file of `path`.
let set_built path key (w: World) = World(w, built = Map.set path key w.built)

-- A reviewer who came from `room` visits, or is back.
let visit body room (w: World) = World(w, visiting = Map.set body room w.visiting)

let back body (w: World) = World(w, visiting = Map.delete body w.visiting)

-- What the builder of a room earns when someone new first visits it.
let reward name now (w: World) =
  _put_named
    name
    (fn a -> Account(a, inspiration = Inspiration.earn now Inspiration.bonus a.inspiration))
    w
