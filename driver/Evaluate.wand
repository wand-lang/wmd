uses {FS.Read, FS.Write}

-- /eval: an expression, run as Library code runs.
--
-- The expression becomes the body of `run ctx`, in a module written for it
-- that implements Driver.Evaluation. The module is checked first, which
-- gives the expression's type, and then loaded as a Library file is: held
-- to the effects `evaluate` allows. A list of actions comes back as
-- actions; anything else comes back as text, with its type.

import FS
import List
import Path
import Regex
import Result
import String
import Wand

let Driver = import ../driver

-- The lines before the expression, which it is indented under: the pure
-- standard modules, Random, which Library code may use, and the contract.
let _head driver_path = [
  "import Int",
  "import JSON",
  "import List",
  "import Map",
  "import Option",
  "import Random",
  "import Result",
  "import String",
  "let Driver = import %{driver_path}",
  "",
  "let run (ctx: Driver.Context) = ("
]

let _indent expr = String.join "\n" (List.map (fn l -> "  %{l}") (String.lines expr))

-- `run` itself, and nothing that uses it: what the check reads.
let _body driver_path expr = "%{String.join "\n" (_head driver_path)}\n%{_indent expr}\n)\n"

-- The type an /eval shows: `run`'s result, without the `Context -> ` before it,
-- and without what `run` performs, which a type writes at its end. When
-- the result is a function, the effects at the end are the function's own.
let result_type t =
  let before = "Context -> ";
  let shown =
    if String.starts_with? before t then
      String.slice (String.length before) (String.length t) t
    else t;
  if String.contains? "->" shown then shown
  else String.trim (Regex.replace r/ ! \{[^}]*\}$/ "" shown)

-- Text as a string literal says it.
let _quoted s = String.replace `"` `\"` (String.replace `\` `\\` s)

-- The module for `expr`, whose result has type `t`.
let source driver_path expr t =
  let evaluate =
    if t == "List Action" then "Driver.Acts (run ctx)"
    else "Driver.Shown \"\%{run ctx} : %{_quoted t}\"";
  "%{_body driver_path expr}\nimplement Driver.Evaluation =\n  let evaluate ctx = %{evaluate}\n"

-- What the check found wrong with the expression, each error at its line
-- in the expression rather than in the module written for it. An error
-- about the whole expression points at the `(` around it, and is shown
-- with no position.
let _errors (c: Wand.Checked) =
  List.filter_map
    (fn (d: Wand.Diagnostic) -> if d.severity == "error" then
        Some
          (if d.line > List.length (_head "") then
            "%{d.line - List.length (_head "")}:%{d.col}: %{d.message}"
          else d.message)
      else None)
    c.diagnostics

-- The expression's module, loaded, or what was wrong with it. It is written
-- in `lib`, the Library root, in a directory of its own, and imports the
-- contract as the game's files do, with `driver` from the game's init.wand,
-- so its types are the driver's. The file is there only while it loads.
let load (lib: Path) driver expr = (
  let dir = Path.join lib ./.eval;
  let driver_path =
    if String.starts_with? "./" driver then
      "../%{String.slice 2 (String.length driver) driver}"
    else if String.starts_with? "../" driver then "../%{driver}"
    else driver;
  let loaded =
    try (
      FS.mkdir! dir;
      let file = Path.join dir ./eval.wand;
      let answer =
        (match Wand.check_at file "%{_body driver_path expr}run\n" with
         | Error why -> Error [why]
         | Ok c -> (
           match (_errors c, c.type) with
           | ([], Some t) -> (
             match FS.write_file file (source driver_path expr (result_type t)) with
             | Error why -> Error [why]
             | Ok _ ->
               Result.map_error (fn why -> [why]) (Wand.load Driver.Evaluation.loader file)
           )
           | ([], None) -> Error ["the expression has no type"]
           | (errors, _) -> Error errors
         ));
      let _ = FS.delete_tree dir;
      answer
    );
  match loaded with
  | Ok r -> r
  | Error why -> Error [why]
)
