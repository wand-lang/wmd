uses {Clock, Env, FS.Read, FS.Write, IO, Net.Listen, Random, Shared, Shell(git)}

-- The server: the telnet listener, the driver loop, the snapshot timer,
-- the event logger and, with --git, the git fiber, side by side, over one
-- Shared World.

import Clock
import Env
import Map
import Option
import Path
import String
import FS
import IO
import List
import Net
import Par
import Resource
import Result
import Shared

import ./Engine
import ./Git
import ./Log
import ./Library
import ./Session
import ./Snapshot
import ./World

-- The flags of `wmd`. Each field is a flag: --port 4000 --logs ./logs.
type Opts(
  port: Port = :4000,
  logs: Path = ./logs,
  lib: Path = ./lib,
  world: Path = ./world.json,
  tick: Duration = 2s,
  -- Whether the Library is a git working copy to pull, commit and push.
  git: Bool = false
)

let _now () = "%{Clock.now ()}"

-- Why the server must not start, if it must not. A missing Library is an
-- error rather than an empty world, so a typo in the path shows. And
-- without the pepper no password can be checked or kept.
let problem (o: Opts) =
  if !(FS.dir? o.lib) then Some "no Library at %{o.lib}; run wmd init to make a world"
  else if Env.get "WMD_PEPPER" == None then
    Some "WMD_PEPPER is not set; it is the secret every password is hashed with"
  else if o.git && !(Git.repo? o.lib) then
    Some "--git, but %{o.lib} is not in a git working copy"
  else None

-- A snapshot is written by the driver loop, between inputs. The timer only
-- says one is due. A snapshot that cannot be written is reported, and the
-- server goes on.
let _snapshot state path =
  match try Engine.snapshot! state path (_now ()) with
  | Ok _ -> ()
  | Error why -> IO.println_err "wmd: snapshot to %{path} failed: %{why}"

-- ── Git ────────────────────────────────────────────────────────────────

-- The file of blueprint path `path`, from the Library root, as git names
-- it: r/home/ann/lamp.wand for /r/home/ann/lamp.
let _file_of path = "%{String.slice 1 (String.length path) path}.wand"

-- Commit the saves the driver has made since the last commit: one commit
-- for each account, with it as the author.
let _commit_saves state (o: Opts) =
  let (w: World.Current) = Shared.get state;
  let saves = w.unsaved;
  let _ = Shared.update state (World.committing (List.length saves));
  List.each
    (fn (key, paths) -> (
      let name =
        Option.default
          key
          (Option.map (fn (a: World.Account) -> a.name) (World.account key w));
      let message = "%{name} saved %{String.join ", " paths}";
      match Git.commit o.lib "%{name} <%{key}@wmd>" message (List.map _file_of paths) with
      | Error why ->
        IO.println_err "wmd: git did not commit %{String.join ", " paths}: %{why}"
      | Ok _ -> ()
    ))
    (World.batches saves)

-- Commit the latest world.json. The driver loop writes it; this only
-- commits what is there.
let _commit_world (o: Opts) =
  match Git.commit (Path.dirname o.world) "wmd <wmd>" "The world" [
    Path.to_string (Path.basename o.world)
  ] with
  | Error why -> IO.println_err "wmd: git did not commit %{o.world}: %{why}"
  | Ok _ -> ()

-- Tell every Keymaster `text`: now, or when they next wake.
let _tell_keymasters text (w: World.Current) =
  List.fold_left
    (fn acc (a: World.Account) -> if a.role == "keymaster" then World.notice a.name text acc
      else acc)
    w
    (Map.values w.accounts)

-- Push what is committed, and give back the files under the Library that
-- came in with someone else's commits, if the push put these after them.
-- When pushing stops, or goes on again, the Keymasters are told.
let _push state (o: Opts) = (
  let (now: World.Current) = Shared.get state;
  let was = now.stopped;
  let went () =
    if was != None then (
      let _ =
        Shared.update state (fn w ->
          w
          |> World.stop_pushing None
          |> _tell_keymasters "The server pushes to the game's repo again.");
      ()
    );
  match Git.push o.lib with
  | Git.Pushed -> (went (); [])
  | Git.Rebased files -> (went (); files)
  | Git.Failed why -> (IO.println_err "wmd: git did not push: %{why}"; [])
  | Git.Conflict why -> (
    let _ = Git.push_aside o.lib "wmd-server";
    if was == None then (
      IO.println_err "wmd: git stopped pushing: %{why}";
      let _ =
        Shared.update state (fn w ->
          w
          |> World.stop_pushing (Some why)
          |> _tell_keymasters
            "The server stopped pushing to the game's repo: someone pushed first, and %{why}. Its commits are on the branch wmd-server. Merge that branch into the main one, and push: the server then pushes again, and /pull brings in the merge.");
      ()
    );
    []
  )
)

-- Run each /pull asked for, after the push, so commits not yet pushed do
-- not stop a fast-forward. Each asker is told what came in, or why nothing
-- did. `came` are the files the push brought in: the first asker is told
-- of them too, or, with no one asking, they load as a /pull loads them.
let _pulls state (o: Opts) came = (
  let (now: World.Current) = Shared.get state;
  let asked = now.pulls;
  let why_not =
    Option.map
      (fn why -> "pushing stopped, because %{why}; merge the branch wmd-server first")
      now.stopped;
  let _ = Shared.update state (World.pulling (List.length asked));
  if asked == [] && came != [] then (
    let _ = Shared.update state (World.queue (World.Pulled(_now ()) None came));
    ()
  );
  let _ =
    List.fold_left
      (fn before body ->
        let at = _now ();
        let _ =
          (
            let pulled =
              (match why_not with
               | Some why -> Error why
               | None -> Git.pull o.lib);
            match pulled with
            | Ok files ->
              Shared.update
                state
                (World.queue (World.Pulled at (Some body) (List.concat before files)))
            | Error why -> Shared.update state (fn w ->
              (if before == [] then w else World.queue (World.Pulled at (Some body) before) w)
              |> World.tell body "Nothing was pulled: %{why}")
          )
        in
        [])
      came
      asked;
  ()
)

-- One round of the git fiber: the saves, the world when it is due, the
-- push, and the /pulls.
let _git_round state (o: Opts) world? = (
  _commit_saves state o;
  if world? then _commit_world o;
  _pulls state o (_push state o);
  let _ = Git.tidy o.lib;
  ()
)

-- Every minute, or at once on a /pull, commit and push. world.json is
-- committed every 15 minutes, from `last`, and at shutdown, because it
-- changes almost every minute while anyone is on.
let _git state (o: Opts) (last: DateTime) = (
  let _ =
    Par.timeout 60s (fn () -> Shared.wait state (fn (w: World.Current) -> w.pulls != []));
  let now = Clock.now ();
  let world? = now >= last + 15m;
  _git_round state o world?;
  _git state o (if world? then now else last)
)

-- As the server starts: commit what an earlier run saved and did not
-- commit, then come up to the game's repo, before the Library loads.
let _git_start! (o: Opts) = (
  let left = Result.get! (Git.dirty o.lib);
  if left != [] then
    match Git.commit o.lib "wmd <wmd>" "Saves from before the restart" left with
  | Error why -> IO.println_err "wmd: git did not commit what was left: %{why}"
  | Ok _ -> ();
  match Git.pull o.lib with
  | Ok files -> IO.println "wmd: pulled %{List.length files} changed Library files"
  | Error why -> IO.println_err "wmd: did not pull: %{why}"
)

-- The world before anything is restored: the pepper, the Library and where
-- its files are. A file that does not load is left out and said, and the
-- rest of the world starts: a builder's broken file does not stop the
-- server.
let _start! (o: Opts) = (
  if o.git then _git_start! o;
  let loaded = Library.load_all! o.lib;
  List.each
    (fn (path, why) -> IO.println_err "wmd: %{path} did not load: %{why}")
    loaded.failed;
  -- Without its init.wand the driver does not know where anything is.
  if loaded.library == None then Result.get! (Error "the game's init.wand did not load")
  else Library.into loaded World.Current(
    World.with_pepper (Env.get! "WMD_PEPPER"),
    lib_root = o.lib,
    help = Library.help! o.lib,
    git = o.git
  )
)

-- The driver sleeps until there is input or a snapshot is due, and wakes
-- on the update that queues it. While something has to tick, it sleeps no
-- longer than until the tick: the next heartbeat, `o.tick` after the start
-- of the last one, or else the soonest call-out. Only this fiber changes
-- what has a heartbeat or a call-out, so nothing moves the tick while it
-- sleeps. A tick that takes longer than `o.tick` makes the next one late:
-- ticks do not stack up.
--
-- `left` is the time to the next heartbeat. It is measured with
-- Clock.timed, because a DateTime keeps whole seconds only, and a clock
-- step would spoil two readings of Clock.now.
let _driver state (o: Opts) left = (
  let ready (w: World.Current) = w.inputs != [] || World.snapshot_due? w;
  let (slept, _) =
    Clock.timed (fn () ->
      let _ =
        match World.sleep_for left (Clock.now ()) (Shared.get state) with
        | None -> Ok (Shared.wait state ready)
        | Some d -> Par.timeout d (fn () -> Shared.wait state ready)
      in
      Engine.step state);
  let after = left - slept;
  let next =
    if World.sleep_for after (Clock.now ()) (Shared.get state) == Some 0s then (
      let (took, _) = Clock.timed (fn () -> Engine.tick state (_now ()));
      o.tick - took
    )
    else after;
  if World.snapshot_due? (Shared.get state) then _snapshot state o.world;
  _driver state o next
)

let run! (o: Opts) = (
  FS.mkdir! o.logs;
  with Shared.make (_start! o) as state ->
  -- On the way out, SIGTERM included, the world is saved and the events not
  -- yet written are written. The release runs before the Shared above is
  -- closed, and after the driver loop has stopped.
  with Resource.make
    (fn () -> ())
    (fn () -> (
      _snapshot state o.world;
      Log.flush! state o.logs;
      if o.git then _git_round state o true
    )) as _ -> (
    (
      match Snapshot.read! o.world with
      | Some f -> (let _ = Engine.restore state f (_now ()); ())
      | None -> ()
    );
    Engine.boot state (_now ());
    IO.println "wmd listening on %{o.port}, world in %{o.world}, logging to %{o.logs}";
    Par.all! [
      fn () -> Net.listen o.port |> Par.each_stream 256 (Session.serve state),
      fn () -> _driver state o o.tick,
      fn () -> Clock.every 60s (fn () -> Shared.update state World.snapshot_due),
      fn () -> Clock.every 1s (fn () -> Log.flush! state o.logs),
      fn () -> if o.git then _git state o (Clock.now ())
    ]
  )
)
