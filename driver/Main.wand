uses {Clock, Env, FS.Read, FS.Write, IO, Net.Listen, Random, Shared}

-- The server: the telnet listener, the driver loop, the snapshot timer and
-- the event logger, side by side, over one Shared World.

import Clock
import Env
import FS
import IO
import List
import Net
import Par
import Resource
import Shared

import ./Engine
import ./Log
import ./Mudlib
import ./Session
import ./Snapshot
import ./World

-- The flags of `wmd`. Each field is a flag: --port 4000 --logs ./logs.
type Opts(
  port: Port = :4000,
  logs: Path = ./logs,
  lib: Path = ./lib,
  world: Path = ./world.json,
  tick: Duration = 2s
)

let _now () = "%{Clock.now ()}"

-- Why the server must not start, if it must not. A missing mudlib is an
-- error rather than an empty world, so a typo in the path shows. And
-- without the pepper no password can be checked or kept.
let problem (o: Opts) =
  if !(FS.dir? o.lib) then Some "no mudlib at %{o.lib}; run wmd init to make a world"
  else if Env.get "WMD_PEPPER" == None then
    Some "WMD_PEPPER is not set; it is the secret every password is hashed with"
  else None

-- A snapshot is written by the driver loop, between inputs. The timer only
-- says one is due. A snapshot that cannot be written is reported, and the
-- server goes on.
let _snapshot state path =
  match try Engine.snapshot! state path (_now ()) with
  | Ok _ -> ()
  | Error why -> IO.println_err "wmd: snapshot to %{path} failed: %{why}"

-- The world before anything is restored: the pepper, the mudlib and where
-- its files are. A file that does not load is left out and said, and the
-- rest of the world starts: a builder's broken file does not stop the
-- server.
let _start! (o: Opts) = (
  let loaded = Mudlib.load_all! o.lib;
  List.each
    (fn (path, why) -> IO.println_err "wmd: %{path} did not load: %{why}")
    loaded.failed;
  World.World(
    World.with_pepper (Env.get! "WMD_PEPPER"),
    lib_root = o.lib,
    lib = loaded.lib,
    realms = loaded.realms,
    help = Mudlib.help! o.lib
  )
)

-- The driver sleeps until there is input or a snapshot is due, and wakes
-- on the update that queues it. While something has to tick, it sleeps no
-- longer than until the tick: the next heartbeat, `o.tick` after the start
-- of the last one, or else the soonest call-out. Only this fiber changes
-- what has a heartbeat or a call-out, so nothing moves the tick while it
-- sleeps. A tick that takes longer than `o.tick` makes the next one late:
-- ticks do not stack up.
--
-- `left` is the time to the next heartbeat. It is measured with
-- Clock.timed, because a DateTime keeps whole seconds only, and a clock
-- step would spoil two readings of Clock.now.
let _driver state (o: Opts) left = (
  let ready (w: World.World) = w.inputs != [] || World.snapshot_due? w;
  let (slept, _) =
    Clock.timed (fn () ->
      let _ =
        match World.sleep_for left (Clock.now ()) (Shared.get state) with
        | None -> Ok (Shared.wait state ready)
        | Some d -> Par.timeout d (fn () -> Shared.wait state ready)
      in
      Engine.step state);
  let after = left - slept;
  let next =
    if World.sleep_for after (Clock.now ()) (Shared.get state) == Some 0s then (
      let (took, _) = Clock.timed (fn () -> Engine.tick state (_now ()));
      o.tick - took
    )
    else after;
  if World.snapshot_due? (Shared.get state) then _snapshot state o.world;
  _driver state o next
)

let run! (o: Opts) = (
  FS.mkdir! o.logs;
  with Shared.make (_start! o) as state ->
  -- On the way out, SIGTERM included, the world is saved and the events not
  -- yet written are written. The release runs before the Shared above is
  -- closed, and after the driver loop has stopped.
  with Resource.make
    (fn () -> ())
    (fn () -> (_snapshot state o.world; Log.flush! state o.logs)) as _ -> (
    (
      match Snapshot.read! o.world with
      | Some f -> (let _ = Engine.restore state f (_now ()); ())
      | None -> ()
    );
    Engine.boot state (_now ());
    IO.println "wmd listening on %{o.port}, world in %{o.world}, logging to %{o.logs}";
    Par.all! [
      fn () -> Net.listen o.port |> Par.each_stream 256 (Session.serve state),
      fn () -> _driver state o o.tick,
      fn () -> Clock.every 60s (fn () -> Shared.update state World.snapshot_due),
      fn () -> Clock.every 1s (fn () -> Log.flush! state o.logs)
    ]
  )
)
