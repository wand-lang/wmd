uses {FS.Read, FS.Write, Random, Shared}

-- The driver proper: the one fiber that runs mudlib code.
--
-- It takes each input the sessions queued, runs the mudlib code it calls
-- for, checks the actions that come back, and applies them. Only this fiber
-- runs mudlib code or changes an object, so the world it reads cannot
-- change under it before it writes.

import ./Evaluate
import ./Files
import ./Inspiration
import ./Parse
import ./Password
import ./Scan
import ./Snapshot
import ./World
import FS
import JSON
import List

import Map

import Option
import Random
import Regex
import Result
import Shared
import Size
import String
import Wand

let Core = import ../lib/std/core

let login_id = "/std/login#0"

let player_bp = "/std/player"

-- Where a body wakes until its account has signed the current rules.
let rules_hall = "/r/rules/hall#0"

-- Where every new body first stands.
let arrival = "/r/square#0"

-- ── Changes ────────────────────────────────────────────────────────────

-- The work on one input: the world as the driver sees it so far, and every
-- change made to it, newest first. The changes are made again, in order,
-- on the shared world, where the sessions may have added lines or input in
-- the meantime: the two kinds of change do not touch the same things.
-- `hooks` is false while a hook runs, so the moves it makes call no more
-- hooks.
type Tx(
  w: World.World,
  changes: List (World.World -> World.World ! {}),
  at: String,
  hooks: Bool = true
)

-- Work that starts at `at`, the time its input arrived. The working copy
-- carries that time, for `ctx.time`.
let begin (w: World.World) at =
  Tx(
    w = World.World(w, now = Result.default 1970-01-01T00:00:00Z (String.to_datetime at)),
    changes = [],
    at = at
  )

let change f (tx: Tx) = Tx(tx, w = f tx.w, changes = f :: tx.changes)

let commit (tx: Tx) (w: World.World) = List.fold_right (fn f acc -> f acc) tx.changes w

-- Every event of one input carries the time the input arrived.
let _event (ev: World.Event) (tx: Tx) = change (World.emit World.Event(ev, at = tx.at)) tx

-- ── Running mudlib code ────────────────────────────────────────────────

-- Every mudlib call runs under this. Draws come from the driver's own
-- generator, and a seed does nothing: all mudlib calls share one generator,
-- so one file calling Random.seed would otherwise fix every die in the
-- world.
let guarded body =
  handle body () with
  | Random!int n k -> k (Random.int 0 (n - 1))
  | Random!float _ k -> k (Random.float ())
  | Random!seed _ k -> k ()

-- How much one mudlib call may do before the driver stops it, as MudOS
-- stops a "too long evaluation": steps, which bound time and the size of
-- what it builds, and how deep its calls may nest.
let limits = Wand.Limits(steps = 100000, depth = 1000)

-- A mudlib call, with a raise or a limit that ran out as an Error, so a
-- fault in one object cannot stop the driver.
let _call body =
  match Wand.limit limits (fn () -> try guarded body) with
  | Ok r -> r
  | Error why -> Error why

-- Mudlib code that gives a value and performs nothing, such as a `short`,
-- under the same limits: `fallback` when it runs out.
-- `_call`, with the steps the call took, for the event log.
let _counted body =
  match Wand.limit limits (fn () -> Wand.cost (fn () -> try guarded body)) with
  | Ok(r, steps) -> (r, steps)
  | Error why -> (Error why, limits.steps)

let _bounded fallback f =
  match Wand.limit limits f with
  | Ok v -> v
  | Error _ -> fallback

-- The longest line an object may show, and the most actions one reply may
-- ask for: an object cannot flood a session or the driver.
let max_line = 8192

let max_actions = 100

-- The most call-outs one object may have waiting.
let max_callouts = 100

-- The most an object's saved state may be, as JSON. /std/login keeps every
-- session in the middle of logging in, so it may keep more.
let max_saved bp = if bp == "/std/login" then 1048576 else 65536

-- An object that faults this many times in a row stops working, until its
-- builder fixes it with /update or /reset.
let fault_limit = 5

-- Capacity: what one builder may own at once. It stops one builder from
-- filling the world or the disk; removing things frees it.
let max_owned = 200

let max_files = 100

let max_saved_total = 1048576

-- ── Realms ─────────────────────────────────────────────────────────────

-- The path above a blueprint path, as /r/home for /r/home/ann. None above
-- the root.
let _parent path =
  let segs = String.split "/" path;
  let up = String.join "/" (List.take (List.length segs - 1) segs);
  if up == "" then None else Some up

-- Every path above `path`, nearest first: /r/home/ann, /r/home and /r for
-- /r/home/ann/den.
let _above path =
  match _parent path with
  | Some p -> p :: _above p
  | None -> []

-- A realm's rule, under the same limits as any mudlib call. A rule does not
-- leave anything to chance: each draw it makes is 0, so asking it again
-- gives the same answer, and asking changes nothing.
let _rule body =
  match Wand.limit limits (fn () ->
    try handle body () with
    | Random!int _ k -> k 0
    | Random!float _ k -> k 0.0
    | Random!seed _ k -> k ()) with
  | Ok r -> r
  | Error why -> Error why

-- What the `owner` rule of the realm whose file is `realm` says of `path`.
-- A rule that faults gives the file to the admins.
let _owner_by realm path (w: World.World) =
  match Map.get realm w.realms with
  | None -> None
  | Some r -> (
    match _rule (fn () -> r.owner path) with
    | Ok owner -> Option.map String.lower owner
    | Error _ -> None
  )

-- The realms a blueprint path is in, nearest first, up to the Commons. A
-- realm counts only when the admins own its file, so a builder cannot make
-- one in their home.
let realms_of path (w: World.World) =
  List.fold_left
    (fn chain p -> if !(Map.has? p w.realms) then chain
      else match chain with
        | [near :: _] when _owner_by near p w != None -> chain
        | _ -> p :: chain
    )
    []
    (List.reverse (_above path))

-- Who owns the file of blueprint path `path`, by account key: what the
-- nearest realm's `owner` rule says, as ann for /r/home/ann/lamp. A file in
-- no realm is the admins'.
let file_owner path (w: World.World) =
  match realms_of path w with
  | [near :: _] -> _owner_by near path w
  | [] -> None

-- The one instance of the realm whose file is `path`.
let realm_id path = "%{path}#0"

-- Whether `id` is a realm's instance, which holds the realm's verbs and is
-- no place to be.
let realm? id (w: World.World) = Map.has? (World.blueprint_of id) w.realms

-- Whether the nearest realm of the file of `id` grants `g`.
let _granted? id (g: Core.Grant) (w: World.World) =
  match realms_of (World.blueprint_of id) w with
  | [near :: _] -> (
    match Map.get near w.realms with
    | Some r -> List.any? (fn x -> x == g) r.grants
    | None -> false
  )
  | [] -> false

-- ── Ownership ──────────────────────────────────────────────────────────

-- The account key of a body, when it is one.
let _key_of body (w: World.World) =
  Option.map (fn (a: World.Account) -> String.lower a.name) (World.account_of body w)

-- Whether an owner is held to no limits: no owner, which is the driver's
-- and the admins' code, or an admin.
let _exempt? owner (w: World.World) =
  match owner with
  | None -> true
  | Some n -> (
    match World.account n w with
    | Some a -> a.role == "admin"
    | None -> false
  )

-- Who owns `id`: its owner, or, for a room not made yet, the owner of its
-- file.
let _owner id (w: World.World) =
  match World.instance id w with
  | Some i -> i.owner
  | None -> file_owner (World.blueprint_of id) w

-- Code the ownership rules do not hold to: the driver's and the admins'.
let _trusted? id (w: World.World) = _exempt? (World.owner_of id w) w

-- Whether the owner of `id` is the account of the player `p`.
let _owns? id p (w: World.World) =
  match (World.owner_of id w, _key_of p w) with
  | (Some o, Some k) -> o == k
  | _ -> false

-- ── The read-only view ─────────────────────────────────────────────────

-- The room an object is in, climbing out of whatever holds it. A room is
-- in nothing, so a room is its own.
let room_of id (w: World.World) =
  match World.env_of id w with
  | Some e -> room_of e w
  | None -> World.resolve id

let player? id = World.blueprint_of id == player_bp

let players_in room (w: World.World) = List.filter player? (World.contents room w)

-- Every body in the world, asleep or not.
let _players (w: World.World) =
  List.filter player? (List.map (fn (i: World.Instance) -> i.id) (Map.values w.instances))

-- Who may enter a new room of blueprint `path`: what its nearest realm
-- says, and everyone in a room outside every realm.
let start_allowed path (w: World.World) =
  match realms_of path w with
  | [near :: _] -> (
    match Map.get near w.realms with
    | Some r -> r.allowed
    | None -> Core.Everyone
  )
  | [] -> Core.Everyone

-- Whether `body` may go into `room`. Its owner and the admins always may.
-- Anyone else may when the room allows them and its owner has not banned
-- them. A room not made yet allows whom its realm says a new one does. Only
-- a body is kept out: anything else may go anywhere it is moved, and a body
-- may go into anything that is not a room.
let may_enter? body room (w: World.World) =
  let key = _key_of body w;
  let (allowed, owner) =
    match World.instance room w with
    | Some i -> (if i.env != None then Core.Everyone else i.allowed, i.owner)
    | None -> (let bp = World.blueprint_of room; (start_allowed bp w, file_owner bp w))
  in
  let named =
    match allowed with
    | Core.Everyone -> true
    | Core.Only names -> List.any? (fn n -> Some n == key) names
  in
  let banned =
    match (owner, key) with
    | (Some o, Some k) -> World.banned? o k w
    | _ -> false
  in
  !(player? body)
  || Option.some? key && (key == owner || _exempt? key w)
  || named && !banned

-- The version of the rules: the number after "version" on the first line
-- of the rules help topic, as 3 in "The rules of WMD, version 3.", and 1
-- when there is none.
let rules_version (w: World.World) = (
  let first =
    Option.default
      ""
      (Option.and_then (fn t -> List.head (String.lines t)) (Map.get "rules" w.help));
  match Regex.capture r/version (\d+)/ first with
  | [_, n] -> Result.default 1 (String.to_int n)
  | _ -> 1
)

-- Whether the account of `body` has signed the current rules. What the
-- driver made, with no account, has nothing to sign.
let signed? body (w: World.World) =
  match World.account_of body w with
  | Some a -> (
    match a.rules with
    | Some s -> s.version >= rules_version w
    | None -> false
  )
  | None -> true

-- Where a body goes home to: its account's home, or the arrival room when
-- it has none or its home has closed to it.
let home_of body (w: World.World) =
  match World.account_of body w with
  | Some a -> (
    match a.home with
    | Some h when may_enter? body h w -> h
    | _ -> arrival
  )
  | None -> arrival

-- The world as `viewer` sees it now. Each function answers from this one
-- moment.
let view (w: World.World) viewer =
  Core.World(
    contents = fn id -> World.contents id w,
    env_of = fn id -> World.env_of id w,
    short_of = fn id -> _text w viewer id true,
    long_of = fn id -> _text w viewer id false,
    exits_of = fn id -> match World.instance id w with
      | Some i -> i.object.exits
      | None -> Map.empty,
    player? = player?,
    players = fn () -> _players w,
    account? = fn name -> Option.some? (World.account name w),
    detail_of = fn id name -> match World.instance id w with
      | Some i when i.held -> None
      | Some i ->
        _bounded None (fn () -> Option.map (fn f -> f (_seen w viewer i.id)) (Map.get (String.lower name) i.object.details))
      | None -> None,
    prop = fn id key -> match World.instance id w with
      | Some i -> _bounded None (fn () -> Option.and_then (fn f -> Map.get key (f (_seen w viewer i.id))) i.object.props)
      | None -> None,
    awake? = fn id -> Option.some? (World.session_of id w),
    home_of = fn id -> home_of id w,
    may_enter? = fn b r -> may_enter? b (World.resolve r) w,
    help_of = fn topic -> Map.get topic w.help
  )
-- The context of an object being looked at by `viewer`.
and _seen (w: World.World) viewer id =
  Core.Context(self = id, actor = viewer, here = room_of id w, world = view w viewer, time = w.now)
and _text (w: World.World) viewer id short =
  match World.instance id w with
  | None -> "nothing"
  | Some i when i.held -> "something waiting for an admin"
  | Some i ->
    _bounded
      "something that is not working"
      (fn () -> if short then i.object.short (_seen w viewer i.id) else i.object.long (_seen w viewer i.id))

let short_of id (w: World.World) = _text w id id true

let ctx_for (w: World.World) self actor =
  Core.Context(
    self = World.resolve self,
    actor = actor,
    here = room_of actor w,
    world = view w actor,
    time = w.now
  )

-- ── The action policy ──────────────────────────────────────────────────

-- An object may move itself, the player whose command it is running, or
-- something it holds. It may reach a thing, not a player, that the player
-- holds or that is in its room.
let _may_move? (ctx: Core.Context) obj (w: World.World) =
  let env = World.env_of obj w;
  obj == ctx.self
  || obj == ctx.actor
  || env == Some ctx.self
  || !(player? obj) && (env == Some ctx.actor || env == Some (room_of ctx.self w))

-- Whether `ctx.self` is the admins' code, or its owner owns `obj` too.
let _same_owner? (ctx: Core.Context) obj (w: World.World) =
  _trusted? ctx.self w
  || Option.some? (World.owner_of ctx.self w)
  && World.owner_of ctx.self w == World.owner_of obj w

let _locked? obj (w: World.World) =
  match World.instance obj w with
  | Some i -> i.locked
  | None -> false

let _from_login? (ctx: Core.Context) = World.blueprint_of ctx.self == "/std/login"

let editor_bp = "/r/editor/room"

-- Whether a source claims Core.Blueprint, as the files the driver loads do.
-- A helper, such as std/text.wand, is saved and not loaded.
let _blueprint? source =
  List.any? (String.starts_with? "implement Core.Blueprint") (String.lines source)

let _editor? id = World.blueprint_of id == editor_bp

let _broken? id (w: World.World) =
  match World.instance id w with
  | Some i -> i.faults >= fault_limit
  | None -> false

-- A line too long to show.
let _too_long text =
  if String.length text > max_line then
    Error "a line of %{String.length text} characters, and the most is %{max_line}"
  else Ok()

-- Whether the player `body` may edit the file of blueprint path `path`: an
-- admin may edit any file, and a builder the files they own.
let may_edit? body path (w: World.World) =
  match World.account_of body w with
  | Some a ->
    Files.valid? path
    && (a.role == "admin" || file_owner path w == Some (String.lower a.name))
  | None -> false

-- Only an object of a realm that grants MayCheckSave may check or save a
-- file, and only one its actor may edit.
let _may_file (ctx: Core.Context) path (w: World.World) =
  if !(_granted? ctx.self Core.MayCheckSave w) then
    Error "only the editor may check or save a file"
  else if !(may_edit? ctx.actor path w) then Error "%{ctx.actor} may not edit %{path}"
  else Ok()

-- A player is told things by their own commands, by what is in the room
-- with them, and by what their own account owns. A player's own body may
-- tell anyone, as a page does.
let _may_tell? (ctx: Core.Context) target (w: World.World) =
  target == ctx.actor
  || ctx.self == ctx.actor
  || room_of target w == room_of ctx.self w
  || _trusted? ctx.self w
  || _owns? ctx.self target w

-- An object makes things in itself, in what it holds, on the player whose
-- command it runs, in the room it is in, or in a place its owner owns.
let _may_spawn_in? (ctx: Core.Context) dest (w: World.World) =
  dest == ctx.self
  || dest == ctx.actor
  || World.env_of dest w == Some ctx.self
  || dest == room_of ctx.self w
  || _trusted? ctx.self w
  || Option.some? (World.owner_of ctx.self w) && _owner dest w == World.owner_of ctx.self w

-- The driver's own policy on action `a`, which every realm's rules come
-- after.
let _policy (ctx: Core.Context) (a: Core.Action) (w: World.World) =
  match a with
  | Core.Say text -> _too_long text
  | Core.Tell target text -> if World.session? target then
      if _from_login? ctx then _too_long text else Error "only /std/login may tell a session"
    else if !(_may_tell? ctx (World.resolve target) w) then
      Error "may not tell %{target}: they are not here"
    else _too_long text
  | Core.Move obj dest -> (
    let o = World.resolve obj;
    let d = World.resolve dest;
    if World.session? dest then Error "may not move %{o} into a session"
    else if !(_may_move? ctx o w) then Error "may not move %{o}"
    -- A player moves by their own command, or by what their own account
    -- or an admin owns: a room cannot carry off whoever is in it.
    else if player? o && o != ctx.actor && o != ctx.self && !(_trusted? ctx.self w || _owns? ctx.self o w) then
      Error "may not move %{o}: a player moves by their own command"
    -- Only what its owner owns moves a locked thing.
    else if !(player? o) && o != ctx.self && _locked? o w && !(_same_owner? ctx o w) then
      Error "may not move %{o}: it is locked"
    else if realm? d w then Error "may not move %{o} into %{d}: a realm is no place"
    else if !(may_enter? o d w) then Error "may not move %{o} into %{d}: it is private"
    -- An editor is private to the one it was opened for.
    else if _editor? d && Option.and_then (fn (i: World.Instance) -> i.creator) (World.instance d w) != Some o then
      Error "may not move %{o} into %{d}"
    else Ok()
  )
  | Core.Spawn bp dest -> (
    let d = World.resolve dest;
    if bp == player_bp || bp == "/std/login" then Error "may not spawn %{bp}"
    else if Map.has? bp w.realms then Error "may not spawn %{bp}: it is a realm"
    else if realm? d w then Error "may not spawn into %{d}: a realm is no place"
    else if !(_may_spawn_in? ctx d w) then
      Error "may not spawn into %{d}: it is not here, and not its owner's"
    else Ok()
  )
  | Core.Login _ _ _ -> if _from_login? ctx then Ok()
    else Error "only /std/login may log in"
  | Core.Register _ _ _ -> if _from_login? ctx then Ok()
    else Error "only /std/login may register"
  | Core.Hangup _ -> if _from_login? ctx then Ok() else Error "only /std/login may hang up"
  | Core.Remove obj -> (
    let o = World.resolve obj;
    if !(o == ctx.self || World.env_of o w == Some ctx.self) then Error "may not remove %{o}"
    else if o != ctx.self && !(_same_owner? ctx o w) then
      Error "may not remove %{o}: its owner is not this object's"
    else if player? o || List.any? player? (World.contents o w) then
      Error "may not remove %{o}: a player is or is in it"
    else Ok()
  )
  | Core.Check path _ -> _may_file ctx path w
  | Core.Save path _ -> _may_file ctx path w
  | Core.Draft path _ -> _may_file ctx path w
  | Core.Run _ -> if _granted? ctx.self Core.MayCheckSave w then Ok()
    else Error "only the editor may run source"
  | Core.Acknowledge body -> if _granted? ctx.self Core.MayAcknowledge w && body == ctx.actor then Ok()
    else Error "only the Rules Hall may say the rules were signed"
  | Core.After _ _ -> (
    let n = List.length (World.callouts_of ctx.self w);
    if n >= max_callouts then Error "%{n} call-outs waiting, and the most is %{max_callouts}"
    else Ok()
  )

-- What `rule` says of each realm `room` is in, nearest first, given the
-- realm's path and module: the first refusal, or Ok when every realm
-- allows. A rule that faults refuses.
let _realms_say room rule (w: World.World) =
  List.fold_left
    (fn acc p -> match (acc, Map.get p w.realms) with
      | (Ok _, Some r) -> (
        match _rule (fn () -> rule p r) with
        | Ok said -> said
        | Error _ -> Error "the rules of %{p} are not working"
      )
      | _ -> acc
    )
    Ok()
    (realms_of (World.blueprint_of room) w)

-- Whether `ctx.self` may ask for action `a`, and why not: the driver's
-- policy first, then the `allows` rule of every realm the object's room is
-- in. Every rule on what mudlib code may do is here, in one place.
let allowed (ctx: Core.Context) (a: Core.Action) (w: World.World) =
  match _policy ctx a w with
  | Error why -> Error why
  | Ok _ -> _realms_say (room_of ctx.self w) (fn _ (r: Core.Realm) -> r.allows ctx a) w

-- Whether `body` may use the command `verb` where it is, and why not.
-- /quit always works.
let _command_ok body verb (w: World.World) =
  let here = room_of body w;
  if verb == "/quit" then Ok()
  else
    _realms_say
      here
      (fn p (r: Core.Realm) -> r.commands (ctx_for w (realm_id p) body) verb)
      w

-- ── Capacity and Inspiration ───────────────────────────────────────────

-- Who pays for action `a`: the builder at the editor for a file or a run,
-- and otherwise the owner of the object that asks for it.
let _payer (ctx: Core.Context) (a: Core.Action) (w: World.World) =
  match a with
  | Core.Check _ _ -> _key_of ctx.actor w
  | Core.Save _ _ -> _key_of ctx.actor w
  | Core.Draft _ _ -> _key_of ctx.actor w
  | Core.Run _ -> _key_of ctx.actor w
  | _ -> World.owner_of ctx.self w

-- What action `a` costs in Inspiration, and what to call it in the log. A
-- run is charged by the steps it took, after it runs.
let _price (a: Core.Action) =
  match a with
  | Core.Spawn _ _ -> (Inspiration.spawn_cost, "spawn")
  | Core.Check _ _ -> (Inspiration.build_cost, "check")
  | Core.Save _ _ -> (Inspiration.build_cost, "save")
  | _ -> (0, "")

let _size bytes = Size.format (Size.of_bytes bytes)

-- Whether a new file fits the Capacity of `owner`.
-- How many mudlib files the account `key` owns, by the owner rules.
let file_count key (w: World.World) =
  List.length
    (List.filter
      (fn f -> file_owner (Scan.path_in w.lib_root f) w == Some key)
      (Scan.files w.lib_root))

let _file_room owner path (w: World.World) =
  let n = file_count owner w;
  if Files.exists? w.lib_root path || n < max_files then Ok()
  else
    Error "You have %{n} files, and the most is %{max_files}. Remove one to make another."

-- Whether action `a` fits the Capacity of `owner`.
let _capacity owner (a: Core.Action) (w: World.World) =
  match a with
  | Core.Spawn _ _ -> (
    let n = List.length (World.owned owner w);
    let bytes = World.saved_bytes owner w;
    if n >= max_owned then
      Error "You own %{n} objects, and the most is %{max_owned}. Remove some to make more."
    else if bytes >= max_saved_total then
      Error
        "Your objects keep %{_size bytes} of saved state, and the most is %{_size max_saved_total}."
    else Ok()
  )
  | Core.Save path _ -> _file_room owner path w
  | Core.Draft path _ -> _file_room owner path w
  | _ -> Ok()

-- Whether the account `owner` has `cost` Inspiration now, and when it
-- will if not.
let _inspired owner cost (w: World.World) =
  match World.account owner w with
  | None -> Error "There is no account %{owner} to pay for that."
  | Some acct -> (
    let i = acct.inspiration;
    let have = Inspiration.amount w.now i;
    if have >= cost then Ok()
    else
      Error
        "That needs %{cost} Inspiration, and you have %{have}. You will have enough in %{Inspiration.wait_text (Inspiration.wait w.now cost i)}."
  )

-- Whether `payer` may pay for action `a`, and what it costs them.
let budget payer (a: Core.Action) (w: World.World) = (
  let (cost, _) = _price a;
  match payer with
  | Some p when !(_exempt? payer w) -> (
    match _capacity p a w with
    | Error why -> Error why
    | Ok _ -> Result.map (fn _ -> cost) (_inspired p cost w)
  )
  | _ -> Ok 0
)

-- Spend `cost` of the Inspiration of `payer`.
let _spend payer cost (tx: Tx) =
  match payer with
  | Some p when cost > 0 && !(_exempt? payer tx.w) ->
    change (World.spend p cost tx.w.now) tx
  | _ -> tx

-- Spend `cost` of the Inspiration of `payer` on `what`, and log it.
let _charge payer cost what (tx: Tx) =
  match payer with
  | Some p when cost > 0 && !(_exempt? payer tx.w) ->
    tx
    |> _spend payer cost
    |> _event World.Event(
      at = "",
      event = "inspiration",
      actor = p,
      text = Some "%{cost} for %{what}"
    )
  | _ -> tx

-- Tell the player whose command it is why it was refused, when it was
-- theirs to pay for.
let _tell_payer (ctx: Core.Context) payer why (tx: Tx) =
  if Option.some? payer && _key_of ctx.actor tx.w == payer then
    change (World.tell ctx.actor why) tx
  else tx

-- A driver command that costs `cost`: run `k` when the account of `body`
-- can pay, and charge it.
let _pay body cost what k (tx: Tx) = (
  let payer = _key_of body tx.w;
  match payer with
  | Some p when !(_exempt? payer tx.w) -> (
    match _inspired p cost tx.w with
    | Error why -> change (World.tell body why) tx
    | Ok _ -> k (_charge payer cost what tx)
  )
  | _ -> k tx
)

let _fits? (arg: Core.Arg) (f: Parse.Found) holder =
  match arg with
  | Core.NoArg -> true
  | Core.This -> Parse.found? holder f
  | Core.AnyObj -> Option.some? (Parse.found_id f)

-- The first verb that answers: on the player, then the room, then the
-- direct object, then the indirect one, then each realm the room is in,
-- nearest first, up to the Commons.
let _find (w: World.World) holders verb dobj iobj =
  List.head
    (List.filter_map
      (fn h -> match World.instance h w with
        | None -> None
        | Some i ->
          Option.map
            (fn v -> (h, v))
            (List.find
              (fn (v: Core.Verb) -> List.any? (fn n -> n == verb) v.names
              && _fits? v.dobj dobj h
              && _fits? v.iobj iobj h)
              i.object.verbs)
      )
      holders)

-- Whose verbs a command of `body` in `here` may run, in the order they are
-- asked: the body, the room, the objects the command names, then each
-- realm the room is in.
let _holders body here named (w: World.World) =
  List.unique
    (List.flatten [
      [body, here],
      named,
      List.map realm_id (realms_of (World.blueprint_of here) w)
    ])

-- ── Spawning ───────────────────────────────────────────────────────────

-- Make instance `id` of blueprint `bp` inside `dest`, owned by `owner`, and
-- apply the actions its `create` asks for. Nothing happens for a blueprint
-- that is not in the lib, or a create that raises; the event log says
-- which.
let _create id bp saved dest owner (tx: Tx) =
  match Map.get bp tx.w.lib with
  | None -> _event (World.Event(at = "", event = "refused", actor = id, text = Some "no blueprint %{bp}")) tx
  | Some b -> (
    match _call (fn () -> b.create id saved) with
    | Error why -> _event (World.Event(at = "", event = "fault", actor = id, text = Some why)) tx
    | Ok init ->
      tx
      |> change
        (World.put
          (World.Instance(
            id = id,
            blueprint = bp,
            object = init.object,
            env = dest,
            created = Some tx.at,
            owner = owner,
            -- A room starts open to whom its realm says.
            allowed = start_allowed bp tx.w
          )))
      |> _apply_actions (ctx_for tx.w id id) init.actions
  )

-- Make sure `id` exists: a room named by an exit is spawned the first time
-- someone goes there. It is owned by the owner of its file.
and _ensure id (tx: Tx) =
  let full = World.resolve id;
  if Option.some? (World.instance full tx.w) then tx
  else _create full (World.blueprint_of full) None None (file_owner (World.blueprint_of full) tx.w) tx

-- A new instance of `bp` in `dest`, made by `actor`'s command and owned by
-- `owner`.
and spawn bp dest actor owner (tx: Tx) =
  let id = "%{bp}#%{World.next_number bp tx.w}";
  tx
  |> _ensure dest
  |> _create id bp None (Some (World.resolve dest)) owner
  |> change (fn w -> World.set_made id (Some actor) (Some tx.at) None w)
  |> _event (World.Event(at = "", event = "spawn", actor = actor, object = Some id))
  |> _hook "enter" dest id actor

-- ── Hooks ──────────────────────────────────────────────────────────────

-- Call `container`'s on_enter or on_leave for `mover`. The hook's own
-- moves call no hooks.
and _hook which container mover actor (tx: Tx) =
  match (tx.hooks, World.instance container tx.w) with
  | (true, Some i) -> (
    let f = if which == "enter" then i.object.on_enter else i.object.on_leave;
    match f with
    | None -> tx
    | Some h -> (
      let ctx = ctx_for tx.w i.id actor;
      Tx(run ctx (fn () -> h ctx mover) Tx(tx, hooks = false), hooks = true)
    )
  )
  | _ -> tx

-- ── Actions ────────────────────────────────────────────────────────────

and _refuse (ctx: Core.Context) why (tx: Tx) =
  _event (World.Event(at = "", event = "refused", actor = ctx.self, text = Some why)) tx

and _say (ctx: Core.Context) text (tx: Tx) =
  List.fold_left
    (fn acc p -> change (World.tell p text) acc)
    tx
    (players_in (room_of ctx.self tx.w) tx.w)

-- Move `obj` into `dest`. A player who moves looks around, and then the
-- place left and the place entered hear of it.
and _move (ctx: Core.Context) obj dest (tx: Tx) =
  let from = World.env_of obj tx.w;
  let ensured = _ensure dest tx;
  -- A room that is gone, or cannot be made, is no place to go: a body goes
  -- home instead, and anything else stays where it is.
  let target =
    if Option.some? (World.instance dest ensured.w) then Some dest
    else if player? obj then Some (home_of obj ensured.w)
    else None;
  let moved =
    match target with
    | Some t -> ensured |> _ensure t |> change (World.move obj t)
    | None -> ensured;
  let looked = if player? obj then look obj moved else moved;
  let explored =
    match target with
    | Some t when player? obj -> _explore obj (World.resolve t) looked
    | _ -> looked;
  let left =
    match from with
    | Some f -> _hook "leave" f obj ctx.actor explored
    | None -> explored;
  match target with
  | Some t -> _hook "enter" (World.resolve t) obj ctx.actor left
  | None -> left

-- The first visit of a body to a public room another builder owns gives its
-- account an exploring bonus, up to `Inspiration.bonuses_a_day` rooms a
-- day.
and _explore body room (tx: Tx) =
  match (World.account_of body tx.w, World.owner_of room tx.w) with
  | (Some a, Some o) when World.env_of room tx.w == None
    && Option.map World.public? (World.instance room tx.w) == Some true
    && o != String.lower a.name
    && !(Map.has? room a.explored)
    && Inspiration.today tx.w.now a.explored < Inspiration.bonuses_a_day ->
    tx
    |> change (World.inspire a.name room tx.w.now)
    |> _event World.Event(at = "", event = "inspired", actor = body, room = Some room)
    |> change (World.tell body "You feel inspired.")
  | _ -> tx

-- Check action `a` against the policy, then against the Capacity and
-- Inspiration of whoever pays for it, and do it.
and _act (ctx: Core.Context) (a: Core.Action) (tx: Tx) =
  match allowed ctx a tx.w with
  | Error why -> _refuse ctx why tx
  | Ok _ -> (
    let payer = _payer ctx a tx.w;
    match budget payer a tx.w with
    | Error why -> _short ctx a why (_refuse ctx why tx)
    | Ok cost -> (let (_, what) = _price a; _do ctx payer a (_charge payer cost what tx))
  )

-- Tell why an action was more than its payer had: the editor, through its
-- `result` verb, for a file, and otherwise the player who paid.
and _short (ctx: Core.Context) (a: Core.Action) why (tx: Tx) =
  let failed action path =
    Core.Outcome(
      action = action,
      path = path,
      ok = false,
      problems = [Core.Problem(severity = "error", line = 1, col = 1, message = why)]
    );
  match a with
  | Core.Check path _ -> _answer ctx (failed "check" path) tx
  | Core.Save path _ -> _answer ctx (failed "save" path) tx
  | Core.Draft path _ -> _answer ctx (failed "draft" path) tx
  | _ -> _tell_payer ctx (_payer ctx a tx.w) why tx

and _do (ctx: Core.Context) payer (a: Core.Action) (tx: Tx) =
  match a with
  | Core.Say text -> _say ctx text tx
  | Core.Tell target text -> change (World.tell target text) tx
  | Core.Move obj dest -> _move ctx (World.resolve obj) dest tx
  | Core.Spawn bp dest -> spawn bp dest ctx.actor payer tx
  | Core.Login sid name typed -> login sid name typed tx
  | Core.Register sid name typed -> register sid name typed tx
  | Core.Hangup sid -> change (World.close_soon sid) tx
  | Core.Remove obj ->
    tx
    |> change (World.remove obj)
    |> _event (World.Event(at = "", event = "remove", actor = ctx.actor, object = Some (World.resolve obj)))
  | Core.Check path source -> _answer ctx (Files.check tx.w.lib_root path source) tx
  | Core.Save path source -> _save ctx path source tx
  | Core.Draft path source -> _answer ctx (Files.draft tx.w.lib_root path source) tx
  | Core.Run source -> eval ctx.actor source tx
  | Core.Acknowledge body -> _signed body tx
  | Core.After wait name -> change (World.call_out ctx.self (tx.w.now + wait) name) tx

-- Save, and write the list of blueprints again, so a new one loads at
-- the next start.
-- A save that passes loads the new code at once, as /update does.
and _save (ctx: Core.Context) path source (tx: Tx) =
  let o = Files.save tx.w.lib_root path source;
  let answered = _answer ctx o tx;
  if o.ok && _blueprint? source then update ctx.actor path answered else answered

-- Load the file of `path` again, and move every instance of it onto the
-- new code: the old `save` gives each one's state, and the new `create`
-- takes it. An instance whose state the new code cannot read stays on the
-- old code and is named. A file that does not load changes nothing.
and update actor path (tx: Tx) =
  match Wand.load Core.Blueprint.loader (Files.file_of tx.w.lib_root path) with
  | Error why ->
    tx
    |> _event (World.Event(at = "", event = "update_refused", actor = actor, object = Some path, text = Some why))
    |> change (World.tell actor "%{path} was not updated: %{why}")
  | Ok b -> (
    let before = if path == editor_bp then Map.get path tx.w.lib else tx.w.editor_before;
    let tx = change (fn w -> World.World(w, editor_before = before)) tx;
    let (moved, kept) =
      List.fold_left
        (fn (acc, kept) id -> match World.instance id acc.w with
          | None -> (acc, kept)
          | Some i -> (
            match _call (fn () -> b.create id (Some (i.object.save ()))) with
            | Ok init -> (change (World.set_object id init.object tx.at) acc, kept)
            | Error _ -> (acc, List.concat kept [id])
          ))
        (change (World.set_blueprint path b) tx, [])
        (World.instances_of path tx.w);
    let n = List.length (World.instances_of path tx.w) - List.length kept;
    let told =
      if kept == [] then "Updated %{path}: %{n} instances on the new code."
      else "Updated %{path}: %{n} instances on the new code. Kept on the old code, because the new code cannot read their saved state: %{String.join ", " kept}. Fix the file and /update it again, or /reset them.";
    moved
    |> _event (World.Event(at = "", event = "update", actor = actor, object = Some path, text = Some "%{n} moved, %{List.length kept} kept"))
    |> change (World.tell actor told)
    |> _update_realm actor path
  )

-- A file that is a realm too: load its rules again, and make its instance
-- when the realm is new. Rules that do not load leave the old ones. A file
-- that no longer claims Core.Realm is a realm no more.
and _update_realm actor path (tx: Tx) =
  if !(Scan.claims? "Realm" (Option.default "" (Files.read tx.w.lib_root path))) then
    change (fn w -> World.World(w, realms = Map.delete path w.realms)) tx
  else match Wand.load Core.Realm.loader (Files.file_of tx.w.lib_root path) with
    | Error why -> change (World.tell actor "The rules of %{path} were not updated: %{why}") tx
    | Ok r -> tx |> change (World.set_realm path r) |> _ensure (realm_id path)

-- Make instances again as `create` makes a new one, and apply its starting
-- actions again. Each keeps its id, its place and who made it. A body
-- keeps its name, which is its account's. Its call-outs are dropped: the
-- starting actions make again the ones a new instance has.
and reset actor ids (tx: Tx) =
  List.fold_left
    (fn acc id -> match World.instance id acc.w with
      | None -> acc
      | Some i -> (
        match Map.get i.blueprint acc.w.lib with
        | None -> change (World.tell actor "%{id} has no blueprint loaded.") acc
        | Some b -> (
          let saved =
            match World.account_of id acc.w with
            | Some a -> Some (JSON.of_map (Map.from_list [("name", JSON.of_string a.name)]))
            | None -> None;
          match _call (fn () -> b.create id saved) with
          | Error why -> change (World.tell actor "%{id} was not reset: %{why}") acc
          | Ok init ->
            acc
            |> change (World.set_object id init.object tx.at)
            |> change (World.drop_callouts id)
            |> _apply_actions (ctx_for acc.w id id) init.actions
            |> _event (World.Event(at = "", event = "reset", actor = actor, object = Some id))
            |> change (World.tell actor "Reset %{id}.")
        )
      ))
    tx
    ids

-- /eval: run `expr` for `body`, as mudlib code runs: checked, gated, and
-- under the limits. A list of actions is checked and applied as the
-- body's own; any other value is shown with its type. It costs the steps
-- it took, so it needs some Inspiration left to start.
and eval body expr (tx: Tx) =
  let payer = _key_of body tx.w;
  let ready = if _exempt? payer tx.w then Ok() else _inspired (Option.default "" payer) 1 tx.w;
  match ready with
  | Error why -> change (World.tell body why) tx
  | Ok _ -> _eval body payer expr tx

and _eval body payer expr (tx: Tx) =
  match Evaluate.load tx.w.lib_root expr with
  | Error errors ->
    tx
    |> _event (World.Event(at = "", event = "eval_refused", actor = body, text = Some expr))
    |> change (World.tell body (String.join "\n" errors))
  | Ok m -> (
    let ctx = ctx_for tx.w body body;
    let (r, steps) = _counted (fn () -> m.evaluate ctx);
    let logged =
      _event (World.Event(at = "", event = "eval", actor = body, text = Some "%{expr} (%{steps} steps)")) tx
      |> _charge payer (Inspiration.of_steps steps) "eval";
    match r with
    | Error why -> change (World.tell body "Something went wrong: %{why}") logged
    | Ok (Core.Shown text) -> change (World.tell body "=> %{text}") logged
    | Ok (Core.Acts actions) ->
      logged
      |> apply ctx (Core.Reply(actions = actions))
      |> change (World.tell body "=> %{List.length actions} actions")
  )

-- Log the driver's answer to a check or a save, with the errors or the
-- effects, and give it to the editor through its `result` verb.
and _answer (ctx: Core.Context) (o: Core.Outcome) (tx: Tx) =
  let errors =
    List.map
      (fn (p: Core.Problem) -> "%{p.line}:%{p.col}: %{p.message}")
      (List.filter (fn (p: Core.Problem) -> p.severity == "error") o.problems);
  let found =
    if o.ok then "effects: %{if o.effects == [] then "none" else String.join ", " o.effects}"
    else String.join "; " errors;
  tx
  |> _event
    (World.Event(
      at = "",
      event = if o.ok then o.action else "%{o.action}_refused",
      actor = ctx.actor,
      object = Some o.path,
      text = Some found
    ))
  |> verb_with ctx.self ctx.actor (Core.Parsed(verb = "result", rest = JSON.stringify (Core.Outcome.encoder o)))

and _apply_actions (ctx: Core.Context) actions (tx: Tx) =
  List.fold_left (fn acc a -> _act ctx a acc) tx actions

-- Apply what a call on `ctx.self` gave back. A reply with more actions
-- than `max_actions` is refused whole: its object keeps its old version.
and apply (ctx: Core.Context) (r: Core.Reply) (tx: Tx) =
  if List.length r.actions > max_actions then
    _refuse ctx "%{List.length r.actions} actions in one reply, and the most is %{max_actions}" tx
  else _apply ctx r tx

and _apply (ctx: Core.Context) (r: Core.Reply) (tx: Tx) = (
  let kept =
    match r.next with
    | Some o -> change (World.set_object ctx.self o tx.at) tx
    | None -> tx;
  _apply_actions ctx r.actions kept
)

-- Run a reply-giving mudlib call, and apply its reply. A raise is a fault:
-- the actor is told, and the event log keeps why.
-- An object that has faulted `fault_limit` times in a row runs no more
-- code until /update or /reset gives it a new start.
and run (ctx: Core.Context) body (tx: Tx) = (let (ran, _) = run_counted ctx body tx; ran)

-- `run`, with the steps the call took.
and run_counted (ctx: Core.Context) body (tx: Tx) =
  if _broken? ctx.self tx.w then
    (change (World.tell ctx.actor "%{short_of ctx.self tx.w} is not working.") tx, 0)
  else if Option.map (fn (i: World.Instance) -> i.held) (World.instance ctx.self tx.w) == Some true then
    (change (World.tell ctx.actor "That is waiting for an admin.") tx, 0)
  else match _counted body with
    | (Ok r, steps) -> (tx |> change (World.worked ctx.self) |> apply ctx r, steps)
    | (Error why, steps) -> (
      let faulted =
        tx
        |> change (World.tell ctx.actor "Something went wrong with %{short_of ctx.self tx.w}.")
        |> _event (World.Event(at = "", event = "fault", actor = ctx.actor, object = Some ctx.self, text = Some why))
        |> change (World.faulted ctx.self);
      let broken =
        if _broken? ctx.self faulted.w then
          faulted
          |> _event (World.Event(at = "", event = "broken", actor = ctx.actor, object = Some ctx.self))
          |> change (World.tell ctx.actor "%{short_of ctx.self tx.w} has stopped working. Its builder can fix it and /update it, or /reset it.")
        else faulted;
      (_fall_back ctx.self ctx.actor broken, steps)
    )

-- An editor that faults goes back to the editor before the last /update
-- of it, so a bad update of the editor can be fixed with the editor.
and _fall_back self actor (tx: Tx) =
  match (_editor? self, tx.w.editor_before, World.instance self tx.w) with
  | (true, Some b, Some i) -> (
    match _call (fn () -> b.create i.id (Some (i.object.save ()))) with
    | Ok init ->
      tx
      |> change (World.set_blueprint editor_bp b)
      |> change (World.set_object i.id init.object tx.at)
      |> change (World.tell actor "The editor is back on its version from before the last /update of it.")
    | Error _ -> tx
  )
  | _ -> tx

-- Run the verb named `name` on `self`, with no arguments.
and verb self actor name (tx: Tx) = verb_with self actor (Core.Parsed(verb = name)) tx

-- Run the verb `p.verb` on `self`, with `p` as its command.
and verb_with self actor (p: Core.Parsed) (tx: Tx) =
  match World.instance self tx.w with
  | None -> tx
  | Some i -> (
    match List.find (fn (v: Core.Verb) -> List.any? (fn n -> n == p.verb) v.names) i.object.verbs with
    | None -> tx
    | Some v -> (
      let ctx = ctx_for tx.w i.id actor;
      run ctx (fn () -> v.run ctx p) tx
    )
  )

-- `look`, for a body that moved: the first `look` its holders answer to,
-- as when the player types it.
and look body (tx: Tx) =
  let here = room_of body tx.w;
  match _find tx.w (_holders body here [] tx.w) "look" Parse.NoWords Parse.NoWords with
  | Some(h, v) -> (
    let ctx = ctx_for tx.w h body;
    run ctx (fn () -> v.run ctx (Core.Parsed(verb = "look"))) tx
  )
  | None -> tx

-- ── Login ──────────────────────────────────────────────────────────────

-- Attach a session to the body of `name`, making the account and its body
-- the first time.
-- Log a session in, when the password is the account's. A wrong one is
-- logged, with the name tried and never the password.
and login sid name typed (tx: Tx) =
  match World.account name tx.w with
  | Some acct when Password.matches? tx.w.pepper acct.password typed ->
    if acct.paused then
      tx
      |> _event (World.Event(at = "", event = "login_paused", actor = sid, name = Some acct.name))
      |> change (World.tell sid "An admin has paused %{acct.name}. What is your name?")
    else if Option.some? (World.session_of acct.body tx.w) then
      change (World.tell sid "%{acct.name} is here already. What is your name?") tx
    else _wake sid acct.name acct.body "%{acct.name} wakes up." tx
  | _ ->
    tx
    |> _event (World.Event(at = "", event = "login_failed", actor = sid, name = Some name))
    |> change (World.tell sid "That name and password do not match. What is your name?")

-- Make an account and its body. The password is kept only as its hash,
-- with a salt made for it and the server's pepper.
and register sid name typed (tx: Tx) =
  if Option.some? (World.account name tx.w) then
    change (World.tell sid "%{name} was taken just now. What is your name?") tx
  else (
    let body = "%{player_bp}#%{World.next_number player_bp tx.w}";
    let saved = JSON.of_map (Map.from_list [("name", JSON.of_string name)]);
    let hashed = Password.hash tx.w.pepper (Random.hex 32) typed;
    tx
    |> _ensure rules_hall
    |> _create body player_bp (Some saved) (Some rules_hall) (Some (String.lower name))
    |> change (World.add_account (World.Account(name = name, body = body, password = hashed)))
    |> _hook "enter" rules_hall body body
    |> _event (World.Event(at = "", event = "signup", actor = sid, name = Some name, object = Some body))
    |> _wake sid name body "%{name} arrives."
  )

-- Attach a session to its body. A body whose account has not signed the
-- current rules wakes in the Rules Hall, and notices kept while it slept
-- are told.
and _wake sid name body news (tx: Tx) =
  let (woke: Tx) =
    tx
    |> change (World.attach sid body)
    |> verb login_id sid "done"
    |> _event (World.Event(at = "", event = "login", actor = sid, name = Some name, object = Some body))
    |> change (World.tell body "Hello, %{name}.")
    |> _to_hall body;
  woke |> _tell_room (room_of body woke.w) body news |> _tell_notices body |> look body

and _to_hall body (tx: Tx) =
  if signed? body tx.w || room_of body tx.w == rules_hall then tx
  else tx |> _ensure rules_hall |> change (World.move body rules_hall)

and _tell_notices body (tx: Tx) =
  match World.account_of body tx.w with
  | Some a when a.notices != [] ->
    tx |> change (World.tell body (String.join "\n" a.notices)) |> change (World.noticed a.name)
  | _ -> tx

-- A body signed the current rules: keep that on its account, and take the
-- body to the Commons, which hears it arrive.
and _signed body (tx: Tx) =
  match World.account_of body tx.w with
  | None -> tx
  | Some a ->
    tx
    |> change (World.sign a.name (rules_version tx.w) tx.w.now)
    |> _event World.Event(at = "", event = "signed", actor = body, text = Some "version %{rules_version tx.w}")
    |> _tell_room arrival body "%{short_of body tx.w} arrives."
    |> _move (ctx_for tx.w body body) body arrival

and _tell_room room except text (tx: Tx) =
  List.fold_left
    (fn acc p -> if p == except then acc else change (World.tell p text) acc)
    tx
    (players_in room tx.w)

-- ── Commands ───────────────────────────────────────────────────────────

-- `"Hello.` is `say Hello.`, `:sits.` is `pose sits.`, and `;'s cat
-- purrs.` is `semipose 's cat purrs.`. The driver rewrites the prefix and
-- nothing else; the commands are the player's verbs.
let _expand line =
  let rest = String.slice 1 (String.length line) line;
  if String.starts_with? `"` line then "say %{rest}"
  else if String.starts_with? ":" line then "pose %{rest}"
  else if String.starts_with? ";" line then "semipose %{rest}"
  else line

-- Why nothing answered, in words the player can act on.
let _unmatched (w: World.World) verb (dobj: Parse.Found) =
  match dobj with
  | Parse.Missing words -> "You don't see a '%{words}' here."
  | Parse.Ambiguous words ids ->
    String.join
      "\n"
      ("Which %{words}?" :: List.map (fn (n, id) -> "  %{n + 1}. %{short_of id w}") (List.indexed ids))
  | _ -> `I don't know how to "%{verb}".`

let _list o =
  match o with
  | Some x -> [x]
  | None -> []

-- Match a line to a verb and run it. A bare exit name is `go` that way.
let command body line (tx: Tx) = (
  let here = room_of body tx.w;
  let verb = String.lower (Option.default "" (String.word 0 line));
  let rest = String.trim (String.slice (String.length verb) (String.length line) line);
  let words = Parse.split (String.words rest);
  let dobj = Parse.resolve tx.w body here words.dobj;
  let iobj = Parse.resolve tx.w body here words.iobj;
  let holders =
    _holders
      body
      here
      (List.concat (_list (Parse.found_id dobj)) (_list (Parse.found_id iobj)))
      tx.w;
  match _find tx.w holders verb dobj iobj with
  | Some(h, v) -> (
    let ctx = ctx_for tx.w h body;
    let parsed =
      Core.Parsed(
        verb = verb,
        dobj = Parse.found_id dobj,
        prep = words.prep,
        iobj = Parse.found_id iobj,
        rest = rest
      );
    run ctx (fn () -> v.run ctx parsed) tx
  )
  | None -> (
    match World.instance here tx.w with
    | Some r when Map.has? verb r.object.exits -> command body "go %{verb}" tx
    | _ -> change (World.tell body (_unmatched tx.w verb dobj)) tx
  )
)

-- ── Input ──────────────────────────────────────────────────────────────

let _who body (w: World.World) =
  let names =
    List.sort
      (List.filter_map
        (fn (s: World.Session) -> Option.map (fn b -> short_of b w) s.body)
        (Map.values w.sessions));
  World.tell body "%{List.length names} connected: %{String.join ", " names}." w

let _after_verb line =
  String.trim
    (String.slice
      (String.length (Option.default "" (String.word 0 line)))
      (String.length line)
      line)

-- One player, by account name: awake or when last seen, and what they
-- look like.
let _who_is body name (w: World.World) =
  match World.account name w with
  | None -> World.tell body "There is no one called %{name}." w
  | Some a -> (
    let seen =
      (if Option.some? (World.session_of a.body w) then "%{a.name} is awake."
       else match a.last_seen with
         | Some at -> "%{a.name} was last seen %{at}."
         | None -> "%{a.name} has not been seen yet.");
    World.tell body "%{seen}\n%{_text w body a.body false}" w
  )

let _or_none xs = if xs == [] then "nothing" else String.join ", " xs

-- Who may enter a room, or move a thing, in words.
let _access (i: World.Instance) =
  if player? i.id then "its own"
  else if i.env == None then
    match i.allowed with
    | Core.Everyone -> "public"
    | Core.Only [] -> "private"
    | Core.Only names -> "private, and open to %{String.join ", " names}"
  else if i.locked then "locked"
  else "unlocked"

-- What the driver knows of an object: for builders, who need to see what
-- the text of a room does not say.
let _examine body words (w: World.World) = (
  let here = room_of body w;
  let found =
    if words == "" then Parse.Found here else Parse.resolve w body here (String.words words);
  match found with
  | Parse.Found id -> (
    match World.instance id w with
    | None -> World.tell body "There is no %{id}." w
    | Some i -> (
      let props =
        (match i.object.props with
         | Some f ->
           List.map
             (fn (k, v) -> "%{k} = %{JSON.stringify v}")
             (Map.to_list (_bounded Map.empty (fn () -> f (_seen w body i.id))))
         | None -> []);
      let lines =
        [
          "%{i.id}: %{short_of i.id w}",
          "  in: %{Option.default "nothing" i.env}",
          "  holds: %{_or_none (World.contents i.id w)}",
          "  made by: %{Option.default "the driver" i.creator}, %{Option.default "at boot" i.created}",
          "  owner: %{Option.default "the admins" i.owner}",
          "  access: %{_access i}",
          "  changed: %{Option.default "never" i.modified}",
          "  props: %{_or_none props}",
          "  verbs: %{_or_none (List.flatten (List.map (fn (v: Core.Verb) -> v.names) i.object.verbs))}",
          "  exits: %{_or_none (Map.keys i.object.exits)}",
          "  details: %{_or_none (Map.keys i.object.details)}",
          "  heartbeat: %{if Option.some? i.object.heartbeat then "yes" else "no"}",
          "  call-outs: %{_or_none (List.map (fn (c: World.Callout) -> "%{c.verb} at %{c.due}") (World.callouts_of i.id w))}"
        ];
      World.tell body (String.join "\n" lines) w
    )
  )
  | _ -> World.tell body "You don't see a '%{words}' here." w
)

-- The blueprint path `/edit` names: the room's, an object's by name, or
-- one written out, as /r/home/ann/lamp.
let _edit_target body words (w: World.World) = (
  let here = room_of body w;
  if words == "" || words == "here" then Ok (World.blueprint_of here)
  else if String.starts_with? "/" words then
    Ok
      (if String.ends_with? ".wand" words then String.slice 0 (String.length words - 5) words
      else words)
  else match Parse.resolve w body here (String.words words) with
    | Parse.Found id -> Ok (World.blueprint_of id)
    | _ -> Error "You don't see a '%{words}' here."
)

let _editor_state path lines here evaluating =
  JSON.of_map
    (Map.from_list [
      ("path", JSON.of_string path),
      ("lines", JSON.of_list (List.map JSON.of_string lines)),
      ("cur", JSON.of_int (List.length lines)),
      ("origin", JSON.of_string here),
      ("eval", JSON.of_bool evaluating)
    ])

-- An editor with `state`, for `body`: a new one of its own, or, from inside
-- one, the same editor with the new state.
let _open_editor body state opened (tx: Tx) =
  let here = room_of body tx.w;
  if _editor? here then
    verb_with here body Core.Parsed(verb = "open", rest = JSON.stringify state) tx
  else (
    let id = "%{editor_bp}#%{World.next_number editor_bp tx.w}";
    tx
    |> _create id editor_bp (Some state) None None
    |> change (World.set_made id (Some body) (Some tx.at) None)
    |> _event World.Event(at = "", event = "spawn", actor = body, object = Some id)
    |> _tell_room here body "%{short_of body tx.w} leaves for the editor."
    |> change (World.tell body opened)
    |> _move (ctx_for tx.w body body) body id
  )

-- /eval with no expression: an editor buffer, whose `w` runs it.
let _eval_buffer body (tx: Tx) =
  _open_editor
    body
    (_editor_state "" [] (room_of body tx.w) true)
    "An /eval buffer. Add the expression with a, then w runs it."
    tx

-- Open the editor on the file of `path` for `body`: a new editor of its
-- own, or, from inside one, the same editor on another file.
let _edit body words (tx: Tx) =
  match _edit_target body words tx.w with
  | Error why -> change (World.tell body why) tx
  | Ok path -> if !(Files.valid? path) then
      change
        (World.tell body "'%{path}' is not a mudlib path. One looks like /r/home/ann/lamp.")
        tx
    else if !(may_edit? body path tx.w) then
      change
        (World.tell
          body
          "You may not edit %{path}. A builder edits the files in /r/home/<name>/.")
        tx
    else (
      let text = Files.read tx.w.lib_root path;
      let lines =
        (match text with
         | Some t -> String.lines t
         | None -> []);
      let state = _editor_state path lines (room_of body tx.w) false;
      let opened =
        if text == None then "%{path} is a new file."
        else "%{path}: %{List.length lines} lines.";
      _open_editor body state opened tx
    )

-- /update: load a file's new code, for a blueprint the player may edit.
let _update body words (tx: Tx) =
  match _edit_target body words tx.w with
  | Error why -> change (World.tell body why) tx
  | Ok path -> if !(Files.valid? path) then
      change (World.tell body "'%{path}' is not a mudlib path.") tx
    else if !(may_edit? body path tx.w) then
      change (World.tell body "You may not update %{path}.") tx
    else _pay body Inspiration.build_cost "update" (update body path) tx

-- The instances /reset names: here, me, an object by name, an instance id,
-- or a blueprint path for every instance of it.
let _reset_targets body words (w: World.World) = (
  let here = room_of body w;
  if words == "" then Error "Reset what? Name an object, here, me, or a path."
  else if words == "here" then Ok [here]
  else if words == "me" then Ok [body]
  else if String.starts_with? "/" words then
    if String.contains? "#" words then
      if Option.some? (World.instance words w) then Ok [words]
      else Error "There is no %{words}."
    else Ok (World.instances_of words w)
  else match Parse.resolve w body here (String.words words) with
    | Parse.Found id -> Ok [id]
    | _ -> Error "You don't see a '%{words}' here."
)

-- /reset: an instance whose blueprint the player may edit, or their own
-- body.
let _reset body words (tx: Tx) =
  match _reset_targets body words tx.w with
  | Error why -> change (World.tell body why) tx
  | Ok [] -> change (World.tell body "There is nothing to reset.") tx
  | Ok ids -> (
    let refused =
      List.filter
        (fn id -> id != body && !(may_edit? body (World.blueprint_of id) tx.w))
        ids;
    if refused != [] then
      change (World.tell body "You may not reset %{String.join ", " refused}.") tx
    else _pay body (Inspiration.build_cost * List.length ids) "reset" (reset body ids) tx
  )

-- What /verbs and /copy name: the room with here or nothing,
-- the body with me, or a thing by name.
let _named body words (w: World.World) =
  let here = room_of body w;
  if words == "" || words == "here" then Parse.Found here
  else if words == "me" then Parse.Found body
  else Parse.resolve w body here (String.words words)

-- One verb as a player types it, for each of its names: `pull lever`, or
-- `give <thing> <word> lever` for a verb that takes another object.
let _forms (i: World.Instance) (v: Core.Verb) =
  let me = Option.default "it" (List.head i.object.names);
  let arg (a: Core.Arg) =
    match a with
    | Core.NoArg -> ""
    | Core.This -> " %{me}"
    | Core.AnyObj -> " <thing>"
  in
  let iobj = if v.iobj == Core.NoArg then "" else " <word>%{arg v.iobj}";
  String.join ", " (List.map (fn n -> "%{n}%{arg v.dobj}%{iobj}") v.names)

-- /verbs: what a thing answers to, and a room's exits. For the room you
-- are in, also what each realm it is in answers to, nearest first.
let _verbs body words (w: World.World) =
  match _named body words w with
  | Parse.Found id -> (
    match World.instance id w with
    | None -> World.tell body "There is no %{id}." w
    | Some i -> (
      let name = short_of id w;
      let verbs =
        if i.object.verbs == [] then ["%{name} answers to nothing."]
        else "%{name} answers to:" :: List.map (fn v -> "  %{_forms i v}") i.object.verbs;
      let exits =
        if i.object.exits == Map.empty then []
        else ["Exits: %{String.join ", " (Map.keys i.object.exits)}."];
      let realms =
        if id != room_of body w then []
        else
          List.flatten
            (List.filter_map
              (fn r -> match World.instance r w with
                | Some ri when ri.object.verbs != [] ->
                  Some
                    ("%{short_of r w} answers to:" :: List.map (fn v -> "  %{_forms ri v}") ri.object.verbs)
                | _ -> None
              )
              (List.map realm_id (realms_of (World.blueprint_of id) w)));
      World.tell body (String.join "\n" (List.flatten [verbs, exits, realms])) w
    )
  )
  | _ -> World.tell body "You don't see a '%{words}' here." w

-- The examples /copy may copy: the files of the Learning Hall.
let learning = "/r/learning/"

-- /copy: write the file of a Learning Hall example into the builder's home,
-- and load it, as a start to change. A file of that name already there is
-- never written over. It is paid for as a save.
let _copy body words (tx: Tx) =
  match (_named body words tx.w, World.account_of body tx.w) with
  | (_, None) -> change (World.tell body "You have no account to copy into.") tx
  | (Parse.Found id, Some a) -> (
    let from = World.blueprint_of id;
    let key = String.lower a.name;
    let to =
      "/r/home/%{key}/%{Option.default "" (List.head (List.reverse (String.split "/" from)))}";
    let room? = World.env_of id tx.w == None;
    if !(String.starts_with? learning from) then
      change
        (World.tell
          body
          "Only the examples in the Learning Hall can be copied, and %{short_of id tx.w} is not one.")
        tx
    else if Files.exists? tx.w.lib_root to then
      change (World.tell body "You have %{to} already. Change it with /edit %{to}.") tx
    else match Option.map (Files.moved from to) (Files.read tx.w.lib_root from) with
      | None -> change (World.tell body "%{from} has no file to copy.") tx
      | Some source -> (
        match budget (Some key) (Core.Save to source) tx.w with
        | Error why -> change (World.tell body why) tx
        | Ok cost -> (
          let o = Files.save tx.w.lib_root to source;
          let use =
            if room? then `Go there with /eval [Core.Move ctx.actor "%{to}"]`
            else `Make one with /eval [Core.Spawn "%{to}" ctx.here]`;
          match (o.ok, Wand.load Core.Blueprint.loader (Files.file_of tx.w.lib_root to)) with
          | (true, Ok b) ->
            tx
            |> _charge (Some key) cost "copy"
            |> change (World.set_blueprint to b)
            |> _event World.Event(
              at = "",
              event = "copy",
              actor = body,
              object = Some to,
              text = Some from
            )
            |> change
              (World.tell
                body
                "Copied %{from} to %{to}. %{use}, and change it with /edit %{to}.")
          | (true, Error why) ->
            change
              (World.tell body "Copied %{from} to %{to}, but it did not load: %{why}")
              tx
          | (false, _) ->
            change
              (World.tell
                body
                "%{from} could not be copied: %{String.join "; " (List.map (fn (p: Core.Problem) -> p.message) o.problems)}")
              tx
        )
      )
  )
  | (_, Some _) -> change (World.tell body "You don't see a '%{words}' here.") tx

-- An account's Capacity and Inspiration, as /stat shows them.
let _stat_text (a: World.Account) (w: World.World) =
  let key = String.lower a.name;
  let i = a.inspiration;
  let lines =
    [
      "%{a.name}, %{a.role}.",
      "Capacity: %{List.length (World.owned key w)} of %{max_owned} objects, %{file_count key w} of %{max_files} files, %{_size (World.saved_bytes key w)} of %{_size max_saved_total} of saved state.",
      "Inspiration: %{Inspiration.amount w.now i} of %{Inspiration.full}, refilling %{60 / Inspiration.seconds_per_point} a minute.",
      "Rooms explored: %{Map.size a.explored}, %{Inspiration.today w.now a.explored} of %{Inspiration.bonuses_a_day} today."
    ];
  let notes = if a.role == "admin" then ["An admin is held to neither limit."] else [];
  String.join "\n" (List.concat lines notes)

-- /stat: a builder's own Capacity and Inspiration, or, for an admin,
-- anyone's.
let _stat body words (tx: Tx) = (
  let me = World.account_of body tx.w;
  let found =
    (if words == "" || words == "me" then
       match me with
       | Some a -> Ok a
       | None -> Error "You have no account."
     else if Option.map (fn (a: World.Account) -> a.role) me != Some "admin" then
       Error "Only an admin may see another's. Try /stat me."
     else match World.account words tx.w with
       | Some a -> Ok a
       | None -> Error "There is no one called %{words}.");
  match found with
  | Error why -> change (World.tell body why) tx
  | Ok a -> (let text = _stat_text a tx.w; change (World.tell body text) tx)
)

-- Whether `body` may say who enters or moves `id`: its owner, or an admin.
let _may_change? body id (w: World.World) =
  let key = _key_of body w;
  Option.some? key && (World.owner_of id w == key || _exempt? key w)

-- Who may enter `room` once it is private: whom it lets in already, or
-- only its owner and the admins when it was public.
let _closed room (w: World.World) =
  match Option.map (fn (i: World.Instance) -> i.allowed) (World.instance room w) with
  | Some (Core.Only names) -> Core.Only names
  | _ -> Core.Only []

-- /public and /private: open the room `body` is in to everyone, or close it
-- to all but its owner, whoever it invites, and the admins.
let _set_public body words public (tx: Tx) =
  let room = room_of body tx.w;
  let name = short_of room tx.w;
  if words != "" && words != "here" then
    change (World.tell body "It changes the room you are in: /public here.") tx
  else if !(_may_change? body room tx.w) then
    change (World.tell body "%{name} is not yours to open or close.") tx
  else
    tx
    |> change (World.set_allowed room (if public then Core.Everyone else _closed room tx.w))
    |> _event World.Event(
      at = "",
      event = if public then "public" else "private",
      actor = body,
      room = Some room
    )
    |> change
      (World.tell
        body
        (if public then "%{name} is public now: anyone may come in."
        else "%{name} is private now: only you, whoever you invite, and the admins may come in."))

-- /invite and /uninvite: let one account into the private room `body` is
-- in, or no longer.
let _invite body words yes (tx: Tx) = (
  let room = room_of body tx.w;
  let title = short_of room tx.w;
  match String.words words with
  | [name :: rest] when rest == [] || rest == ["here"] -> (
    if !(_may_change? body room tx.w) then
      change (World.tell body "%{title} is not yours to invite anyone into.") tx
    else if Option.map World.public? (World.instance room tx.w) == Some true then
      change
        (World.tell body "%{title} is public: anyone may come in. /private here closes it.")
        tx
    else match World.account name tx.w with
      | None -> change (World.tell body "There is no one called %{name}.") tx
      | Some a -> if yes then
          tx
          |> change (World.invite room a.name)
          |> _event World.Event(
            at = "",
            event = "invite",
            actor = body,
            name = Some a.name,
            room = Some room
          )
          |> change (World.tell body "%{a.name} may come into %{title} now.")
          |> change (World.tell a.body "%{short_of body tx.w} invites you into %{title}.")
        else
          tx
          |> change (World.uninvite room a.name)
          |> _event World.Event(
            at = "",
            event = "uninvite",
            actor = body,
            name = Some a.name,
            room = Some room
          )
          |> change
            (World.tell
              body
              "%{a.name} may no longer come into %{title} while it is private.")
  )
  | _ ->
    change
      (World.tell
        body
        (if yes then "Invite whom? /invite bo here" else "Uninvite whom? /uninvite bo here"))
      tx
)

-- /ban and /unban: keep one account out of every room the account of
-- `body` owns, public or private, or no longer. A banned body in one of
-- those rooms goes home. The banned person is not told: a room they try to
-- enter says what a private room says.
let _ban body words yes (tx: Tx) =
  match (World.account_of body tx.w, String.words words) with
  | (None, _) -> change (World.tell body "You have no account.") tx
  | (Some me, [name]) -> (
    match World.account name tx.w with
    | None -> change (World.tell body "There is no one called %{name}.") tx
    | Some a when String.lower a.name == String.lower me.name ->
      change (World.tell body "You cannot ban yourself.") tx
    | Some a when a.role == "admin" ->
      change (World.tell body "An admin may go anywhere, so %{a.name} cannot be banned.") tx
    | Some a -> if yes then (
        let banned =
          tx
          |> change (World.ban me.name a.name)
          |> _event World.Event(at = "", event = "ban", actor = body, name = Some a.name)
          |> change (World.tell body "%{a.name} may no longer come into your rooms.");
        let room = room_of a.body banned.w;
        if World.owner_of room banned.w == Some (String.lower me.name) then
          banned
          |> _tell_room room a.body "%{a.name} leaves."
          |> _move (ctx_for banned.w a.body a.body) a.body (home_of a.body banned.w)
        else banned
      )
      else
        tx
        |> change (World.unban me.name a.name)
        |> _event World.Event(at = "", event = "unban", actor = body, name = Some a.name)
        |> change
          (World.tell body "%{a.name} may come into your rooms again, where they are let in.")
  )
  | _ ->
    change
      (World.tell body (if yes then "Ban whom? /ban bo" else "Unban whom? /unban bo"))
      tx

-- /lock and /unlock: whether only what its owner owns may move a thing,
-- or anything that can reach it.
let _set_locked body words locked (tx: Tx) = (
  let verb = if locked then "lock" else "unlock";
  let here = room_of body tx.w;
  let found =
    if words == "" then Parse.Missing ""
    else Parse.resolve tx.w body here (String.words words);
  match found with
  | Parse.Found id -> (
    let name = short_of id tx.w;
    if player? id || World.env_of id tx.w == None then
      change
        (World.tell
          body
          "Only a thing can be locked: a room is /private, and a player is their own.")
        tx
    else if !(_may_change? body id tx.w) then
      change (World.tell body "%{name} is not yours to %{verb}.") tx
    else
      tx
      |> change (World.set_locked id locked)
      |> _event World.Event(at = "", event = verb, actor = body, object = Some id)
      |> change
        (World.tell
          body
          (if locked then "%{name} is locked now: only what its owner owns may move it."
          else "%{name} is unlocked now: anything that can reach it may move it."))
  )
  | _ ->
    change
      (World.tell
        body
        (if words == "" then "What do you want to %{verb}?"
        else "You don't see a '%{words}' here."))
      tx
)

-- ── Flags ──────────────────────────────────────────────────────────────

-- How many different people flag a room or a thing before it is taken
-- out of view to wait for an admin.
let flags_to_hold = 3

let _admin? body (w: World.World) =
  match World.account_of body w with
  | Some a -> a.role == "admin"
  | None -> false

-- What a room or a thing was when it was flagged: its text, and its file.
-- Its own text, even when it is held, so an admin sees what was there.
let _evidence id (w: World.World) =
  match World.instance id w with
  | None -> "(it is gone)"
  | Some i -> (
    let ctx = _seen w id id;
    let bp = i.blueprint;
    let source = Option.default "(there is no file)" (Files.read w.lib_root bp);
    `%{_bounded "(its short text faults)" (fn () -> i.object.short ctx)}
%{_bounded "(its long text faults)" (fn () -> i.object.long ctx)}

--- %{bp}.wand ---
%{source}`
  )

-- What a flag is about, in words.
let _about (f: World.Flag) =
  if f.kind == "person" then f.target else "%{f.kind} %{f.target}"

-- Take a room or a thing out of view once enough different people have
-- flagged it: a room is made private, and a thing is held.
let _hold_if_flagged (f: World.Flag) (tx: Tx) = (
  let by =
    List.unique (List.map (fn (g: World.Flag) -> g.by) (World.open_flags f.target tx.w));
  let held =
    (if List.length by < flags_to_hold then None
     else match World.instance f.target tx.w with
       | Some i when f.kind == "room" && World.public? i -> Some (
         World.set_allowed f.target (Core.Only []),
         "is private until an admin has looked at it"
       )
       | Some i when f.kind == "object" && !i.held -> Some (
         World.set_held f.target true,
         "is out of view until an admin has looked at it"
       )
       | _ -> None);
  match held with
  | None -> tx
  | Some(hold, why) -> (
    let told =
      (match f.owner with
       | Some o -> change (World.notice o "Your %{f.kind} %{f.target} %{why}.") tx
       | None -> tx);
    told
    |> change hold
    |> _event World.Event(
      at = "",
      event = "held",
      actor = f.target,
      text = Some "%{List.length by} flags"
    )
  )
)

-- Keep a flag. The flagger is thanked; a builder is told what was flagged
-- and why, and never who flagged it.
let _file_flag body kind target owner reason evidence (tx: Tx) =
  match _key_of body tx.w with
  | None -> tx
  | Some by -> (
    let f =
      World.Flag(
        id = List.length tx.w.flags + 1,
        by = by,
        kind = kind,
        target = target,
        owner = owner,
        reason = reason,
        at = tx.w.now,
        evidence = evidence
      );
    let filed =
      tx
      |> change (World.add_flag f)
      |> _event World.Event(
        at = "",
        event = "flag",
        actor = body,
        object = Some target,
        text = Some "#%{f.id} %{kind}: %{reason}"
      )
      |> change (World.tell body "Thank you. An admin will look at it.");
    let told =
      (match owner with
       | Some o when kind != "person" ->
         change
           (World.notice
             o
             "Your %{kind} %{target} was flagged: %{reason}. An admin will look at it.")
           filed
       | _ -> filed);
    _hold_if_flagged f told
  )

-- What follows the first word of `words`.
let _rest_of words =
  String.trim
    (String.slice
      (String.length (Option.default "" (String.word 0 words)))
      (String.length words)
      words)

-- /flag here <why>, and /flag <thing> <why>.
let _flag body words (tx: Tx) = (
  let here = room_of body tx.w;
  let reason = _rest_of words;
  match String.word 0 words with
  | None ->
    change
      (World.tell body "Flag what, and why? /flag here <why>, or /flag <thing> <why>.")
      tx
  | Some first -> (
    let found =
      if first == "here" then Parse.Found here else Parse.resolve tx.w body here [first];
    match found with
    | Parse.Found id -> if player? id then
        change (World.tell body "To tell the admins about a person, /report them.") tx
      else if reason == "" then change (World.tell body "Say why: /flag %{first} <why>.") tx
      else (
        let kind = if World.env_of id tx.w == None then "room" else "object";
        let evidence = _evidence id tx.w;
        _file_flag body kind id (World.owner_of id tx.w) reason evidence tx
      )
    | _ -> change (World.tell body "You don't see a '%{first}' here.") tx
  )
)

-- /report <name> <why>: a person's behavior, with the last lines they said.
let _report body words (tx: Tx) = (
  let reason = _rest_of words;
  match String.word 0 words with
  | Some name when reason != "" -> (
    match World.account name tx.w with
    | None -> change (World.tell body "There is no one called %{name}.") tx
    | Some a -> (
      let lines = Option.default [] (Map.get a.body tx.w.said);
      let evidence = if lines == [] then "(nothing said lately)" else String.join "\n" lines;
      let key = String.lower a.name;
      _file_flag body "person" key (Some key) reason evidence tx
    )
  )
  | _ -> change (World.tell body "Report whom, and why? /report <name> <why>.") tx
)

-- /flags: the open flags, or one flag whole.
let _flags body words (w: World.World) =
  if !(_admin? body w) then World.tell body "Only an admin reviews flags." w
  else if words == "" then (
    let open = List.filter (fn (f: World.Flag) -> f.open) w.flags;
    if open == [] then World.tell body "No flags are open." w
    else
      World.tell
        body
        (String.join
          "\n"
          (List.map
            (fn (f: World.Flag) -> "#%{f.id} %{_about f}, by %{f.by} at %{f.at}: %{f.reason}")
            open))
        w
  )
  else match Option.and_then (fn n -> World.flag n w) (Result.to_option (String.to_int words)) with
    | None -> World.tell body "There is no flag #%{words}." w
    | Some f ->
      (World.tell
        body
        `#%{f.id} %{_about f}, owned by %{Option.default "the admins" f.owner}
Flagged by %{f.by} at %{f.at}: %{f.reason}
%{Option.default "Open." (Option.map (fn r -> "Resolved: %{r}") f.resolution)}

%{f.evidence}`
        w)

-- Close a flag, and let a held thing back into view when no flag on it is
-- open any more.
let _close body (f: World.Flag) resolution told (tx: Tx) =
  let closed =
    tx
    |> change (World.resolve_flag f.id resolution)
    |> _event World.Event(
      at = "",
      event = "resolve",
      actor = body,
      object = Some f.target,
      text = Some "#%{f.id} %{resolution}"
    )
    |> change (World.tell body told);
  if f.kind == "object" && World.open_flags f.target closed.w == [] then
    change (World.set_held f.target false) closed
  else closed

-- Pause an account: it may not log in, and its session ends.
let _pause name why (tx: Tx) =
  match World.account name tx.w with
  | None -> tx
  | Some a -> (
    let paused = change (World.set_paused a.name true) tx;
    match World.session_of a.body tx.w with
    | Some s ->
      paused
      |> change (World.tell a.body "An admin has paused your account: %{why}")
      |> change (World.close_soon s.id)
    | None -> paused
  )

-- /resolve <n> <how> [note].
let _resolve body words (tx: Tx) = (
  let usage = "Resolve how? /resolve <number> dismiss, private, remove, warn or pause, and a note if you like.";
  if !(_admin? body tx.w) then change (World.tell body "Only an admin resolves flags.") tx
  else match String.words words with
    | n :: how :: rest -> (
      let note = String.join " " rest;
      let said = if note == "" then how else "%{how}: %{note}";
      let why = if note == "" then "" else " %{note}";
      match Option.and_then (fn k -> World.flag k tx.w) (Result.to_option (String.to_int n)) with
      | None -> change (World.tell body "There is no flag #%{n}.") tx
      | Some f when !f.open ->
        change (World.tell body "Flag #%{f.id} is resolved already: %{Option.default "" f.resolution}.") tx
      | Some f -> (
        -- A flag's owner is the person reported, or the owner of the work.
        match (how, f.owner) with
        | ("dismiss", _) -> _close body f said "Flag #%{f.id} dismissed." tx
        | ("private", _) -> if f.kind != "room" then
            change (World.tell body "Only a room is made private.") tx
          else
            tx
            |> change (World.set_allowed f.target (Core.Only []))
            |> (match f.owner with
              | Some o -> change (World.notice o "An admin made your room %{f.target} private: %{f.reason}.%{why}")
              | None -> fn t -> t)
            |> _close body f said "%{f.target} is private now."
        | ("remove", _) -> if f.kind != "object" then
            change (World.tell body "Only a thing is removed. A room is made private.") tx
          else if List.any? player? (World.contents f.target tx.w) then
            change (World.tell body "A player is in %{f.target}; it stays.") tx
          else (
            let removed =
              tx
              |> change (World.remove f.target)
              |> (match f.owner with
                | Some o -> change (World.notice o "An admin removed your object %{f.target}: %{f.reason}.%{why}")
                | None -> fn t -> t);
            List.fold_left
              (fn acc (g: World.Flag) -> _close body g said "Flag #%{g.id} resolved." acc)
              removed
              (World.open_flags f.target removed.w)
          )
        | ("warn", Some o) ->
          tx
          |> change (World.notice o "An admin warns you about %{_about f}: %{f.reason}.%{why}")
          |> _close body f said "%{o} is warned."
        | ("pause", Some o) ->
          tx
          |> _pause o "%{f.reason}.%{why}"
          |> _event World.Event(at = "", event = "pause", actor = body, name = Some o)
          |> _close body f said "%{o} is paused. /unpause %{o} lets them back."
        | ("warn", None) -> change (World.tell body "The admins own %{f.target}; there is no one to warn.") tx
        | ("pause", None) -> change (World.tell body "The admins own %{f.target}; there is no one to pause.") tx
        | _ -> change (World.tell body usage) tx
      )
    )
    | _ -> change (World.tell body usage) tx
)

-- /pause <name> and /unpause <name>, for an admin.
let _set_paused body words paused (tx: Tx) =
  if !(_admin? body tx.w) then
    change (World.tell body "Only an admin pauses an account.") tx
  else match World.account words tx.w with
    | None -> change (World.tell body "There is no one called %{words}.") tx
    | Some a -> (
      let changed =
        if paused then _pause a.name "an admin will tell you why." tx
        else change (World.set_paused a.name false) tx;
      changed
      |> _event World.Event(
        at = "",
        event = if paused then "pause" else "unpause",
        actor = body,
        name = Some a.name
      )
      |> change
        (World.tell
          body
          (if paused then "%{a.name} is paused." else "%{a.name} may log in again."))
    )

-- The verbs whose lines a report can show.
let _speech = ["say", "pose", "semipose"]

-- /help: the topics, or one of them.
let _help body words (w: World.World) = (
  let topics =
    "Help topics: %{String.join ", " (List.sort (Map.keys w.help))}. Type /help and a topic.";
  if words == "" then World.tell body topics w
  else match Map.get (String.lower words) w.help with
    | Some text -> World.tell body (String.trim text) w
    | None -> World.tell body "There is no help on '%{words}'. %{topics}" w
)

-- A command line from a session that is logged in.
let _command_line sid body at line (tx: Tx) =
  if line == "" then tx
  else (
    let full = _expand line;
    let verb = String.lower (Option.default "" (String.word 0 full));
    let noted =
      _event
        World.Event(
          at = at,
          event = "command",
          actor = body,
          name = Some (short_of body tx.w),
          verb = Some verb,
          room = Some (room_of body tx.w),
          text = if verb == "say" then
              Some (String.trim (String.slice 3 (String.length full) full))
            else None
        )
        tx;
    -- What a body says is kept for a while, in case someone reports it.
    let said =
      if List.any? (fn v -> v == verb) _speech then change (World.said_by body full) noted
      else noted;
    -- A body whose account has not signed the current rules is taken to the
    -- Rules Hall, and the realms of where it stands say which commands work.
    let logged = if signed? body tx.w then said else _to_hall body said;
    match _command_ok body verb logged.w with
    | Error why -> change (World.tell body why) logged
    | Ok _ -> (
      match verb with
      | "/quit" ->
        logged |> change (World.tell body "Goodbye.") |> change (World.close_soon sid)
      | "/who" -> (
        match String.word 1 full with
        | Some name -> change (_who_is body name) logged
        | None -> change (_who body) logged
      )
      | "/examine" -> change (_examine body (_after_verb full)) logged
      | "/stat" -> _stat body (_after_verb full) logged
      | "/verbs" -> change (_verbs body (_after_verb full)) logged
      | "/copy" -> _copy body (_after_verb full) logged
      | "/help" -> change (_help body (_after_verb full)) logged
      | "/flag" -> _flag body (_after_verb full) logged
      | "/report" -> _report body (_after_verb full) logged
      | "/flags" -> change (_flags body (_after_verb full)) logged
      | "/resolve" -> _resolve body (_after_verb full) logged
      | "/pause" -> _set_paused body (_after_verb full) true logged
      | "/unpause" -> _set_paused body (_after_verb full) false logged
      | "/public" -> _set_public body (_after_verb full) true logged
      | "/private" -> _set_public body (_after_verb full) false logged
      | "/invite" -> _invite body (_after_verb full) true logged
      | "/uninvite" -> _invite body (_after_verb full) false logged
      | "/ban" -> _ban body (_after_verb full) true logged
      | "/unban" -> _ban body (_after_verb full) false logged
      | "/lock" -> _set_locked body (_after_verb full) true logged
      | "/unlock" -> _set_locked body (_after_verb full) false logged
      | "/edit" -> _edit body (_after_verb full) logged
      | "/update" -> _update body (_after_verb full) logged
      | "/reset" -> _reset body (_after_verb full) logged
      | "/eval" -> (
        match _after_verb full with
        | "" -> _eval_buffer body logged
        | expr -> eval body expr logged
      )
      | "/sethome" -> (
        let room = room_of body tx.w;
        logged
        |> change (World.set_home body room)
        |> change (World.tell body "%{short_of room tx.w} is your home now.")
      )
      | _ -> command body full logged
    )
  )

-- The input hook of the room `body` is in, when it takes `line`: every
-- line while the room takes raw text, as the editor does after `a`, and
-- otherwise every line but a driver command.
let _input_of body line (w: World.World) =
  match World.instance (room_of body w) w with
  | None -> None
  | Some i -> (
    match i.object.input with
    | None -> None
    | Some f -> (
      let raw =
        (match i.object.props with
         | Some p -> (
           match Map.get "raw" (p (_seen w body i.id)) with
           | Some j -> Result.default false (JSON.get_bool j)
           | None -> false
         )
         | None -> false);
      if raw || !(String.starts_with? "/" (String.trim line)) then Some (i.id, f) else None
    )
  )

-- A line from a session that is logged in. A room with an input hook
-- gets it as typed, spaces and all; anything else is a command.
let _play sid body at line (tx: Tx) =
  match _input_of body line tx.w with
  | Some(room, f) -> (let ctx = ctx_for tx.w room body; run ctx (fn () -> f ctx line) tx)
  | None -> _command_line sid body at (String.trim line) tx

-- A line from a session that has not logged in goes to /std/login, whole.
let _to_login sid line (tx: Tx) =
  match World.instance login_id tx.w with
  | None -> tx
  | Some i -> (
    match i.object.input with
    | None -> tx
    | Some f -> (
      let ctx =
        Core.Context(
          self = login_id,
          actor = sid,
          here = login_id,
          world = view tx.w sid,
          time = tx.w.now
        );
      run ctx (fn () -> f ctx line) tx
    )
  )

let run_input (i: World.Input) (tx: Tx) =
  match i with
  | World.Connect sid _ -> verb login_id sid "connect" tx
  | World.Line sid at line -> (
    match World.session sid tx.w with
    | None -> tx
    -- A session that is closing, after /quit say, runs nothing more: the
    -- reader may have queued lines the client sent after it.
    | Some s when s.closing -> tx
    | Some s -> (
      match s.body with
      | None -> _to_login sid line tx
      | Some body -> _play sid body at line tx
    )
  )
  | World.Gone sid _ body -> (
    match body with
    | Some b ->
      tx
      |> _tell_room (room_of b tx.w) b "%{short_of b tx.w} falls asleep."
      |> change (World.seen b tx.at)
    | None -> verb login_id sid "done" tx
  )

-- ── The loop ───────────────────────────────────────────────────────────

-- The rooms, services and realms that exist before anyone connects.
let boot state at =
  let start = begin (Shared.get state) at |> _ensure login_id |> _ensure arrival;
  let honored = List.filter (fn p -> file_owner p start.w == None) (Map.keys start.w.realms);
  let tx = List.fold_left (fn t p -> _ensure (realm_id p) t) start honored;
  Shared.update state (commit tx)

-- Take every queued input, in order. Each is applied in its own update,
-- and taken off the queue in the same update, so a session can see when
-- the driver has finished with everything it sent.
let step state =
  let (w: World.World) = Shared.get state;
  List.each
    (fn i ->
      let tx = run_input i (begin (Shared.get state) (World.at_of i));
      Shared.update state (fn cur -> World.dequeued 1 (commit tx cur)))
    w.inputs

-- ── Time ───────────────────────────────────────────────────────────────

-- Whether the owner of `id` has Inspiration left for its heartbeat and
-- call-outs. Until it refills, they wait.
let _owner_inspired? id (w: World.World) =
  let owner = World.owner_of id w;
  _exempt? owner w || Result.ok? (_inspired (Option.default "" owner) 1 w)

-- Call `id` on its own, with itself as the actor, and charge its owner the
-- steps the call took.
let _on_its_own id body (tx: Tx) =
  let ctx = ctx_for tx.w id id;
  let (ran, steps) = run_counted ctx (fn () -> body ctx) tx;
  _spend (World.owner_of id tx.w) (Inspiration.of_steps steps) ran

let _beat id (tx: Tx) =
  match World.instance id tx.w with
  | Some i -> (
    match i.object.heartbeat with
    | Some h when _owner_inspired? id tx.w -> _on_its_own id (fn ctx -> h ctx) tx
    | _ -> tx
  )
  | None -> tx

-- Run call-out `c`, or None when it must wait for its owner's Inspiration.
-- One whose object is gone, or has no such verb, is dropped.
let _call_out (c: World.Callout) (tx: Tx) =
  match World.instance c.target tx.w with
  | None -> Some (change (World.ran c.id) tx)
  | Some i -> (
    if !(_owner_inspired? c.target tx.w) then None
    else match List.find (fn (v: Core.Verb) -> List.any? (fn n -> n == c.verb) v.names) i.object.verbs with
      | None ->
        Some
          (tx
          |> change (World.ran c.id)
          |> _event World.Event(
            at = "",
            event = "refused",
            actor = c.target,
            text = Some "call-out: no verb %{c.verb}"
          ))
      | Some v ->
        Some
          (tx
          |> change (World.ran c.id)
          |> _on_its_own c.target (fn ctx -> v.run ctx Core.Parsed(verb = c.verb)))
  )

-- One tick: call every object with a heartbeat, then run every call-out
-- whose time has come, oldest first. Each is applied in its own update, as
-- an input is. What a heartbeat or a call-out starts waits for the next
-- tick.
let tick state at = (
  let (w: World.World) = Shared.get state;
  List.each
    (fn id ->
      let tx = _beat id (begin (Shared.get state) at);
      Shared.update state (commit tx))
    (Map.keys w.beating);
  List.each
    (fn (c: World.Callout) -> (
      let tx = begin (Shared.get state) at;
      -- A heartbeat or an earlier call-out may have removed it.
      let ran = if World.pending_callout? c.id tx.w then _call_out c tx else None;
      match ran with
      | Some done -> (let _ = Shared.update state (commit done); ())
      | None -> ()
    ))
    (World.due (begin w at).w.now w)
)

-- ── Snapshots ──────────────────────────────────────────────────────────

-- Call `save` on every object that changed since the last snapshot, and
-- write the file. The driver fiber runs this between inputs, and it is the
-- only fiber that changes an object, so no object is caught halfway
-- through a change. A `save` that faults is logged, and that object is
-- left out of the file.
let snapshot! state path at = (
  let (w: World.World) = Shared.get state;
  let results =
    List.filter_map
      (fn (i: World.Instance) -> match i.saved with
        | Some _ -> None
        | None -> Some (
          i.id,
          Result.and_then
            (fn j ->
              let size = String.length (JSON.stringify j);
              if size > max_saved i.blueprint then
                Error
                  "its saved state is %{size} bytes, and the most is %{max_saved i.blueprint}"
              else Ok j)
            (_call (fn () -> i.object.save ()))
        )
      )
      (Map.values w.instances);
  let kept (cur: World.World) =
    List.fold_left
      (fn acc (id, r) -> match r with
        | Ok j -> World.keep_saved id j acc
        | Error why ->
          World.emit
            World.Event(at = at, event = "fault", actor = id, text = Some "save: %{why}")
            acc
      )
      cur
      results;
  Shared.update state (fn cur -> World.snapshot_taken (kept cur));
  Snapshot.write! path (Snapshot.of_world (Shared.get state))
)

-- Who owns an object a snapshot kept. A version 1 file did not keep
-- owners, so there a body is its account's and anything else is the owner
-- of its file.
let _restored_owner (f: Snapshot.File) (s: Snapshot.Saved) (w: World.World) =
  if f.version >= 2 then s.owner
  else match List.find (fn (a: World.Account) -> a.body == s.id) f.accounts with
    | Some a -> Some (String.lower a.name)
    | None -> file_owner s.blueprint w

-- Who may enter a room a snapshot kept: everyone when it was public, and
-- otherwise whom it invited. Before rooms were private, a room the admins
-- owned was public.
let _restored_allowed (f: Snapshot.File) (s: Snapshot.Saved) (w: World.World) =
  if Option.default (_restored_owner f s w == None) s.public then Core.Everyone
  else Core.Only s.invited

-- Bring back what a snapshot kept: the accounts, then every object, made
-- again by its blueprint's `create` from its saved state, and the
-- call-outs. One that came due while the server was down runs at the
-- first tick.
let restore state (f: Snapshot.File) at =
  let accounts =
    List.fold_left
      (fn t (a: World.Account) -> change (World.add_account a) t)
      (begin (Shared.get state) at
      |> change (fn w -> World.World(w, flags = f.flags))
      |> change (World.restore_callouts f.callouts))
      f.accounts;
  let tx =
    List.fold_left
      (fn t (s: Snapshot.Saved) -> t
      |> _create s.id s.blueprint (Some s.state) s.env (_restored_owner f s t.w)
      |> change (World.set_made s.id s.creator s.created s.modified)
      |> change (World.keep_saved s.id s.state)
      |> change (World.set_access s.id (_restored_allowed f s t.w) s.locked)
      |> change (World.set_held s.id s.held))
      accounts
      f.instances;
  Shared.update state (commit tx)

-- Make an account and its body in the arrival room, with no session: how
-- `wmd init` makes the first admin.
let make_account state name typed role at =
  let t = begin (Shared.get state) at;
  let body = "%{player_bp}#%{World.next_number player_bp t.w}";
  let saved = JSON.of_map (Map.from_list [("name", JSON.of_string name)]);
  let hashed = Password.hash t.w.pepper (Random.hex 32) typed;
  let tx =
    t
    |> _ensure arrival
    |> _create body player_bp (Some saved) (Some arrival) (Some (String.lower name))
    |> change
      (World.add_account World.Account(
        name = name,
        body = body,
        password = hashed,
        role = role
      ));
  Shared.update state (commit tx)
