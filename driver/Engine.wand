uses {FS.Read, FS.Write, Random, Shared}

-- The driver proper: the one fiber that runs Library code.
--
-- It takes each input the sessions queued, runs the Library code it calls
-- for, checks the actions that come back, and applies them. Only this fiber
-- runs Library code or changes an object, so the world it reads cannot
-- change under it before it writes.

import ./Evaluate
import ./Files
import ./Inspiration
import ./Library
import ./Parse
import ./Password
import ./Scan
import ./Snapshot
import ./World
import FS
import JSON
import List

import Map

import Option
import Random
import Regex
import Result
import Shared
import Size
import String
import Wand

let Driver = import ../driver

let login_id (w: World.Current) = "%{w.paths.login}#0"

let player_bp (w: World.Current) = w.paths.player

-- Where a body wakes until its account has signed the current rules.
let rules_hall (w: World.Current) = "%{w.paths.rules}#0"

-- Where every new body first stands.
let arrival (w: World.Current) = "%{w.paths.arrival}#0"

-- ── Changes ────────────────────────────────────────────────────────────

-- The work on one input: the world as the driver sees it so far, and every
-- change made to it, newest first. The changes are made again, in order,
-- on the shared world, where the sessions may have added lines or input in
-- the meantime: the two kinds of change do not touch the same things.
-- `hooks` is false while a hook runs, so the moves it makes call no more
-- hooks.
type Tx(
  w: World.Current,
  changes: List (World.Current -> World.Current ! {}),
  at: String,
  hooks: Bool = true
)

-- Work that starts at `at`, the time its input arrived. The working copy
-- carries that time, for `ctx.time`.
let begin (w: World.Current) at =
  Tx(
    w = World.Current(w, now = Result.default 1970-01-01T00:00:00Z (String.to_datetime at)),
    changes = [],
    at = at
  )

let change f (tx: Tx) = Tx(tx, w = f tx.w, changes = f :: tx.changes)

let commit (tx: Tx) (w: World.Current) = List.fold_right (fn f acc -> f acc) tx.changes w

-- Every event of one input carries the time the input arrived.
let _event (ev: World.Event) (tx: Tx) = change (World.emit World.Event(ev, at = tx.at)) tx

-- ── Running Library code ────────────────────────────────────────────────

-- Every Library call runs under this. Draws come from the driver's own
-- generator, and a seed does nothing: all Library calls share one generator,
-- so one file calling Random.seed would otherwise fix every die in the
-- world.
let guarded body =
  handle body () with
  | Random!int n k -> k (Random.int 0 (n - 1))
  | Random!float _ k -> k (Random.float ())
  | Random!seed _ k -> k ()

-- How much one Library call may do before the driver stops it, as MudOS
-- stops a "too long evaluation": steps, which bound time and the size of
-- what it builds, and how deep its calls may nest.
let limits = Wand.Limits(steps = 100000, depth = 1000)

-- A Library call, with a raise or a limit that ran out as an Error, so a
-- fault in one object cannot stop the driver.
let _call body =
  match Wand.limit limits (fn () -> try guarded body) with
  | Ok r -> r
  | Error why -> Error why

-- Library code that gives a value and performs nothing, such as a `short`,
-- under the same limits: `fallback` when it runs out.
-- `_call`, with the steps the call took, for the event log.
let _counted body =
  match Wand.limit limits (fn () -> Wand.cost (fn () -> try guarded body)) with
  | Ok(r, steps) -> (r, steps)
  | Error why -> (Error why, limits.steps)

let _bounded fallback f =
  match Wand.limit limits f with
  | Ok v -> v
  | Error _ -> fallback

-- The longest line an object may show, and the most actions one reply may
-- ask for: an object cannot flood a session or the driver.
let max_line = 8192

let max_actions = 100

-- The most call-outs one object may have waiting.
let max_callouts = 100

-- The most an object's saved state may be, as JSON. /std/login keeps every
-- session in the middle of logging in, so it may keep more.
let max_saved bp (w: World.Current) = if bp == w.paths.login then 1048576 else 65536

-- An object that faults this many times in a row stops working, until its
-- builder fixes it with /update or /reset.
let fault_limit = 5

-- Capacity: what one builder may own at once. It stops one builder from
-- filling the world or the disk; removing things frees it.
let max_owned = 200

let max_files = 100

let max_saved_total = 1048576

-- ── Realms ─────────────────────────────────────────────────────────────

-- The path above a blueprint path, as /r/home for /r/home/ann. None above
-- the root.
let _parent path =
  let segs = String.split "/" path;
  let up = String.join "/" (List.take (List.length segs - 1) segs);
  if up == "" then None else Some up

-- Every path above `path`, nearest first: /r/home/ann, /r/home and /r for
-- /r/home/ann/den.
let _above path =
  match _parent path with
  | Some p -> p :: _above p
  | None -> []

-- A realm's rule, under the same limits as any Library call. A rule does not
-- leave anything to chance: each draw it makes is 0, so asking it again
-- gives the same answer, and asking changes nothing.
let _rule body =
  match Wand.limit limits (fn () ->
    try handle body () with
    | Random!int _ k -> k 0
    | Random!float _ k -> k 0.0
    | Random!seed _ k -> k ()) with
  | Ok r -> r
  | Error why -> Error why

-- The charter of the realm at the head of `chain`, a chain of realms
-- nearest first, as the realm above it gives it. The Commons, with no
-- realm above it, has the empty charter: the Keymasters own its files, and
-- it has no Stewards and no grants. A charter that faults is empty too.
let _charter chain (w: World.Current) =
  match chain with
  | [near :: above :: _] -> (
    match Map.get above w.realms with
    | Some r -> Result.default Driver.Charter() (_rule (fn () -> r.charter near))
    | None -> Driver.Charter()
  )
  | _ -> Driver.Charter()

-- Who owns `path`, a file in the realm at the head of `chain`: what its
-- charter's owner rule says. No rule, or one that faults, is the
-- Keymasters.
let _owner_in chain path (w: World.Current) =
  match (_charter chain w).owner with
  | Some rule -> Option.map String.lower (Result.default None (_rule (fn () -> rule path)))
  | None -> None

-- The realms a blueprint path is in, nearest first, up to the Commons. A
-- realm counts only when the Keymasters own its file, so a Citizen cannot
-- make one in their home.
let realms_of path (w: World.Current) =
  List.fold_left
    (fn chain p -> if !(Map.has? p w.realms) then chain
      else if chain != [] && _owner_in chain p w != None then chain
      else p :: chain)
    []
    (List.reverse (_above path))

-- Who owns the file of blueprint path `path`, by account key, as ann for
-- /r/home/ann/lamp: what the charter of its nearest realm says. A file in
-- no realm is the Keymasters'.
let file_owner path (w: World.Current) = _owner_in (realms_of path w) path w

-- Whether the account `key` is a Steward of the realm at the head of
-- `chain`, or of any realm above it.
let _keeps? key chain (w: World.Current) =
  match chain with
  | [_ :: above] ->
    List.any? (fn s -> Some (String.lower s) == key) (_charter chain w).stewards
    || _keeps? key above w
  | [] -> false

-- Whether the account `key` keeps the area of `path`: it is a Steward of a
-- realm `path` is in, or of the realm whose file `path` is. A Steward
-- changes their realm's own file, so its rules, and everything in it, but
-- not the charter that names them, which is in the realm above.
let steward? key path (w: World.Current) =
  let chain = realms_of path w;
  let own = Map.has? path w.realms && file_owner path w == None;
  _keeps? key (if own then path :: chain else chain) w

-- The one instance of the realm whose file is `path`.
let realm_id path = "%{path}#0"

-- Whether `id` is a realm's instance, which holds the realm's verbs and is
-- no place to be.
let realm? id (w: World.Current) = Map.has? (World.blueprint_of id) w.realms

-- Whether the charter of the nearest realm of the file of `id` grants `g`.
let _granted? id (g: Driver.Grant) (w: World.Current) =
  List.any? (fn x -> x == g) (_charter (realms_of (World.blueprint_of id) w) w).grants

-- Whether the account `key` has a contract to build `path`, from a realm
-- `path` is in.
let contracted? key path (w: World.Current) =
  List.any?
    (fn p -> match Map.get p w.realms with
      | Some r ->
        List.any?
          (fn (c: Driver.Contract) -> Some (String.lower c.builder) == key
          && String.starts_with? "%{c.path}/" path)
          r.contracts
      | None -> false
    )
    (realms_of path w)

-- The realms a room is in, nearest first: the realm it joined, when it
-- joined one outside its directory, and otherwise the realms of its file.
let room_realms room (w: World.Current) = (
  let bp = World.blueprint_of room;
  match Map.get bp w.adopted with
  | Some realm when Map.has? realm w.realms && file_owner realm w == None -> realm :: realms_of realm w
  | _ -> realms_of bp w
)

-- ── Ownership ──────────────────────────────────────────────────────────

-- The account key of a body, when it is one.
let _key_of body (w: World.Current) =
  Option.map (fn (a: World.Account) -> String.lower a.name) (World.account_of body w)

-- The body `actor` saved the file of `path`, for git to commit with its
-- account as the author.
let _wrote actor path (tx: Tx) =
  match _key_of actor tx.w with
  | Some key -> change (World.wrote path key) tx
  | None -> tx

-- Whether an owner is held to no limits: no owner, which is the driver's
-- and the Keymasters' code, or a Keymaster.
let _exempt? owner (w: World.Current) =
  match owner with
  | None -> true
  | Some n -> (
    match World.account n w with
    | Some a -> a.role == "keymaster"
    | None -> false
  )

-- Who owns `id`: its owner, or, for a room not made yet, the owner of its
-- file.
let _owner id (w: World.Current) =
  match World.instance id w with
  | Some i -> i.owner
  | None -> file_owner (World.blueprint_of id) w

-- Code the ownership rules do not hold to: the driver's and the Keymasters'.
let _trusted? id (w: World.Current) = _exempt? (World.owner_of id w) w

-- Whether the owner of `id` is the account of the player `p`.
let _owns? id p (w: World.Current) =
  match (World.owner_of id w, _key_of p w) with
  | (Some o, Some k) -> o == k
  | _ -> false

-- Whether the player `body` may edit the file of blueprint path `path`:
-- a Keymaster may edit any file, a Citizen the files they own and those a
-- contract lets them build, and a Steward the files of the realms that
-- name them.
let may_edit? body path (w: World.Current) =
  match World.account_of body w with
  | Some a ->
    Files.valid? path
    && (a.role == "keymaster"
    || file_owner path w == Some (String.lower a.name)
    || steward? (Some (String.lower a.name)) path w
    || contracted? (Some (String.lower a.name)) path w)
  | None -> false

-- ── The read-only view ─────────────────────────────────────────────────

-- The room an object is in, climbing out of whatever holds it. A room is
-- in nothing, so a room is its own.
let room_of id (w: World.Current) =
  match World.env_of id w with
  | Some e -> room_of e w
  | None -> World.resolve id

let player? id (w: World.Current) = World.blueprint_of id == player_bp w

let players_in room (w: World.Current) =
  List.filter (fn x -> player? x w) (World.contents room w)

-- Every body in the world, asleep or not.
let _players (w: World.Current) =
  List.filter
    (fn x -> player? x w)
    (List.map (fn (i: World.Instance) -> i.id) (Map.values w.instances))

-- Who may enter a new room of blueprint `path`: what its nearest realm
-- says, and everyone in a room outside every realm.
let start_allowed path (w: World.Current) =
  match realms_of path w with
  | [near :: _] -> (
    match Map.get near w.realms with
    | Some r -> r.allowed
    | None -> Driver.Everyone
  )
  | [] -> Driver.Everyone

-- Whether the account `key` reviews request `r`: a Keymaster reviews every
-- request, and a Steward the requests to their realm.
let reviewer? key (r: World.Request) (w: World.Current) =
  Option.some? key && (_exempt? key w || _keeps? key (r.realm :: realms_of r.realm w) w)

-- Whether `body` may go into `room`. Its owner and the Keymasters always may.
-- Anyone else may when the room allows them and its owner has not banned
-- them, and a reviewer may go into the rooms of an open request they
-- review. A room not made yet allows whom its realm says a new one does. Only
-- a body is kept out: anything else may go anywhere it is moved, and a body
-- may go into anything that is not a room.
let may_enter? body room (w: World.Current) =
  let key = _key_of body w;
  let (allowed, owner) =
    match World.instance room w with
    | Some i -> (if i.env != None then Driver.Everyone else i.allowed, i.owner)
    | None -> (let bp = World.blueprint_of room; (start_allowed bp w, file_owner bp w))
  in
  let named =
    match allowed with
    | Driver.Everyone -> true
    | Driver.Only names -> List.any? (fn n -> Some n == key) names
  in
  let banned =
    match (owner, key) with
    | (Some o, Some k) -> World.banned? o k w
    | _ -> false
  in
  let reviewing =
    List.any?
      (fn (r: World.Request) -> r.open
      && List.any? (fn p -> p == World.blueprint_of room) r.rooms
      && reviewer? key r w)
      w.requests;
  !(player? body w)
  || Option.some? key && (key == owner || _exempt? key w)
  || named && !banned
  || reviewing

-- The version of the rules: the number after "version" on the first line
-- of the rules help topic, as 3 in "The rules of WMD, version 3.", and 1
-- when there is none.
let rules_version (w: World.Current) = (
  let first =
    Option.default
      ""
      (Option.and_then (fn t -> List.head (String.lines t)) (Map.get "rules" w.help));
  match Regex.capture r/version (\d+)/ first with
  | [_, n] -> Result.default 1 (String.to_int n)
  | _ -> 1
)

-- Whether the account of `body` has signed the current rules. What the
-- driver made, with no account, has nothing to sign.
let signed? body (w: World.Current) =
  match World.account_of body w with
  | Some a -> (
    match a.rules with
    | Some s -> s.version >= rules_version w
    | None -> false
  )
  | None -> true

-- Where a body goes home to: its account's home, or the arrival room when
-- it has none or its home has closed to it.
let home_of body (w: World.Current) =
  match World.account_of body w with
  | Some a -> (
    match a.home with
    | Some h when may_enter? body h w -> h
    | _ -> arrival w
  )
  | None -> arrival w

-- The world as `viewer` sees it now. Each function answers from this one
-- moment.
let view (w: World.Current) viewer =
  Driver.WorldView(
    contents = fn id -> World.contents id w,
    env_of = fn id -> World.env_of id w,
    short_of = fn id -> _text w viewer id true,
    long_of = fn id -> _text w viewer id false,
    exits_of = fn id -> match World.instance id w with
      | Some i -> i.object.exits
      | None -> Map.empty,
    player? = fn id -> player? id w,
    players = fn () -> _players w,
    account? = fn name -> Option.some? (World.account name w),
    detail_of = fn id name -> match World.instance id w with
      | Some i when i.held -> None
      | Some i ->
        _bounded None (fn () -> Option.map (fn f -> f (_seen w viewer i.id)) (Map.get (String.lower name) i.object.details))
      | None -> None,
    prop = fn id key -> match World.instance id w with
      | Some i -> _bounded None (fn () -> Option.and_then (fn f -> Map.get key (f (_seen w viewer i.id))) i.object.props)
      | None -> None,
    awake? = fn id -> Option.some? (World.session_of id w),
    home_of = fn id -> home_of id w,
    may_enter? = fn b r -> may_enter? b (World.resolve r) w,
    may_edit? = fn b path -> may_edit? b path w,
    made? = fn id -> Option.some? (World.instance id w),
    help_of = fn topic -> Map.get topic w.help
  )
-- The context of an object being looked at by `viewer`.
and _seen (w: World.Current) viewer id =
  Driver.Context(self = id, actor = viewer, here = room_of id w, world = view w viewer, time = w.now)
and _text (w: World.Current) viewer id short =
  match World.instance id w with
  | None -> "nothing"
  | Some i when i.held -> "something waiting for a Keymaster"
  | Some i ->
    _bounded
      "something that is not working"
      (fn () -> if short then i.object.short (_seen w viewer i.id) else i.object.long (_seen w viewer i.id))

let short_of id (w: World.Current) = _text w id id true

let ctx_for (w: World.Current) self actor =
  Driver.Context(
    self = World.resolve self,
    actor = actor,
    here = room_of actor w,
    world = view w actor,
    time = w.now
  )

-- ── The action policy ──────────────────────────────────────────────────

-- An object may move itself, the player whose command it is running, or
-- something it holds. It may reach a thing, not a player, that the player
-- holds or that is in its room.
let _may_move? (ctx: Driver.Context) obj (w: World.Current) =
  let env = World.env_of obj w;
  obj == ctx.self
  || obj == ctx.actor
  || env == Some ctx.self
  || !(player? obj w) && (env == Some ctx.actor || env == Some (room_of ctx.self w))

-- Whether `ctx.self` is the Keymasters' code, or its owner owns `obj` too.
let _same_owner? (ctx: Driver.Context) obj (w: World.Current) =
  _trusted? ctx.self w
  || Option.some? (World.owner_of ctx.self w)
  && World.owner_of ctx.self w == World.owner_of obj w

let _locked? obj (w: World.Current) =
  match World.instance obj w with
  | Some i -> i.locked
  | None -> false

let _from_login? (ctx: Driver.Context) (w: World.Current) =
  World.blueprint_of ctx.self == w.paths.login

let editor_bp (w: World.Current) = w.paths.editor

-- Whether a source claims Driver.Blueprint, as the files the driver loads do.
-- A helper, such as std/text.wand, is saved and not loaded.
let _blueprint? source =
  List.any? (String.starts_with? "implement Driver.Blueprint") (String.lines source)

let _editor? id (w: World.Current) = World.blueprint_of id == editor_bp w

let _broken? id (w: World.Current) =
  match World.instance id w with
  | Some i -> i.faults >= fault_limit
  | None -> false

-- A line too long to show.
let _too_long text =
  if String.length text > max_line then
    Error "a line of %{String.length text} characters, and the most is %{max_line}"
  else Ok()

-- Only an object of a realm that grants MayCheckSave may check or save a
-- file, and only one its actor may edit.
let _may_file (ctx: Driver.Context) path (w: World.Current) =
  if !(_granted? ctx.self Driver.MayCheckSave w) then
    Error "only the editor may check or save a file"
  else if !(may_edit? ctx.actor path w) then Error "%{ctx.actor} may not edit %{path}"
  else Ok()

-- A player is told things by their own commands, by what is in the room
-- with them, and by what their own account owns. A player's own body may
-- tell anyone, as a page does.
let _may_tell? (ctx: Driver.Context) target (w: World.Current) =
  target == ctx.actor
  || ctx.self == ctx.actor
  || room_of target w == room_of ctx.self w
  || _trusted? ctx.self w
  || _owns? ctx.self target w

-- An object makes things in itself, in what it holds, on the player whose
-- command it runs, in the room it is in, or in a place its owner owns.
let _may_spawn_in? (ctx: Driver.Context) dest (w: World.Current) =
  dest == ctx.self
  || dest == ctx.actor
  || World.env_of dest w == Some ctx.self
  || dest == room_of ctx.self w
  || _trusted? ctx.self w
  || Option.some? (World.owner_of ctx.self w) && _owner dest w == World.owner_of ctx.self w

-- The driver's own policy on action `a`, which every realm's rules come
-- after.
let _policy (ctx: Driver.Context) (a: Driver.Action) (w: World.Current) =
  match a with
  | Driver.Say text -> _too_long text
  | Driver.Tell target text -> if World.session? target then
      if _from_login? ctx w then _too_long text else Error "only the login may tell a session"
    else if !(_may_tell? ctx (World.resolve target) w) then
      Error "may not tell %{target}: they are not here"
    else _too_long text
  | Driver.Move obj dest -> (
    let o = World.resolve obj;
    let d = World.resolve dest;
    if World.session? dest then Error "may not move %{o} into a session"
    else if !(_may_move? ctx o w) then Error "may not move %{o}"
    -- A player moves by their own command, or by what their own account
    -- or a Keymaster owns: a room cannot carry off whoever is in it.
    else if player? o w && o != ctx.actor && o != ctx.self && !(_trusted? ctx.self w || _owns? ctx.self o w) then
      Error "may not move %{o}: a player moves by their own command"
    -- Only what its owner owns moves a locked thing.
    else if !(player? o w) && o != ctx.self && _locked? o w && !(_same_owner? ctx o w) then
      Error "may not move %{o}: it is locked"
    else if realm? d w then Error "may not move %{o} into %{d}: a realm is no place"
    else if !(may_enter? o d w) then Error "may not move %{o} into %{d}: it is private"
    -- An editor is private to the one it was opened for.
    else if _editor? d w && Option.and_then (fn (i: World.Instance) -> i.creator) (World.instance d w) != Some o then
      Error "may not move %{o} into %{d}"
    else Ok()
  )
  | Driver.Spawn bp dest -> (
    let d = World.resolve dest;
    if bp == player_bp w || bp == w.paths.login then Error "may not spawn %{bp}"
    else if Map.has? bp w.realms then Error "may not spawn %{bp}: it is a realm"
    else if realm? d w then Error "may not spawn into %{d}: a realm is no place"
    else if !(_may_spawn_in? ctx d w) then
      Error "may not spawn into %{d}: it is not here, and not its owner's"
    else Ok()
  )
  | Driver.Login _ _ _ -> if _from_login? ctx w then Ok()
    else Error "only the login may log in"
  | Driver.Register _ _ _ -> if _from_login? ctx w then Ok()
    else Error "only the login may register"
  | Driver.Hangup _ -> if _from_login? ctx w then Ok() else Error "only the login may hang up"
  | Driver.Remove obj -> (
    let o = World.resolve obj;
    if !(o == ctx.self || World.env_of o w == Some ctx.self) then Error "may not remove %{o}"
    else if o != ctx.self && !(_same_owner? ctx o w) then
      Error "may not remove %{o}: its owner is not this object's"
    else if player? o w || List.any? (fn x -> player? x w) (World.contents o w) then
      Error "may not remove %{o}: a player is or is in it"
    else Ok()
  )
  | Driver.Check path _ -> _may_file ctx path w
  | Driver.Save path _ -> _may_file ctx path w
  | Driver.Draft path _ -> _may_file ctx path w
  | Driver.Run _ -> if _granted? ctx.self Driver.MayCheckSave w then Ok()
    else Error "only the editor may run source"
  | Driver.Acknowledge body -> if _granted? ctx.self Driver.MayAcknowledge w && body == ctx.actor then Ok()
    else Error "only the Rules Hall may say the rules were signed"
  | Driver.After _ _ -> (
    let n = List.length (World.callouts_of ctx.self w);
    if n >= max_callouts then Error "%{n} call-outs waiting, and the most is %{max_callouts}"
    else Ok()
  )

-- What `rule` says of each realm `room` is in, nearest first, given the
-- realm's path and module: the first refusal, or Ok when every realm
-- allows. A rule that faults refuses.
let _realms_say room rule (w: World.Current) =
  List.fold_left
    (fn acc p -> match (acc, Map.get p w.realms) with
      | (Ok _, Some r) -> (
        match _rule (fn () -> rule p r) with
        | Ok said -> said
        | Error _ -> Error "the rules of %{p} are not working"
      )
      | _ -> acc
    )
    Ok()
    (room_realms room w)

-- Whether `ctx.self` may ask for action `a`, and why not: the driver's
-- policy first, then the `allows` rule of every realm the object's room is
-- in. Every rule on what Library code may do is here, in one place.
let allowed (ctx: Driver.Context) (a: Driver.Action) (w: World.Current) =
  match _policy ctx a w with
  | Error why -> Error why
  | Ok _ -> _realms_say (room_of ctx.self w) (fn _ (r: Driver.Realm) -> r.allows ctx a) w

-- Whether `body` may use the command `verb` where it is, and why not.
-- /quit always works.
let _command_ok body verb (w: World.Current) =
  let here = room_of body w;
  if verb == "/quit" then Ok()
  else
    _realms_say
      here
      (fn p (r: Driver.Realm) -> r.commands (ctx_for w (realm_id p) body) verb)
      w

-- ── Capacity and Inspiration ───────────────────────────────────────────

-- Who pays for action `a`: the builder at the editor for a file or a run,
-- and otherwise the owner of the object that asks for it.
let _payer (ctx: Driver.Context) (a: Driver.Action) (w: World.Current) =
  match a with
  | Driver.Check _ _ -> _key_of ctx.actor w
  | Driver.Save _ _ -> _key_of ctx.actor w
  | Driver.Draft _ _ -> _key_of ctx.actor w
  | Driver.Run _ -> _key_of ctx.actor w
  | _ -> World.owner_of ctx.self w

-- What action `a` costs in Inspiration, and what to call it in the log. A
-- run is charged by the steps it took, after it runs.
let _price (a: Driver.Action) =
  match a with
  | Driver.Spawn _ _ -> (Inspiration.spawn_cost, "spawn")
  | Driver.Check _ _ -> (Inspiration.build_cost, "check")
  | Driver.Save _ _ -> (Inspiration.build_cost, "save")
  | _ -> (0, "")

let _size bytes = Size.format (Size.of_bytes bytes)

-- Whether a new file fits the Capacity of `owner`.
-- How many Library files count against the account `key`: those it owns,
-- by the owner rules, and those it builds under a contract.
let file_count key (w: World.Current) =
  List.length
    (List.filter
      (fn f ->
        let p = Scan.path_in w.lib_root f;
        file_owner p w == Some key || contracted? (Some key) p w)
      (Scan.files w.lib_root))

let _file_room owner path (w: World.Current) =
  let n = file_count owner w;
  if Files.exists? w.lib_root path || n < max_files then Ok()
  else
    Error "You have %{n} files, and the most is %{max_files}. Remove one to make another."

-- Whether action `a` fits the Capacity of `owner`.
let _capacity owner (a: Driver.Action) (w: World.Current) =
  match a with
  | Driver.Spawn _ _ -> (
    let n = List.length (World.owned owner w);
    let bytes = World.saved_bytes owner w;
    if n >= max_owned then
      Error "You own %{n} objects, and the most is %{max_owned}. Remove some to make more."
    else if bytes >= max_saved_total then
      Error
        "Your objects keep %{_size bytes} of saved state, and the most is %{_size max_saved_total}."
    else Ok()
  )
  | Driver.Save path _ -> _file_room owner path w
  | Driver.Draft path _ -> _file_room owner path w
  | _ -> Ok()

-- Whether the account `owner` has `cost` Inspiration now, and when it
-- will if not.
let _inspired owner cost (w: World.Current) =
  match World.account owner w with
  | None -> Error "There is no account %{owner} to pay for that."
  | Some acct -> (
    let i = acct.inspiration;
    let have = Inspiration.amount w.now i;
    if have >= cost then Ok()
    else
      Error
        "That needs %{cost} Inspiration, and you have %{have}. You will have enough in %{Inspiration.wait_text (Inspiration.wait w.now cost i)}."
  )

-- Whether `payer` may pay for action `a`, and what it costs them.
let budget payer (a: Driver.Action) (w: World.Current) = (
  let (cost, _) = _price a;
  match payer with
  | Some p when !(_exempt? payer w) -> (
    match _capacity p a w with
    | Error why -> Error why
    | Ok _ -> Result.map (fn _ -> cost) (_inspired p cost w)
  )
  | _ -> Ok 0
)

-- Spend `cost` of the Inspiration of `payer`.
let _spend payer cost (tx: Tx) =
  match payer with
  | Some p when cost > 0 && !(_exempt? payer tx.w) ->
    change (World.spend p cost tx.w.now) tx
  | _ -> tx

-- Spend `cost` of the Inspiration of `payer` on `what`, and log it.
let _charge payer cost what (tx: Tx) =
  match payer with
  | Some p when cost > 0 && !(_exempt? payer tx.w) ->
    tx
    |> _spend payer cost
    |> _event World.Event(
      at = "",
      event = "inspiration",
      actor = p,
      text = Some "%{cost} for %{what}"
    )
  | _ -> tx

-- Tell the player whose command it is why it was refused, when it was
-- theirs to pay for.
let _tell_payer (ctx: Driver.Context) payer why (tx: Tx) =
  if Option.some? payer && _key_of ctx.actor tx.w == payer then
    change (World.tell ctx.actor why) tx
  else tx

-- A driver command that costs `cost`: run `k` when the account of `body`
-- can pay, and charge it.
let _pay body cost what k (tx: Tx) = (
  let payer = _key_of body tx.w;
  match payer with
  | Some p when !(_exempt? payer tx.w) -> (
    match _inspired p cost tx.w with
    | Error why -> change (World.tell body why) tx
    | Ok _ -> k (_charge payer cost what tx)
  )
  | _ -> k tx
)

let _fits? (arg: Driver.Arg) (f: Parse.Found) holder =
  match arg with
  | Driver.NoArg -> true
  | Driver.This -> Parse.found? holder f
  | Driver.AnyObj -> Option.some? (Parse.found_id f)

-- The first verb that answers: on the player, then the room, then the
-- direct object, then the indirect one, then each realm the room is in,
-- nearest first, up to the Commons.
let _find (w: World.Current) holders verb dobj iobj =
  List.head
    (List.filter_map
      (fn h -> match World.instance h w with
        | None -> None
        | Some i ->
          Option.map
            (fn v -> (h, v))
            (List.find
              (fn (v: Driver.Verb) -> List.any? (fn n -> Driver.names? n verb) v.names
              && _fits? v.dobj dobj h
              && _fits? v.iobj iobj h)
              i.object.verbs)
      )
      holders)

-- Whose verbs a command of `body` in `here` may run, in the order they are
-- asked: the body, the room, the objects the command names, then each
-- realm the room is in.
let _holders body here named (w: World.Current) =
  List.unique (List.flatten [[body, here], named, List.map realm_id (room_realms here w)])

-- ── Spawning ───────────────────────────────────────────────────────────

-- Make instance `id` of blueprint `bp` inside `dest`, owned by `owner`, and
-- apply the actions its `create` asks for. Nothing happens for a blueprint
-- that is not in the lib, or a create that raises; the event log says
-- which.
let _create id bp saved dest owner (tx: Tx) =
  match Map.get bp tx.w.lib with
  | None -> _event (World.Event(at = "", event = "refused", actor = id, text = Some "no blueprint %{bp}")) tx
  | Some b -> (
    match _call (fn () -> b.create id saved) with
    | Error why -> _event (World.Event(at = "", event = "fault", actor = id, text = Some why)) tx
    | Ok init ->
      tx
      |> change
        (World.put
          (World.Instance(
            id = id,
            blueprint = bp,
            object = init.object,
            env = dest,
            created = Some tx.at,
            owner = owner,
            -- A room starts open to whom its realm says.
            allowed = start_allowed bp tx.w
          )))
      |> _apply_actions (ctx_for tx.w id id) init.actions
  )

-- Make sure `id` exists: a room named by an exit is spawned the first time
-- someone goes there. It is owned by the owner of its file.
and _ensure id (tx: Tx) =
  let full = World.resolve id;
  if Option.some? (World.instance full tx.w) then tx
  else _create full (World.blueprint_of full) None None (file_owner (World.blueprint_of full) tx.w) tx

-- A new instance of `bp` in `dest`, made by `actor`'s command and owned by
-- `owner`.
and spawn bp dest actor owner (tx: Tx) =
  let id = "%{bp}#%{World.next_number bp tx.w}";
  tx
  |> _ensure dest
  |> _create id bp None (Some (World.resolve dest)) owner
  |> change (fn w -> World.set_made id (Some actor) (Some tx.at) None w)
  |> _event (World.Event(at = "", event = "spawn", actor = actor, object = Some id))
  |> _hook "enter" dest id actor

-- ── Hooks ──────────────────────────────────────────────────────────────

-- Call `container`'s on_enter or on_leave for `mover`. The hook's own
-- moves call no hooks.
and _hook which container mover actor (tx: Tx) =
  match (tx.hooks, World.instance container tx.w) with
  | (true, Some i) -> (
    let f = if which == "enter" then i.object.on_enter else i.object.on_leave;
    match f with
    | None -> tx
    | Some h -> (
      let ctx = ctx_for tx.w i.id actor;
      Tx(run ctx (fn () -> h ctx mover) Tx(tx, hooks = false), hooks = true)
    )
  )
  | _ -> tx

-- ── Actions ────────────────────────────────────────────────────────────

and _refuse (ctx: Driver.Context) why (tx: Tx) =
  _event (World.Event(at = "", event = "refused", actor = ctx.self, text = Some why)) tx

and _say (ctx: Driver.Context) text (tx: Tx) =
  List.fold_left
    (fn acc p -> change (World.tell p text) acc)
    tx
    (players_in (room_of ctx.self tx.w) tx.w)

-- Move `obj` into `dest`. A player who moves looks around, and then the
-- place left and the place entered hear of it.
and _move (ctx: Driver.Context) obj dest (tx: Tx) =
  let from = World.env_of obj tx.w;
  let ensured = _ensure dest tx;
  -- A room that is gone, or cannot be made, is no place to go: a body goes
  -- home instead, and anything else stays where it is.
  let target =
    if Option.some? (World.instance dest ensured.w) then Some dest
    else if player? obj tx.w then Some (home_of obj ensured.w)
    else None;
  let moved =
    match target with
    | Some t ->
      ensured
      |> _ensure t
      |> change (World.move obj t)
      |> (if player? obj tx.w then _ensure_exits (World.resolve t) else fn x -> x)
    | None -> ensured;
  let looked = if player? obj tx.w then look obj moved else moved;
  let explored =
    match target with
    | Some t when player? obj tx.w -> _explore obj (World.resolve t) looked
    | _ -> looked;
  let left =
    match from with
    | Some f -> _hook "leave" f obj ctx.actor explored
    | None -> explored;
  match target with
  | Some t -> _hook "enter" (World.resolve t) obj ctx.actor left
  | None -> left

-- Make the rooms the exits of `room` lead to, so a player who arrives can
-- look through them.
and _ensure_exits room (tx: Tx) =
  match World.instance room tx.w with
  | Some i -> List.fold_left (fn acc (e: Driver.Exit) -> _ensure e.to acc) tx (Map.values i.object.exits)
  | None -> tx

-- The first visit of a body to a public room another Citizen built, or
-- owns, gives its account an exploring bonus, up to
-- `Inspiration.bonuses_a_day` rooms a day, and the room's builder as much,
-- with no cap: each visitor counts once.
and _explore body room (tx: Tx) =
  let builder =
    match Map.get (World.blueprint_of room) tx.w.built with
    | Some b -> Some b
    | None -> World.owner_of room tx.w;
  match (World.account_of body tx.w, builder) with
  | (Some a, Some o) when World.env_of room tx.w == None
    && Option.map World.public? (World.instance room tx.w) == Some true
    && o != String.lower a.name
    && !(Map.has? room a.explored)
    && Inspiration.today tx.w.now a.explored < Inspiration.bonuses_a_day ->
    tx
    |> change (World.inspire a.name room tx.w.now)
    |> _event World.Event(at = "", event = "inspired", actor = body, room = Some room)
    |> change (World.tell body "You feel inspired.")
    -- Its builder earns as much, once for each new visitor.
    |> change (World.reward o tx.w.now)
    |> _event World.Event(at = "", event = "rewarded", actor = o, room = Some room, name = Some a.name)
  | _ -> tx

-- Check action `a` against the policy, then against the Capacity and
-- Inspiration of whoever pays for it, and do it.
and _act (ctx: Driver.Context) (a: Driver.Action) (tx: Tx) =
  match allowed ctx a tx.w with
  | Error why -> _refuse ctx why tx
  | Ok _ -> (
    let payer = _payer ctx a tx.w;
    match budget payer a tx.w with
    | Error why -> _short ctx a why (_refuse ctx why tx)
    | Ok cost -> (let (_, what) = _price a; _do ctx payer a (_charge payer cost what tx))
  )

-- Tell why an action was more than its payer had: the editor, through its
-- `result` verb, for a file, and otherwise the player who paid.
and _short (ctx: Driver.Context) (a: Driver.Action) why (tx: Tx) =
  let failed action path =
    Driver.Outcome(
      action = action,
      path = path,
      ok = false,
      problems = [Driver.Problem(severity = "error", line = 1, col = 1, message = why)]
    );
  match a with
  | Driver.Check path _ -> _answer ctx (failed "check" path) tx
  | Driver.Save path _ -> _answer ctx (failed "save" path) tx
  | Driver.Draft path _ -> _answer ctx (failed "draft" path) tx
  | _ -> _tell_payer ctx (_payer ctx a tx.w) why tx

and _do (ctx: Driver.Context) payer (a: Driver.Action) (tx: Tx) =
  match a with
  | Driver.Say text -> _say ctx text tx
  | Driver.Tell target text -> change (World.tell target text) tx
  | Driver.Move obj dest -> _move ctx (World.resolve obj) dest tx
  | Driver.Spawn bp dest -> spawn bp dest ctx.actor payer tx
  | Driver.Login sid name typed -> login sid name typed tx
  | Driver.Register sid name typed -> register sid name typed tx
  | Driver.Hangup sid -> change (World.close_soon sid) tx
  | Driver.Remove obj ->
    tx
    |> change (World.remove obj)
    |> _event (World.Event(at = "", event = "remove", actor = ctx.actor, object = Some (World.resolve obj)))
  | Driver.Check path source -> _answer ctx (Files.check tx.w.lib_root path source) tx
  | Driver.Save path source -> _save ctx path source tx
  | Driver.Draft path source -> (
    let fresh = !(Files.exists? tx.w.lib_root path);
    let o = Files.draft tx.w.lib_root path source;
    _answer ctx o (if o.ok then _saved ctx.actor path fresh tx else tx)
  )
  | Driver.Run source -> eval ctx.actor source tx
  | Driver.Acknowledge body -> _signed body tx
  | Driver.After wait name -> change (World.call_out ctx.self (tx.w.now + wait) name) tx

-- Save, and write the list of blueprints again, so a new one loads at
-- the next start.
-- A save that passes loads the new code at once, as /update does.
and _save (ctx: Driver.Context) path source (tx: Tx) =
  let fresh = !(Files.exists? tx.w.lib_root path);
  let o = Files.save tx.w.lib_root path source;
  let answered = _answer ctx o (if o.ok then _saved ctx.actor path fresh tx else tx);
  if o.ok && _blueprint? source then update ctx.actor path answered else answered

-- A file was saved by the player `actor`: each open request it is in notes
-- it, and a new one was built by them.
and _saved actor path fresh (tx: Tx) =
  let noted = tx |> change (World.touched path) |> _wrote actor path;
  match _key_of actor tx.w with
  | Some key when fresh -> change (World.set_built path key) noted
  | _ -> noted

-- Load the file of `path` again, and move every instance of it onto the
-- new code: the old `save` gives each one's state, and the new `create`
-- takes it. An instance whose state the new code cannot read stays on the
-- old code and is named. A file that does not load changes nothing.
and update actor path (tx: Tx) =
  match Wand.load Driver.Blueprint.loader (Files.file_of tx.w.lib_root path) with
  | Error why ->
    tx
    |> _event (World.Event(at = "", event = "update_refused", actor = actor, object = Some path, text = Some why))
    |> change (World.tell actor "%{path} was not updated: %{why}")
  | Ok b -> (
    let before = if path == editor_bp tx.w then Map.get path tx.w.lib else tx.w.editor_before;
    let tx = change (fn w -> World.Current(w, editor_before = before)) tx;
    let (moved, kept) =
      List.fold_left
        (fn (acc, kept) id -> match World.instance id acc.w with
          | None -> (acc, kept)
          | Some i -> (
            match _call (fn () -> b.create id (Some (i.object.save ()))) with
            | Ok init -> (change (World.set_object id init.object tx.at) acc, kept)
            | Error _ -> (acc, List.concat kept [id])
          ))
        (change (World.set_blueprint path b) tx, [])
        (World.instances_of path tx.w);
    let n = List.length (World.instances_of path tx.w) - List.length kept;
    let told =
      if kept == [] then "Updated %{path}: %{n} instances on the new code."
      else "Updated %{path}: %{n} instances on the new code. Kept on the old code, because the new code cannot read their saved state: %{String.join ", " kept}. Fix the file and /update it again, or /reset them.";
    moved
    |> _event (World.Event(at = "", event = "update", actor = actor, object = Some path, text = Some "%{n} moved, %{List.length kept} kept"))
    |> change (World.tell actor told)
    |> _update_realm actor path
  )

-- A file that is a realm too: load its rules again, and make its instance
-- when the realm is new. Rules that do not load leave the old ones. A file
-- that no longer claims Driver.Realm is a realm no more.
and _update_realm actor path (tx: Tx) =
  if !(Scan.claims? "Realm" (Option.default "" (Files.read tx.w.lib_root path))) then
    change (fn w -> World.Current(w, realms = Map.delete path w.realms)) tx
  else match Wand.load Driver.Realm.loader (Files.file_of tx.w.lib_root path) with
    | Error why -> change (World.tell actor "The rules of %{path} were not updated: %{why}") tx
    | Ok r -> tx |> change (World.set_realm path r) |> _ensure (realm_id path)

-- Make instances again as `create` makes a new one, and apply its starting
-- actions again. Each keeps its id, its place and who made it. A body
-- keeps its name, which is its account's. Its call-outs are dropped: the
-- starting actions make again the ones a new instance has.
and reset actor ids (tx: Tx) =
  List.fold_left
    (fn acc id -> match World.instance id acc.w with
      | None -> acc
      | Some i -> (
        match Map.get i.blueprint acc.w.lib with
        | None -> change (World.tell actor "%{id} has no blueprint loaded.") acc
        | Some b -> (
          let saved =
            match World.account_of id acc.w with
            | Some a -> Some (JSON.of_map (Map.from_list [("name", JSON.of_string a.name)]))
            | None -> None;
          match _call (fn () -> b.create id saved) with
          | Error why -> change (World.tell actor "%{id} was not reset: %{why}") acc
          | Ok init ->
            acc
            |> change (World.set_object id init.object tx.at)
            |> change (World.drop_callouts id)
            |> _apply_actions (ctx_for acc.w id id) init.actions
            |> _event (World.Event(at = "", event = "reset", actor = actor, object = Some id))
            |> change (World.tell actor "Reset %{id}.")
        )
      ))
    tx
    ids

-- /eval: run `expr` for `body`, as Library code runs: checked, gated, and
-- under the limits. A list of actions is checked and applied as the
-- body's own; any other value is shown with its type. It costs the steps
-- it took, so it needs some Inspiration left to start.
and eval body expr (tx: Tx) =
  let payer = _key_of body tx.w;
  let ready = if _exempt? payer tx.w then Ok() else _inspired (Option.default "" payer) 1 tx.w;
  match ready with
  | Error why -> change (World.tell body why) tx
  | Ok _ -> _eval body payer expr tx

and _eval body payer expr (tx: Tx) =
  match Evaluate.load tx.w.lib_root tx.w.paths.driver expr with
  | Error errors ->
    tx
    |> _event (World.Event(at = "", event = "eval_refused", actor = body, text = Some expr))
    |> change (World.tell body (String.join "\n" errors))
  | Ok m -> (
    let ctx = ctx_for tx.w body body;
    let (r, steps) = _counted (fn () -> m.evaluate ctx);
    let logged =
      _event (World.Event(at = "", event = "eval", actor = body, text = Some "%{expr} (%{steps} steps)")) tx
      |> _charge payer (Inspiration.of_steps steps) "eval";
    match r with
    | Error why -> change (World.tell body "Something went wrong: %{why}") logged
    | Ok (Driver.Shown text) -> change (World.tell body "=> %{text}") logged
    | Ok (Driver.Acts actions) ->
      logged
      |> apply ctx (Driver.Reply(actions = actions))
      |> change (World.tell body "=> %{List.length actions} actions")
  )

-- Log the driver's answer to a check or a save, with the errors or the
-- effects, and give it to the editor through its `result` verb.
and _answer (ctx: Driver.Context) (o: Driver.Outcome) (tx: Tx) =
  let errors =
    List.map
      (fn (p: Driver.Problem) -> "%{p.line}:%{p.col}: %{p.message}")
      (List.filter (fn (p: Driver.Problem) -> p.severity == "error") o.problems);
  let found =
    if o.ok then "effects: %{if o.effects == [] then "none" else String.join ", " o.effects}"
    else String.join "; " errors;
  tx
  |> _event
    (World.Event(
      at = "",
      event = if o.ok then o.action else "%{o.action}_refused",
      actor = ctx.actor,
      object = Some o.path,
      text = Some found
    ))
  |> verb_with ctx.self ctx.actor (Driver.Parsed(verb = "result", rest = JSON.stringify (Driver.Outcome.encoder o)))

and _apply_actions (ctx: Driver.Context) actions (tx: Tx) =
  List.fold_left (fn acc a -> _act ctx a acc) tx actions

-- Apply what a call on `ctx.self` gave back. A reply with more actions
-- than `max_actions` is refused whole: its object keeps its old version.
and apply (ctx: Driver.Context) (r: Driver.Reply) (tx: Tx) =
  if List.length r.actions > max_actions then
    _refuse ctx "%{List.length r.actions} actions in one reply, and the most is %{max_actions}" tx
  else _apply ctx r tx

and _apply (ctx: Driver.Context) (r: Driver.Reply) (tx: Tx) = (
  let kept =
    match r.next with
    | Some o -> change (World.set_object ctx.self o tx.at) tx
    | None -> tx;
  _apply_actions ctx r.actions kept
)

-- Run a reply-giving Library call, and apply its reply. A raise is a fault:
-- the actor is told, and the event log keeps why.
-- An object that has faulted `fault_limit` times in a row runs no more
-- code until /update or /reset gives it a new start.
and run (ctx: Driver.Context) body (tx: Tx) = (let (ran, _) = run_counted ctx body tx; ran)

-- `run`, with the steps the call took.
and run_counted (ctx: Driver.Context) body (tx: Tx) =
  if _broken? ctx.self tx.w then
    (change (World.tell ctx.actor "%{short_of ctx.self tx.w} is not working.") tx, 0)
  else if Option.map (fn (i: World.Instance) -> i.held) (World.instance ctx.self tx.w) == Some true then
    (change (World.tell ctx.actor "That is waiting for a Keymaster.") tx, 0)
  else match _counted body with
    | (Ok r, steps) -> (tx |> change (World.worked ctx.self) |> apply ctx r, steps)
    | (Error why, steps) -> (
      let faulted =
        tx
        |> change (World.tell ctx.actor "Something went wrong with %{short_of ctx.self tx.w}.")
        |> _event (World.Event(at = "", event = "fault", actor = ctx.actor, object = Some ctx.self, text = Some why))
        |> change (World.faulted ctx.self);
      let broken =
        if _broken? ctx.self faulted.w then
          faulted
          |> _event (World.Event(at = "", event = "broken", actor = ctx.actor, object = Some ctx.self))
          |> change (World.tell ctx.actor "%{short_of ctx.self tx.w} has stopped working. Its builder can fix it and /update it, or /reset it.")
        else faulted;
      (_fall_back ctx.self ctx.actor broken, steps)
    )

-- An editor that faults goes back to the editor before the last /update
-- of it, so a bad update of the editor can be fixed with the editor.
and _fall_back self actor (tx: Tx) =
  match (_editor? self tx.w, tx.w.editor_before, World.instance self tx.w) with
  | (true, Some b, Some i) -> (
    match _call (fn () -> b.create i.id (Some (i.object.save ()))) with
    | Ok init ->
      tx
      |> change (World.set_blueprint (editor_bp tx.w) b)
      |> change (World.set_object i.id init.object tx.at)
      |> change (World.tell actor "The editor is back on its version from before the last /update of it.")
    | Error _ -> tx
  )
  | _ -> tx

-- Run the verb named `name` on `self`, with no arguments.
and verb self actor name (tx: Tx) = verb_with self actor (Driver.Parsed(verb = name)) tx

-- Run the verb `p.verb` on `self`, with `p` as its command.
and verb_with self actor (p: Driver.Parsed) (tx: Tx) =
  match World.instance self tx.w with
  | None -> tx
  | Some i -> (
    match List.find (fn (v: Driver.Verb) -> List.any? (fn n -> Driver.names? n p.verb) v.names) i.object.verbs with
    | None -> tx
    | Some v -> (
      let ctx = ctx_for tx.w i.id actor;
      run ctx (fn () -> v.run ctx p) tx
    )
  )

-- `look`, for a body that moved: the first `look` its holders answer to,
-- as when the player types it.
and look body (tx: Tx) =
  let here = room_of body tx.w;
  match _find tx.w (_holders body here [] tx.w) "look" Parse.NoWords Parse.NoWords with
  | Some(h, v) -> (
    let ctx = ctx_for tx.w h body;
    run ctx (fn () -> v.run ctx (Driver.Parsed(verb = "look"))) tx
  )
  | None -> tx

-- ── Login ──────────────────────────────────────────────────────────────

-- Attach a session to the body of `name`, making the account and its body
-- the first time.
-- Log a session in, when the password is the account's. A wrong one is
-- logged, with the name tried and never the password.
and login sid name typed (tx: Tx) =
  match World.account name tx.w with
  | Some acct when Password.matches? tx.w.pepper acct.password typed ->
    if acct.paused then
      tx
      |> _event (World.Event(at = "", event = "login_paused", actor = sid, name = Some acct.name))
      |> change (World.tell sid "A Keymaster has paused %{acct.name}. What is your name?")
    else if Option.some? (World.session_of acct.body tx.w) then
      change (World.tell sid "%{acct.name} is here already. What is your name?") tx
    else _wake sid acct.name acct.body "%{acct.name} wakes up." tx
  | _ ->
    tx
    |> _event (World.Event(at = "", event = "login_failed", actor = sid, name = Some name))
    |> change (World.tell sid "That name and password do not match. What is your name?")

-- Make an account and its body. The password is kept only as its hash,
-- with a salt made for it and the server's pepper.
and register sid name typed (tx: Tx) =
  if Option.some? (World.account name tx.w) then
    change (World.tell sid "%{name} was taken just now. What is your name?") tx
  else (
    let body = "%{(player_bp tx.w)}#%{World.next_number (player_bp tx.w) tx.w}";
    let saved = JSON.of_map (Map.from_list [("name", JSON.of_string name)]);
    let hashed = Password.hash tx.w.pepper (Random.hex 32) typed;
    tx
    |> _ensure (rules_hall tx.w)
    |> _create body (player_bp tx.w) (Some saved) (Some (rules_hall tx.w)) (Some (String.lower name))
    |> change (World.add_account (World.Account(name = name, body = body, password = hashed, created = Some tx.w.now)))
    |> _hook "enter" (rules_hall tx.w) body body
    |> _event (World.Event(at = "", event = "signup", actor = sid, name = Some name, object = Some body))
    |> _wake sid name body "%{name} arrives."
  )

-- Attach a session to its body. A body whose account has not signed the
-- current rules wakes in the Rules Hall, and notices kept while it slept
-- are told.
and _wake sid name body news (tx: Tx) =
  let (woke: Tx) =
    tx
    |> change (World.attach sid body)
    |> verb (login_id tx.w) sid "done"
    |> _event (World.Event(at = "", event = "login", actor = sid, name = Some name, object = Some body))
    |> change (World.tell body "Hello, %{name}.")
    |> _to_hall body;
  woke |> _tell_room (room_of body woke.w) body news |> _tell_notices body |> look body

and _to_hall body (tx: Tx) =
  if signed? body tx.w || room_of body tx.w == (rules_hall tx.w) then tx
  else tx |> _ensure (rules_hall tx.w) |> change (World.move body (rules_hall tx.w))

and _tell_notices body (tx: Tx) =
  match World.account_of body tx.w with
  | Some a when a.notices != [] ->
    tx |> change (World.tell body (String.join "\n" a.notices)) |> change (World.noticed a.name)
  | _ -> tx

-- A body signed the current rules: keep that on its account, and take the
-- body to the Commons, which hears it arrive.
and _signed body (tx: Tx) =
  match World.account_of body tx.w with
  | None -> tx
  | Some a ->
    tx
    |> change (World.sign a.name (rules_version tx.w) tx.w.now)
    |> _event World.Event(at = "", event = "signed", actor = body, text = Some "version %{rules_version tx.w}")
    |> _tell_room (arrival tx.w) body "%{short_of body tx.w} arrives."
    |> _move (ctx_for tx.w body body) body (arrival tx.w)

and _tell_room room except text (tx: Tx) =
  List.fold_left
    (fn acc p -> if p == except then acc else change (World.tell p text) acc)
    tx
    (players_in room tx.w)

-- ── Commands ───────────────────────────────────────────────────────────

-- `"Hello.` is `say Hello.`, and `:sits.` is `pose sits.`. The driver
-- rewrites the prefix and nothing else; the commands are the player's verbs.
let _expand line =
  let rest = String.slice 1 (String.length line) line;
  if String.starts_with? `"` line then "say %{rest}"
  else if String.starts_with? ":" line then "pose %{rest}"
  else line

-- Why nothing answered, in words the player can act on.
let _unmatched (w: World.Current) verb (dobj: Parse.Found) =
  match dobj with
  | Parse.Missing words -> "You don't see a '%{words}' here."
  | Parse.Ambiguous words ids ->
    String.join
      "\n"
      ("Which %{words}?" :: List.map (fn (n, id) -> "  %{n + 1}. %{short_of id w}") (List.indexed ids))
  | _ -> `I don't know how to "%{verb}".`

let _list o =
  match o with
  | Some x -> [x]
  | None -> []

-- Match a line to a verb and run it. A bare exit name, of one word or
-- more, is `go` that way.
let command body line (tx: Tx) = (
  let here = room_of body tx.w;
  let verb = String.lower (Option.default "" (String.word 0 line));
  let rest = String.trim (String.slice (String.length verb) (String.length line) line);
  let words = Parse.split (String.words rest);
  let dobj = Parse.resolve tx.w body here words.dobj;
  let iobj = Parse.resolve tx.w body here words.iobj;
  let holders =
    _holders
      body
      here
      (List.concat (_list (Parse.found_id dobj)) (_list (Parse.found_id iobj)))
      tx.w;
  match _find tx.w holders verb dobj iobj with
  | Some(h, v) -> (
    let ctx = ctx_for tx.w h body;
    let parsed =
      Driver.Parsed(
        verb = verb,
        dobj = Parse.found_id dobj,
        prep = words.prep,
        iobj = Parse.found_id iobj,
        rest = rest
      );
    run ctx (fn () -> v.run ctx parsed) tx
  )
  | None -> (
    -- The whole line, so an exit of several words, as "the commons", is
    -- one too.
    match Option.and_then
      (fn (r: World.Instance) -> Driver.exit_named line r.object.exits)
      (World.instance here tx.w) with
    | Some(name, _) -> command body "go %{name}" tx
    | None -> change (World.tell body (_unmatched tx.w verb dobj)) tx
  )
)

-- ── Input ──────────────────────────────────────────────────────────────

let _who body (w: World.Current) =
  let names =
    List.sort
      (List.filter_map
        (fn (s: World.Session) -> Option.map (fn b -> short_of b w) s.body)
        (Map.values w.sessions));
  World.tell body "%{List.length names} connected: %{String.join ", " names}." w

let _after_verb line =
  String.trim
    (String.slice
      (String.length (Option.default "" (String.word 0 line)))
      (String.length line)
      line)

-- One player, by account name: awake or when last seen, and what they
-- look like.
let _who_is body name (w: World.Current) =
  match World.account name w with
  | None -> World.tell body "There is no one called %{name}." w
  | Some a -> (
    let seen =
      (if Option.some? (World.session_of a.body w) then "%{a.name} is awake."
       else match a.last_seen with
         | Some at -> "%{a.name} was last seen %{at}."
         | None -> "%{a.name} has not been seen yet.");
    World.tell body "%{seen}\n%{_text w body a.body false}" w
  )

let _or_none xs = if xs == [] then "nothing" else String.join ", " xs

-- Who may enter a room, or move a thing, in words.
let _access (i: World.Instance) (w: World.Current) =
  if player? i.id w then "its own"
  else if i.env == None then
    match i.allowed with
    | Driver.Everyone -> "public"
    | Driver.Only [] -> "private"
    | Driver.Only names -> "private, and open to %{String.join ", " names}"
  else if i.locked then "locked"
  else "unlocked"

-- What the driver knows of an object: for builders, who need to see what
-- the text of a room does not say.
let _examine body words (w: World.Current) = (
  let here = room_of body w;
  let found =
    if words == "" then Parse.Found here else Parse.resolve w body here (String.words words);
  match found with
  | Parse.Found id -> (
    match World.instance id w with
    | None -> World.tell body "There is no %{id}." w
    | Some i -> (
      let props =
        (match i.object.props with
         | Some f ->
           List.map
             (fn (k, v) -> "%{k} = %{JSON.stringify v}")
             (Map.to_list (_bounded Map.empty (fn () -> f (_seen w body i.id))))
         | None -> []);
      let lines =
        [
          "%{i.id}: %{short_of i.id w}",
          "  in: %{Option.default "nothing" i.env}",
          "  holds: %{_or_none (World.contents i.id w)}",
          "  made by: %{Option.default "the driver" i.creator}, %{Option.default "at boot" i.created}",
          "  owner: %{Option.default "the Keymasters" i.owner}",
          "  access: %{_access i w}",
          "  changed: %{Option.default "never" i.modified}",
          "  props: %{_or_none props}",
          "  verbs: %{_or_none (List.flatten (List.map (fn (v: Driver.Verb) -> v.names) i.object.verbs))}",
          "  exits: %{_or_none (Map.keys i.object.exits)}",
          "  details: %{_or_none (Map.keys i.object.details)}",
          "  heartbeat: %{if Option.some? i.object.heartbeat then "yes" else "no"}",
          "  call-outs: %{_or_none (List.map (fn (c: World.Callout) -> "%{c.verb} at %{c.due}") (World.callouts_of i.id w))}"
        ];
      World.tell body (String.join "\n" lines) w
    )
  )
  | _ -> World.tell body "You don't see a '%{words}' here." w
)

-- The blueprint path `/edit` names: the room's, an object's by name, or
-- one written out, as /r/home/ann/lamp.
let _edit_target body words (w: World.Current) = (
  let here = room_of body w;
  if words == "" || words == "here" then Ok (World.blueprint_of here)
  else if String.starts_with? "/" words then
    Ok
      (if String.ends_with? ".wand" words then String.slice 0 (String.length words - 5) words
      else words)
  else match Parse.resolve w body here (String.words words) with
    | Parse.Found id -> Ok (World.blueprint_of id)
    | _ -> Error "You don't see a '%{words}' here."
)

let _editor_state path lines here evaluating =
  JSON.of_map
    (Map.from_list [
      ("path", JSON.of_string path),
      ("lines", JSON.of_list (List.map JSON.of_string lines)),
      ("cur", JSON.of_int (List.length lines)),
      ("origin", JSON.of_string here),
      ("eval", JSON.of_bool evaluating)
    ])

-- An editor with `state`, for `body`: a new one of its own, or, from inside
-- one, the same editor with the new state.
let _open_editor body state opened (tx: Tx) =
  let here = room_of body tx.w;
  if _editor? here tx.w then
    verb_with here body Driver.Parsed(verb = "open", rest = JSON.stringify state) tx
  else (
    let id = "%{editor_bp tx.w}#%{World.next_number (editor_bp tx.w) tx.w}";
    tx
    |> _create id (editor_bp tx.w) (Some state) None None
    |> change (World.set_made id (Some body) (Some tx.at) None)
    |> _event World.Event(at = "", event = "spawn", actor = body, object = Some id)
    |> _tell_room here body "%{short_of body tx.w} leaves for the editor."
    |> change (World.tell body opened)
    |> _move (ctx_for tx.w body body) body id
  )

-- /eval with no expression: an editor buffer, whose `w` runs it.
let _eval_buffer body (tx: Tx) =
  _open_editor
    body
    (_editor_state "" [] (room_of body tx.w) true)
    "An /eval buffer. Add the expression with a, then w runs it."
    tx

-- Open the editor on the file of `path` for `body`: a new editor of its
-- own, or, from inside one, the same editor on another file.
let _edit body words (tx: Tx) =
  match _edit_target body words tx.w with
  | Error why -> change (World.tell body why) tx
  | Ok path -> if !(Files.valid? path) then
      change
        (World.tell
          body
          "'%{path}' is not a Library path. One looks like %{tx.w.paths.homes}/ann/lamp.")
        tx
    else if !(may_edit? body path tx.w) then
      change
        (World.tell
          body
          "You may not edit %{path}. A Citizen edits the files in their home, %{tx.w.paths.homes}/<name>/.")
        tx
    else (
      let text = Files.read tx.w.lib_root path;
      let lines =
        (match text with
         | Some t -> String.lines t
         | None -> []);
      let state = _editor_state path lines (room_of body tx.w) false;
      let opened =
        if text == None then "%{path} is a new file."
        else "%{path}: %{List.length lines} lines.";
      _open_editor body state opened tx
    )

-- /update: load a file's new code, for a blueprint the player may edit.
let _update body words (tx: Tx) =
  match _edit_target body words tx.w with
  | Error why -> change (World.tell body why) tx
  | Ok path -> if !(Files.valid? path) then
      change (World.tell body "'%{path}' is not a Library path.") tx
    else if !(may_edit? body path tx.w) then
      change (World.tell body "You may not update %{path}.") tx
    else _pay body Inspiration.build_cost "update" (update body path) tx

-- The instances /reset names: here, me, an object by name, an instance id,
-- or a blueprint path for every instance of it.
let _reset_targets body words (w: World.Current) = (
  let here = room_of body w;
  if words == "" then Error "Reset what? Name an object, here, me, or a path."
  else if words == "here" then Ok [here]
  else if words == "me" then Ok [body]
  else if String.starts_with? "/" words then
    if String.contains? "#" words then
      if Option.some? (World.instance words w) then Ok [words]
      else Error "There is no %{words}."
    else Ok (World.instances_of words w)
  else match Parse.resolve w body here (String.words words) with
    | Parse.Found id -> Ok [id]
    | _ -> Error "You don't see a '%{words}' here."
)

-- /reset: an instance whose blueprint the player may edit, or their own
-- body.
let _reset body words (tx: Tx) =
  match _reset_targets body words tx.w with
  | Error why -> change (World.tell body why) tx
  | Ok [] -> change (World.tell body "There is nothing to reset.") tx
  | Ok ids -> (
    let refused =
      List.filter
        (fn id -> id != body && !(may_edit? body (World.blueprint_of id) tx.w))
        ids;
    if refused != [] then
      change (World.tell body "You may not reset %{String.join ", " refused}.") tx
    else _pay body (Inspiration.build_cost * List.length ids) "reset" (reset body ids) tx
  )

-- What /verbs and /copy name: the room with here or nothing,
-- the body with me, or a thing by name.
let _named body words (w: World.Current) =
  let here = room_of body w;
  if words == "" || words == "here" then Parse.Found here
  else if words == "me" then Parse.Found body
  else Parse.resolve w body here (String.words words)

-- One verb as a player types it, for each of its names: `pull lever`, or
-- `give <thing> <word> lever` for a verb that takes another object.
let _forms (i: World.Instance) (v: Driver.Verb) =
  let me = Option.default "it" (List.head i.object.names);
  let arg (a: Driver.Arg) =
    match a with
    | Driver.NoArg -> ""
    | Driver.This -> " %{me}"
    | Driver.AnyObj -> " <thing>"
  in
  let iobj = if v.iobj == Driver.NoArg then "" else " <word>%{arg v.iobj}";
  String.join ", " (List.map (fn n -> "%{n}%{arg v.dobj}%{iobj}") v.names)

-- /verbs: what a thing answers to, and a room's exits. For the room you
-- are in, also what each realm it is in answers to, nearest first.
let _verbs body words (w: World.Current) =
  match _named body words w with
  | Parse.Found id -> (
    match World.instance id w with
    | None -> World.tell body "There is no %{id}." w
    | Some i -> (
      let name = short_of id w;
      let verbs =
        if i.object.verbs == [] then ["%{name} answers to nothing."]
        else "%{name} answers to:" :: List.map (fn v -> "  %{_forms i v}") i.object.verbs;
      let exits =
        if i.object.exits == Map.empty then []
        else ["Exits: %{String.join ", " (Map.keys i.object.exits)}."];
      let realms =
        if id != room_of body w then []
        else
          List.flatten
            (List.filter_map
              (fn r -> match World.instance r w with
                | Some ri when ri.object.verbs != [] ->
                  Some
                    ("%{short_of r w} answers to:" :: List.map (fn v -> "  %{_forms ri v}") ri.object.verbs)
                | _ -> None
              )
              (List.map realm_id (room_realms id w)));
      World.tell body (String.join "\n" (List.flatten [verbs, exits, realms])) w
    )
  )
  | _ -> World.tell body "You don't see a '%{words}' here." w

-- What follows the first word of `words`.
let _rest_of words =
  String.trim
    (String.slice
      (String.length (Option.default "" (String.word 0 words)))
      (String.length words)
      words)

-- Where each Citizen's home is: /r/home/ann for ann.
let home_dir key (w: World.Current) = "%{w.paths.homes}/%{key}"

-- The exit back to a room dug in a direction: south for north. Any other
-- exit gets back.
-- How /dig and /link write the exit `name` in a file: with its short form,
-- in quotes, as "n*orth" for north, and any other name as it is.
let _exit_key name =
  let s = Driver.starred name;
  if String.contains? "*" s then `"%{s}"` else s

let _back_of name =
  match name with
  | "north" -> "south"
  | "south" -> "north"
  | "east" -> "west"
  | "west" -> "east"
  | "up" -> "down"
  | "down" -> "up"
  | _ -> "back"

-- The directory of a blueprint path: /r/home/ann for /r/home/ann/hall.
let _dir_of path =
  let segs = String.split "/" path;
  String.join "/" (List.take (List.length segs - 1) segs)

-- /dig <exit> <path>: make a room at `path`, written out or from the
-- directory of the room `body` is in, with an exit back, and add the exit
-- `name` to it here. A room /dig made has a marked block of exits, which it
-- adds to; to a room written by hand, the player adds it with /edit. It is
-- paid for as a save.
let _dig body words (tx: Tx) = (
  let tell text = change (World.tell body text) tx;
  let view = (let v = _rest_of (_rest_of words); if v == "" then None else Some v);
  match String.words words with
  | [name :: rel :: _] -> (
    let here = room_of body tx.w;
    let from = World.blueprint_of here;
    -- A relative path starts in the directory of the room the player
    -- stands in when the room is theirs: they own it, build it under a
    -- contract, or keep its realm. Otherwise it starts in their home, so a
    -- Keymaster digs in the Commons only with a path written out.
    let key = _key_of body tx.w;
    let mine = may_edit? body from tx.w;
    let ours =
      file_owner from tx.w == key || contracted? key from tx.w || steward? key from tx.w;
    let base =
      if ours then _dir_of from
      else Option.default "" (Option.map (fn k -> home_dir k tx.w) (_key_of body tx.w));
    let path = if String.starts_with? "/" rel then rel else "%{base}/%{rel}";
    let exits =
      Option.map (fn (i: World.Instance) -> i.object.exits) (World.instance here tx.w);
    if !(Regex.match? r/^[a-z][a-z0-9_]*$/ name) then
      tell "An exit's name is one word in lower case, as east or door."
    else if !(Files.valid? path) then
      tell
        "'%{path}' is not a Library path. One looks like %{tx.w.paths.homes}/ann/shop/front."
    else if !(may_edit? body path tx.w) then tell "You may not make %{path}."
    else if Files.exists? tx.w.lib_root path then tell "%{path} is there already."
    else if Option.and_then (Driver.exit_named name) exits != None then
      tell "%{short_of here tx.w} has an exit %{name} already."
    else if !(Option.some? tx.w.dig) then tell "This game has no room for /dig to make."
    else (
      let payer = _key_of body tx.w;
      -- The game's template, run under the same limits as its other code.
      let source =
        Option.default
          ""
          (Option.map
            (fn dig -> _bounded "" (fn () -> dig path (_back_of name) from))
            tx.w.dig);
      match budget payer (Driver.Save path source) tx.w with
      | Error why -> tell why
      | Ok cost -> (
        let o = Files.save tx.w.lib_root path source;
        match (o.ok, Wand.load Driver.Blueprint.loader (Files.file_of tx.w.lib_root path)) with
        | (true, Ok b) -> (
          let dug =
            tx
            |> _charge payer cost "dig"
            |> _wrote body path
            |> change (World.set_blueprint path b)
            |> change (fn w ->
              match payer with
              | Some k -> World.set_built path k w
              | None -> w)
            |> _event World.Event(
              at = "",
              event = "dig",
              actor = body,
              object = Some path,
              text = Some name
            );
          let hand =
            `Dug a room at %{path}. Add the exit to this room with /edit here: %{Files.exit_line (_exit_key name) path view}`;
          let away =
            `Dug a room at %{path}. No exit leads there from %{short_of here tx.w}. Go there with /eval [Driver.Move ctx.actor "%{path}"]`;
          -- The exit goes here only when the new room is in this room's
          -- area, or the player wrote its path out.
          if !(mine && (ours || String.starts_with? "/" rel)) then
            change (World.tell body away) dug
          else match Option.map
            (Files.with_exit (_exit_key name) path view)
            (Files.read tx.w.lib_root from) with
            | Some (Some changed) -> (
              let saved = Files.save tx.w.lib_root from changed;
              if saved.ok then
                dug
                |> change (World.touched from)
                |> _wrote body from
                |> update body from
                |> change (World.tell body "Dug %{name} to %{path}.")
              else change (World.tell body hand) dug
            )
            | _ -> change (World.tell body hand) dug
        )
        | (true, Error why) ->
          _wrote body path (tell "The room at %{path} was made, but did not load: %{why}")
        | (false, _) ->
          tell
            "The room at %{path} could not be made: %{String.join "; " (List.map (fn (p: Driver.Problem) -> p.message) o.problems)}"
      )
    )
  )
  | _ -> tell "Dig where? /dig <exit> <path>, as /dig east shop/front."
)

-- The examples /copy may copy: the files of the Learning Hall.
let learning (w: World.Current) = "%{w.paths.examples}/"

-- /files [directory]: the text that says what is in a directory: your home, or one you name,
-- written out or from your home, as /files shop for /r/home/ann/shop. Only
-- someone who may edit files there may list it.
let _files body words (w: World.Current) =
  match World.account_of body w with
  | None -> "You have no account."
  | Some a -> (
    let home = home_dir (String.lower a.name) w;
    let trimmed =
      if String.ends_with? "/" words then String.slice 0 (String.length words - 1) words
      else words;
    let dir =
      if trimmed == "" then home
      else if String.starts_with? "/" trimmed then trimmed
      else "%{home}/%{trimmed}";
    if !(Files.valid? dir) then
      "'%{dir}' is not a Library directory. One looks like %{w.paths.homes}/ann/shop."
    else if !(may_edit? body "%{dir}/x" w) then "You may not list %{dir}."
    else match Files.list w.lib_root dir with
      | Some names when names != [] ->
        String.join "\n" ("%{dir}/:" :: List.map (fn n -> "  %{n}") names)
      | _ -> "%{dir}/ is empty."
  )

-- /copy: write the file of a Learning Hall example into the builder's home,
-- and load it, as a start to change. A file of that name already there is
-- never written over. It is paid for as a save.
let _copy body words (tx: Tx) =
  match (_named body words tx.w, World.account_of body tx.w) with
  | (_, None) -> change (World.tell body "You have no account to copy into.") tx
  | (Parse.Found id, Some a) -> (
    let from = World.blueprint_of id;
    let key = String.lower a.name;
    let to =
      "%{home_dir key tx.w}/%{Option.default "" (List.head (List.reverse (String.split "/" from)))}";
    let room? = World.env_of id tx.w == None;
    if !(String.starts_with? (learning tx.w) from) then
      change
        (World.tell
          body
          "Only the examples in the Learning Hall can be copied, and %{short_of id tx.w} is not one.")
        tx
    else if Files.exists? tx.w.lib_root to then
      change (World.tell body "You have %{to} already. Change it with /edit %{to}.") tx
    else match Option.map (Files.moved from to) (Files.read tx.w.lib_root from) with
      | None -> change (World.tell body "%{from} has no file to copy.") tx
      | Some source -> (
        match budget (Some key) (Driver.Save to source) tx.w with
        | Error why -> change (World.tell body why) tx
        | Ok cost -> (
          let o = Files.save tx.w.lib_root to source;
          let use =
            if room? then `Go there with /eval [Driver.Move ctx.actor "%{to}"]`
            else `Make one with /eval [Driver.Spawn "%{to}" ctx.here]`;
          match (o.ok, Wand.load Driver.Blueprint.loader (Files.file_of tx.w.lib_root to)) with
          | (true, Ok b) ->
            tx
            |> _charge (Some key) cost "copy"
            |> _wrote body to
            |> change (World.set_blueprint to b)
            |> change (World.set_built to key)
            |> _event World.Event(
              at = "",
              event = "copy",
              actor = body,
              object = Some to,
              text = Some from
            )
            |> change
              (World.tell
                body
                "Copied %{from} to %{to}. %{use}, and change it with /edit %{to}.")
          | (true, Error why) ->
            tx
            |> _wrote body to
            |> change (World.tell body "Copied %{from} to %{to}, but it did not load: %{why}")
          | (false, _) ->
            change
              (World.tell
                body
                "%{from} could not be copied: %{String.join "; " (List.map (fn (p: Driver.Problem) -> p.message) o.problems)}")
              tx
        )
      )
  )
  | (_, Some _) -> change (World.tell body "You don't see a '%{words}' here.") tx

-- An account's Capacity and Inspiration, as /stat shows them.
let _stat_text (a: World.Account) (w: World.Current) =
  let key = String.lower a.name;
  let i = a.inspiration;
  let lines =
    [
      "%{a.name}, %{String.upper (String.slice 0 1 a.role)}%{String.slice 1 (String.length a.role) a.role}",
      "Capacity: %{List.length (World.owned key w)} of %{max_owned} objects, %{file_count key w} of %{max_files} files, %{_size (World.saved_bytes key w)} of %{_size max_saved_total} of saved state.",
      "Inspiration: %{Inspiration.amount w.now i} of %{Inspiration.full}, refilling %{60 / Inspiration.seconds_per_point} a minute.",
      "Rooms explored: %{Map.size a.explored}, %{Inspiration.today w.now a.explored} of %{Inspiration.bonuses_a_day} today."
    ];
  let notes =
    if a.role == "keymaster" then ["A Keymaster is held to neither limit."] else [];
  String.join "\n" (List.concat lines notes)

-- /stat: a builder's own Capacity and Inspiration, or, for a Keymaster,
-- anyone's.
let _stat body words (tx: Tx) = (
  let me = World.account_of body tx.w;
  let found =
    (if words == "" || words == "me" then
       match me with
       | Some a -> Ok a
       | None -> Error "You have no account."
     else if Option.map (fn (a: World.Account) -> a.role) me != Some "keymaster" then
       Error "Only a Keymaster may see another's. Try /stat me."
     else match World.account words tx.w with
       | Some a -> Ok a
       | None -> Error "There is no one called %{words}.");
  match found with
  | Error why -> change (World.tell body why) tx
  | Ok a -> (let text = _stat_text a tx.w; change (World.tell body text) tx)
)

-- Whether `body` may say who enters or moves `id`: its owner, a Steward of
-- its realm, or a Keymaster.
let _may_change? body id (w: World.Current) =
  let key = _key_of body w;
  Option.some? key
  && (World.owner_of id w == key || _exempt? key w || steward? key (World.blueprint_of id) w)

-- Who may enter `room` once it is private: whom it lets in already, or
-- only its owner and the Keymasters when it was public.
let _closed room (w: World.Current) =
  match Option.map (fn (i: World.Instance) -> i.allowed) (World.instance room w) with
  | Some (Driver.Only names) -> Driver.Only names
  | _ -> Driver.Only []

-- /public and /private: open the room `body` is in to everyone, or close it
-- to all but its owner, whoever it invites, and the Keymasters.
let _set_public body words public (tx: Tx) =
  let room = room_of body tx.w;
  let name = short_of room tx.w;
  if words != "" && words != "here" then
    change (World.tell body "It changes the room you are in: /public here.") tx
  else if !(_may_change? body room tx.w) then
    change (World.tell body "%{name} is not yours to open or close.") tx
  else
    tx
    |> change (World.set_allowed room (if public then Driver.Everyone else _closed room tx.w))
    |> _event World.Event(
      at = "",
      event = if public then "public" else "private",
      actor = body,
      room = Some room
    )
    |> change
      (World.tell
        body
        (if public then "%{name} is public now: anyone may come in."
        else "%{name} is private now: only you, whoever you invite, and the Keymasters may come in."))

-- /invite and /uninvite: let one account into the private room `body` is
-- in, or no longer.
let _invite body words yes (tx: Tx) = (
  let room = room_of body tx.w;
  let title = short_of room tx.w;
  match String.words words with
  | [name :: rest] when rest == [] || rest == ["here"] -> (
    if !(_may_change? body room tx.w) then
      change (World.tell body "%{title} is not yours to invite anyone into.") tx
    else if Option.map World.public? (World.instance room tx.w) == Some true then
      change
        (World.tell body "%{title} is public: anyone may come in. /private here closes it.")
        tx
    else match World.account name tx.w with
      | None -> change (World.tell body "There is no one called %{name}.") tx
      | Some a -> if yes then
          tx
          |> change (World.invite room a.name)
          |> _event World.Event(
            at = "",
            event = "invite",
            actor = body,
            name = Some a.name,
            room = Some room
          )
          |> change (World.tell body "%{a.name} may come into %{title} now.")
          |> change (World.tell a.body "%{short_of body tx.w} invites you into %{title}.")
        else
          tx
          |> change (World.uninvite room a.name)
          |> _event World.Event(
            at = "",
            event = "uninvite",
            actor = body,
            name = Some a.name,
            room = Some room
          )
          |> change
            (World.tell
              body
              "%{a.name} may no longer come into %{title} while it is private.")
  )
  | _ ->
    change
      (World.tell
        body
        (if yes then "Invite whom? /invite bo here" else "Uninvite whom? /uninvite bo here"))
      tx
)

-- /ban and /unban: keep one account out of every room the account of
-- `body` owns, public or private, or no longer. A banned body in one of
-- those rooms goes home. The banned person is not told: a room they try to
-- enter says what a private room says.
let _ban body words yes (tx: Tx) =
  match (World.account_of body tx.w, String.words words) with
  | (None, _) -> change (World.tell body "You have no account.") tx
  | (Some me, [name]) -> (
    match World.account name tx.w with
    | None -> change (World.tell body "There is no one called %{name}.") tx
    | Some a when String.lower a.name == String.lower me.name ->
      change (World.tell body "You cannot ban yourself.") tx
    | Some a when a.role == "keymaster" ->
      change
        (World.tell body "A Keymaster may go anywhere, so %{a.name} cannot be banned.")
        tx
    | Some a -> if yes then (
        let banned =
          tx
          |> change (World.ban me.name a.name)
          |> _event World.Event(at = "", event = "ban", actor = body, name = Some a.name)
          |> change (World.tell body "%{a.name} may no longer come into your rooms.");
        let room = room_of a.body banned.w;
        if World.owner_of room banned.w == Some (String.lower me.name) then
          banned
          |> _tell_room room a.body "%{a.name} leaves."
          |> _move (ctx_for banned.w a.body a.body) a.body (home_of a.body banned.w)
        else banned
      )
      else
        tx
        |> change (World.unban me.name a.name)
        |> _event World.Event(at = "", event = "unban", actor = body, name = Some a.name)
        |> change
          (World.tell body "%{a.name} may come into your rooms again, where they are let in.")
  )
  | _ ->
    change
      (World.tell body (if yes then "Ban whom? /ban bo" else "Unban whom? /unban bo"))
      tx

-- ── Reviews ────────────────────────────────────────────────────────────

-- The realm a player names: written out, as /r/guild, or by its name in
-- the root realm, the Commons, as guild. None when it is no realm, or one the Keymasters do
-- not own.
let _realm_named words (w: World.Current) =
  let root = Option.default "" (List.head (List.reverse (realms_of w.paths.arrival w)));
  let path = if String.starts_with? "/" words then words else "%{root}/%{words}";
  if Map.has? path w.realms && file_owner path w == None then Some path else None

-- The rooms a request from `entrance` covers: the entrance, and every room
-- in its directory that exits reach from it. The walk follows every exit a
-- room declares, whatever its check says, so a shut door hides nothing,
-- and makes each room it reaches, to read its exits.
let _walk dir (seen: List String) todo (tx: Tx) =
  match todo with
  | [] -> (seen, tx)
  | [p :: rest] -> if List.any? (fn s -> s == p) seen then _walk dir seen rest tx
    else (
      let made = _ensure p tx;
      let next =
        (match World.instance p made.w with
         | Some i ->
           List.filter
             (fn q -> String.starts_with? dir q)
             (List.map
               (fn (e: Driver.Exit) -> World.blueprint_of (World.resolve e.to))
               (Map.values i.object.exits))
         | None -> []);
      _walk dir (List.concat seen [p]) (List.concat rest next) made
    )

-- Who is told of a request to `realm`: its Stewards, or the Keymasters
-- when it has none.
let _reviewers_of realm (w: World.Current) =
  let stewards = List.map String.lower (_charter (realm :: realms_of realm w) w).stewards;
  if stewards != [] then stewards
  else
    List.map
      (fn (a: World.Account) -> String.lower a.name)
      (List.filter (fn (a: World.Account) -> a.role == "keymaster") (Map.values w.accounts))

let _notice_all keys text (tx: Tx) =
  List.fold_left (fn acc k -> change (World.notice k text) acc) tx keys

-- What a request asks, in words: "join the Guild", or "open your building
-- in the Guild".
let _asks (r: World.Request) (w: World.Current) =
  let realm = short_of (realm_id r.realm) w;
  if r.kind == "join" then "join %{realm}" else "open a building in %{realm}"

-- The request numbered `words`, or for `here`, the open request of `body`
-- that covers the room they are in.
let _request_named body words (w: World.Current) =
  if words == "here" then
    List.find
      (fn (r: World.Request) -> r.open
      && Some r.by == _key_of body w
      && List.any? (fn p -> p == World.blueprint_of (room_of body w)) r.rooms)
      w.requests
  else Option.and_then (fn n -> World.request n w) (Result.to_option (String.to_int words))

-- /review here <realm>: ask a realm to take the rooms from the one `body`
-- is in. Rooms of their own join the realm and stay theirs; rooms they
-- built inside the realm, under a contract, ask to be opened.
let _review body words (tx: Tx) = (
  let tell text = change (World.tell body text) tx;
  match (String.words words, World.account_of body tx.w) with
  | (["here", name], Some a) -> (
    let key = String.lower a.name;
    let here = room_of body tx.w;
    let bp = World.blueprint_of here;
    match _realm_named name tx.w with
    | None -> tell "There is no realm called %{name}."
    | Some realm -> (
      let inside = List.any? (fn p -> p == realm) (realms_of bp tx.w);
      let yours =
        if inside then contracted? (Some key) bp tx.w else file_owner bp tx.w == Some key;
      if !yours then tell "%{short_of here tx.w} is not yours to offer."
      else match List.find
        (fn (r: World.Request) -> r.open && List.any? (fn p -> p == bp) r.rooms)
        tx.w.requests with
        | Some r -> tell "Request #%{r.id} covers %{short_of here tx.w} already."
        | None -> (
          let (rooms, walked) = _walk "%{_dir_of bp}/" [] [bp] tx;
          let r =
            World.Request(
              id = List.length tx.w.requests + 1,
              by = key,
              kind = if inside then "open" else "join",
              realm = realm,
              rooms = rooms,
              at = tx.w.now
            );
          walked
          |> change (World.add_request r)
          |> _event World.Event(
            at = "",
            event = "review",
            actor = body,
            object = Some bp,
            text = Some "#%{r.id} %{r.kind} %{realm}"
          )
          |> _notice_all
            (_reviewers_of realm walked.w)
            "Request #%{r.id}: %{a.name} asks to %{_asks r walked.w}, with %{List.length rooms} rooms from %{bp}. /visit %{r.id} to look."
          |> change
            (World.tell
              body
              "Your request #%{r.id} to %{_asks r walked.w} is waiting for its Stewards.")
        )
    )
  )
  | _ ->
    tell "Ask a realm to take your rooms with /review here <realm>, as /review here guild."
)

-- One request, in a line.
let _request_line (r: World.Request) =
  let from = Option.default "" (List.head r.rooms);
  let changed = if r.changed == [] then "" else ", changed since";
  "#%{r.id} %{r.kind} %{r.realm}: %{List.length r.rooms} rooms from %{from}, by %{r.by} at %{r.at}%{changed}"

-- /reviews [n]: your open requests and the ones waiting for you, or one
-- whole: its rooms, and the files saved since it was asked.
let _reviews body words (w: World.Current) = (
  let key = _key_of body w;
  let mine (r: World.Request) = Some r.by == key || reviewer? key r w;
  if words == "" then (
    let open = List.filter (fn (r: World.Request) -> r.open && mine r) w.requests;
    if open == [] then "No requests are open."
    else String.join "\n" (List.map _request_line open)
  )
  else match _request_named body words w with
    | Some r when mine r ->
      String.join
        "\n"
        (List.flatten [
          [_request_line r, "Rooms: %{String.join ", " r.rooms}"],
          if r.changed == [] then []
          else ["Saved since it was asked: %{String.join ", " r.changed}"],
          [Option.default "Open." r.outcome]
        ])
    | _ -> "There is no request #%{words} for you."
)

-- /visit <n>: go to the entrance of a request you review, to look before
-- you decide. Its builder is told.
let _visit body words (tx: Tx) = (
  let key = _key_of body tx.w;
  match _request_named body words tx.w with
  | Some r when r.open && reviewer? key r tx.w -> (
    let from = room_of body tx.w;
    let name = short_of body tx.w;
    let entrance = Option.default from (List.head r.rooms);
    tx
    |> change (fn w -> if Map.has? body w.visiting then w else World.visit body from w)
    |> _tell_room from body "%{name} leaves."
    |> _move (ctx_for tx.w body body) body entrance
    |> change (World.notice r.by "%{name} is reviewing your request #%{r.id}.")
  )
  | Some r when !r.open ->
    change
      (World.tell body "Request #%{r.id} is closed: %{Option.default "" r.outcome}.")
      tx
  | _ -> change (World.tell body "There is no request #%{words} for you to visit.") tx
)

-- Send `body` back from a visit: to where they came from, or home when that
-- has closed to them.
let _sent_back body (tx: Tx) =
  match Map.get body tx.w.visiting with
  | None -> tx
  | Some from -> (
    let to = if may_enter? body from tx.w then from else home_of body tx.w;
    tx |> change (World.back body) |> _move (ctx_for tx.w body body) body to
  )

-- /back: return from a visit.
let _back body (tx: Tx) =
  if Map.has? body tx.w.visiting then _sent_back body tx
  else change (World.tell body "You are not visiting a request.") tx

-- Everyone visiting request `r` who may no longer be in its rooms goes back.
let _visitors_back (r: World.Request) (tx: Tx) =
  List.fold_left
    (fn acc b -> if List.any? (fn p -> p == World.blueprint_of (room_of b acc.w)) r.rooms
      && !(may_enter? b (room_of b acc.w) acc.w) then
        _sent_back b acc
      else acc)
    tx
    (Map.keys tx.w.visiting)

-- /link <exit> <path>: add an exit from the room `body` is in to the room
-- at `path`, which is there already, as /dig does for a room it makes.
let _link body words (tx: Tx) = (
  let tell text = change (World.tell body text) tx;
  let view = (let v = _rest_of (_rest_of words); if v == "" then None else Some v);
  match String.words words with
  | [name :: path :: _] -> (
    let here = room_of body tx.w;
    let from = World.blueprint_of here;
    let line = Files.exit_line (_exit_key name) path view;
    if !(may_edit? body from tx.w) then tell "%{short_of here tx.w} is not yours to change."
    else if !(Files.exists? tx.w.lib_root path) then tell "There is no room at %{path}."
    else match Option.and_then
      (Files.with_exit (_exit_key name) path view)
      (Files.read tx.w.lib_root from) with
      | Some changed -> (
        let saved = Files.save tx.w.lib_root from changed;
        if saved.ok then
          tx
          |> change (World.touched from)
          |> _wrote body from
          |> update body from
          |> _event World.Event(
            at = "",
            event = "link",
            actor = body,
            object = Some from,
            text = Some "%{name} %{path}"
          )
          |> change (World.tell body "Linked %{name} to %{path}.")
        else tell "The exit could not be added. Add it with /edit here: %{line}"
      )
      | None -> tell "Add the exit to this room with /edit here: %{line}"
  )
  | _ ->
    tell
      "Link where? /link <exit> <path>, as /link east %{tx.w.paths.homes}/ann/shop/front."
)
-- /approve <n> [exit]: open a request's rooms to everyone. Rooms that join
-- the realm are its now, and stay their builder's. With an exit, the
-- Steward stands in a room of the realm, and the exit is added from there
-- to the request's entrance, as /link adds one; the request is approved
-- only when it can be.
let _approve body words (tx: Tx) = (
  let key = _key_of body tx.w;
  let n = Option.default "" (String.word 0 words);
  let exit = Option.default "" (String.word 1 words);
  let view = _rest_of (_rest_of words);
  let here = room_of body tx.w;
  match _request_named body n tx.w with
  | Some r when r.open && reviewer? key r tx.w -> (
    let entrance = Option.default "" (List.head r.rooms);
    let linkable =
      if exit == "" then Ok()
      else if !(List.any? (fn p -> p == r.realm) (room_realms here tx.w)) then
        Error
          "Stand in a room of %{short_of (realm_id r.realm) tx.w} to connect it from there."
      else if !(may_edit? body (World.blueprint_of here) tx.w) then
        Error "%{short_of here tx.w} is not yours to change."
      else if Option.and_then
        (fn (i: World.Instance) -> Driver.exit_named exit i.object.exits)
        (World.instance here tx.w) != None then
        Error "%{short_of here tx.w} has an exit %{exit} already."
      else Ok();
    match linkable with
    | Error why -> change (World.tell body why) tx
    | Ok _ -> (
      let opened =
        List.fold_left
          (fn acc p -> acc
          |> _ensure p
          |> change (World.set_allowed (World.resolve p) Driver.Everyone))
          tx
          r.rooms;
      let approved =
        opened
        |> change (fn w -> if r.kind == "join" then World.adopt r.rooms r.realm w else w)
        |> change (World.close_request r.id "approved")
        |> _event World.Event(at = "", event = "approve", actor = body, text = Some "#%{r.id}")
        |> change
          (World.notice
            r.by
            "Your request #%{r.id} to %{_asks r tx.w} was approved. Its rooms are public now.")
        |> change (World.tell body "Approved #%{r.id}.");
      if exit == "" then
        change
          (World.tell
            body
            "Connect it from a room of the realm with /link <exit> %{entrance}.")
          approved
      else _link body "%{exit} %{entrance} %{view}" approved
    )
  )
  | _ -> change (World.tell body "There is no open request #%{n} for you to approve.") tx
)

-- /decline <n> <reason>: refuse a request, and tell its builder why.
let _decline body words (tx: Tx) = (
  let key = _key_of body tx.w;
  let n = Option.default "" (String.word 0 words);
  let reason = _rest_of words;
  match _request_named body n tx.w with
  | Some r when r.open && reviewer? key r tx.w -> if reason == "" then change (World.tell body "Say why: /decline %{n} <reason>.") tx
    else
      tx
      |> change (World.close_request r.id "declined: %{reason}")
      |> _event World.Event(
        at = "",
        event = "decline",
        actor = body,
        text = Some "#%{r.id} %{reason}"
      )
      |> change
        (World.notice r.by "Your request #%{r.id} to %{_asks r tx.w} was declined: %{reason}")
      |> change (World.tell body "Declined #%{r.id}.")
      |> _visitors_back r
  | _ -> change (World.tell body "There is no open request #%{n} for you to decline.") tx
)

-- /withdraw <n>, or /withdraw here: take back your own request before
-- anyone decides on it, or take rooms that joined a realm out of it.
let _withdraw body words (tx: Tx) =
  let key = _key_of body tx.w;
  let bp = World.blueprint_of (room_of body tx.w);
  match _request_named body words tx.w with
  | Some r when r.open && Some r.by == key ->
    tx
    |> change (World.close_request r.id "withdrawn")
    |> _event World.Event(at = "", event = "withdraw", actor = body, text = Some "#%{r.id}")
    |> _notice_all (_reviewers_of r.realm tx.w) "Request #%{r.id} was withdrawn."
    |> change (World.tell body "Withdrew #%{r.id}.")
    |> _visitors_back r
  | _ -> (
    -- The rooms here joined a realm: take them all out.
    let joined =
      List.find
        (fn (r: World.Request) -> r.kind == "join"
        && r.outcome == Some "approved"
        && Some r.by == key
        && List.any? (fn p -> p == bp) r.rooms
        && Map.get bp tx.w.adopted == Some r.realm)
        tx.w.requests;
    match joined with
    | Some r when words == "here" ->
      tx
      |> change (World.unadopt r.rooms)
      |> _event World.Event(at = "", event = "leave", actor = body, text = Some "#%{r.id} %{r.realm}")
      |> _notice_all (_reviewers_of r.realm tx.w) "The rooms of request #%{r.id} left %{short_of (realm_id r.realm) tx.w}."
      |> change (World.tell body "Your rooms are out of %{short_of (realm_id r.realm) tx.w} now.")
    | _ -> change (World.tell body "There is no request #%{words} of yours to withdraw.") tx
  )


-- /lock and /unlock: whether only what its owner owns may move a thing,
-- or anything that can reach it.
let _set_locked body words locked (tx: Tx) = (
  let verb = if locked then "lock" else "unlock";
  let here = room_of body tx.w;
  let found =
    if words == "" then Parse.Missing ""
    else Parse.resolve tx.w body here (String.words words);
  match found with
  | Parse.Found id -> (
    let name = short_of id tx.w;
    if player? id tx.w || World.env_of id tx.w == None then
      change
        (World.tell
          body
          "Only a thing can be locked: a room is /private, and a player is their own.")
        tx
    else if !(_may_change? body id tx.w) then
      change (World.tell body "%{name} is not yours to %{verb}.") tx
    else
      tx
      |> change (World.set_locked id locked)
      |> _event World.Event(at = "", event = verb, actor = body, object = Some id)
      |> change
        (World.tell
          body
          (if locked then "%{name} is locked now: only what its owner owns may move it."
          else "%{name} is unlocked now: anything that can reach it may move it."))
  )
  | _ ->
    change
      (World.tell
        body
        (if words == "" then "What do you want to %{verb}?"
        else "You don't see a '%{words}' here."))
      tx
)

-- ── Flags ──────────────────────────────────────────────────────────────

-- How many different people flag a room or a thing before it is taken
-- out of view to wait for a Keymaster.
let flags_to_hold = 3

let _keymaster? body (w: World.Current) =
  match World.account_of body w with
  | Some a -> a.role == "keymaster"
  | None -> false

-- Whether `body` is a Steward of any realm.
let _steward_anywhere? body (w: World.Current) =
  let key = _key_of body w;
  List.any? (fn p -> steward? key p w) (Map.keys w.realms)

-- Whether `body` reviews flag `f`: a Keymaster reviews every flag, and a
-- Steward the flags on the rooms of their realms and the things in them,
-- wherever a thing's file is. A flag on a person is for the Keymasters
-- alone.
let _reviews? body (f: World.Flag) (w: World.Current) =
  _keymaster? body w
  || f.kind != "person" && _keeps? (_key_of body w) (room_realms (room_of f.target w) w) w

-- What a room or a thing was when it was flagged: its text, and its file.
-- Its own text, even when it is held, so a Keymaster sees what was there.
let _evidence id (w: World.Current) =
  match World.instance id w with
  | None -> "(it is gone)"
  | Some i -> (
    let ctx = _seen w id id;
    let bp = i.blueprint;
    let source = Option.default "(there is no file)" (Files.read w.lib_root bp);
    `%{_bounded "(its short text faults)" (fn () -> i.object.short ctx)}
%{_bounded "(its long text faults)" (fn () -> i.object.long ctx)}

--- %{bp}.wand ---
%{source}`
  )

-- What a flag is about, in words.
let _about (f: World.Flag) =
  if f.kind == "person" then f.target else "%{f.kind} %{f.target}"

-- Take a room or a thing out of view once enough different people have
-- flagged it: a room is made private, and a thing is held.
let _hold_if_flagged (f: World.Flag) (tx: Tx) = (
  let by =
    List.unique (List.map (fn (g: World.Flag) -> g.by) (World.open_flags f.target tx.w));
  let held =
    (if List.length by < flags_to_hold then None
     else match World.instance f.target tx.w with
       | Some i when f.kind == "room" && World.public? i -> Some (
         World.set_allowed f.target (Driver.Only []),
         "is private until a Keymaster has looked at it"
       )
       | Some i when f.kind == "object" && !i.held -> Some (
         World.set_held f.target true,
         "is out of view until a Keymaster has looked at it"
       )
       | _ -> None);
  match held with
  | None -> tx
  | Some(hold, why) -> (
    let told =
      (match f.owner with
       | Some o -> change (World.notice o "Your %{f.kind} %{f.target} %{why}.") tx
       | None -> tx);
    told
    |> change hold
    |> _event World.Event(
      at = "",
      event = "held",
      actor = f.target,
      text = Some "%{List.length by} flags"
    )
  )
)

-- Keep a flag. The flagger is thanked; a builder is told what was flagged
-- and why, and never who flagged it.
let _file_flag body kind target owner reason evidence (tx: Tx) =
  match _key_of body tx.w with
  | None -> tx
  | Some by -> (
    let f =
      World.Flag(
        id = List.length tx.w.flags + 1,
        by = by,
        kind = kind,
        target = target,
        owner = owner,
        reason = reason,
        at = tx.w.now,
        evidence = evidence
      );
    let filed =
      tx
      |> change (World.add_flag f)
      |> _event World.Event(
        at = "",
        event = "flag",
        actor = body,
        object = Some target,
        text = Some "#%{f.id} %{kind}: %{reason}"
      )
      |> change (World.tell body "Thank you. A Keymaster will look at it.");
    let told =
      (match owner with
       | Some o when kind != "person" ->
         change
           (World.notice
             o
             "Your %{kind} %{target} was flagged: %{reason}. A Keymaster will look at it.")
           filed
       | _ -> filed);
    _hold_if_flagged f told
  )

-- /flag here <why>, and /flag <thing> <why>.
let _flag body words (tx: Tx) = (
  let here = room_of body tx.w;
  let reason = _rest_of words;
  match String.word 0 words with
  | None ->
    change
      (World.tell body "Flag what, and why? /flag here <why>, or /flag <thing> <why>.")
      tx
  | Some first -> (
    let found =
      if first == "here" then Parse.Found here else Parse.resolve tx.w body here [first];
    match found with
    | Parse.Found id -> if player? id tx.w then
        change (World.tell body "To tell the Keymasters about a person, /report them.") tx
      else if reason == "" then change (World.tell body "Say why: /flag %{first} <why>.") tx
      else (
        let kind = if World.env_of id tx.w == None then "room" else "object";
        let evidence = _evidence id tx.w;
        _file_flag body kind id (World.owner_of id tx.w) reason evidence tx
      )
    | _ -> change (World.tell body "You don't see a '%{first}' here.") tx
  )
)

-- /report <name> <why>: a person's behavior, with the last lines they said.
let _report body words (tx: Tx) = (
  let reason = _rest_of words;
  match String.word 0 words with
  | Some name when reason != "" -> (
    match World.account name tx.w with
    | None -> change (World.tell body "There is no one called %{name}.") tx
    | Some a -> (
      let lines = Option.default [] (Map.get a.body tx.w.said);
      let evidence = if lines == [] then "(nothing said lately)" else String.join "\n" lines;
      let key = String.lower a.name;
      _file_flag body "person" key (Some key) reason evidence tx
    )
  )
  | _ -> change (World.tell body "Report whom, and why? /report <name> <why>.") tx
)

-- /flags: the open flags, or one flag whole.
let _flags body words (w: World.Current) =
  if !(_keymaster? body w || _steward_anywhere? body w) then
    World.tell body "Only a Keymaster or a Steward reviews flags." w
  else if words == "" then (
    let open = List.filter (fn (f: World.Flag) -> f.open && _reviews? body f w) w.flags;
    if open == [] then World.tell body "No flags are open." w
    else
      World.tell
        body
        (String.join
          "\n"
          (List.map
            (fn (f: World.Flag) -> "#%{f.id} %{_about f}, by %{f.by} at %{f.at}: %{f.reason}")
            open))
        w
  )
  else match Option.and_then (fn n -> World.flag n w) (Result.to_option (String.to_int words)) with
    | Some f when _reviews? body f w ->
      (World.tell
        body
        `#%{f.id} %{_about f}, owned by %{Option.default "the Keymasters" f.owner}
Flagged by %{f.by} at %{f.at}: %{f.reason}
%{Option.default "Open." (Option.map (fn r -> "Resolved: %{r}") f.resolution)}

%{f.evidence}`
        w)
    | _ -> World.tell body "There is no flag #%{words} for you to review." w

-- Close a flag, and let a held thing back into view when no flag on it is
-- open any more.
let _close body (f: World.Flag) resolution told (tx: Tx) =
  let closed =
    tx
    |> change (World.resolve_flag f.id resolution)
    |> _event World.Event(
      at = "",
      event = "resolve",
      actor = body,
      object = Some f.target,
      text = Some "#%{f.id} %{resolution}"
    )
    |> change (World.tell body told);
  if f.kind == "object" && World.open_flags f.target closed.w == [] then
    change (World.set_held f.target false) closed
  else closed

-- Pause an account: it may not log in, and its session ends.
let _pause name why (tx: Tx) =
  match World.account name tx.w with
  | None -> tx
  | Some a -> (
    let paused = change (World.set_paused a.name true) tx;
    match World.session_of a.body tx.w with
    | Some s ->
      paused
      |> change (World.tell a.body "A Keymaster has paused your account: %{why}")
      |> change (World.close_soon s.id)
    | None -> paused
  )

-- /resolve <n> <how> [note].
let _resolve body words (tx: Tx) = (
  let usage = "Resolve how? /resolve <number> dismiss, private, remove, warn or pause, and a note if you like.";
  if !(_keymaster? body tx.w || _steward_anywhere? body tx.w) then
    change (World.tell body "Only a Keymaster or a Steward resolves flags.") tx
  else match String.words words with
    | n :: how :: rest -> (
      let note = String.join " " rest;
      let said = if note == "" then how else "%{how}: %{note}";
      let why = if note == "" then "" else " %{note}";
      match Option.and_then (fn k -> World.flag k tx.w) (Result.to_option (String.to_int n)) with
      | Some f when !(_reviews? body f tx.w) ->
        change (World.tell body "There is no flag #%{n} for you to review.") tx
      | None -> change (World.tell body "There is no flag #%{n}.") tx
      | Some f when !f.open ->
        change (World.tell body "Flag #%{f.id} is resolved already: %{Option.default "" f.resolution}.") tx
      | Some f -> (
        -- A flag's owner is the person reported, or the owner of the work.
        match (how, f.owner) with
        | ("dismiss", _) -> _close body f said "Flag #%{f.id} dismissed." tx
        | ("private", _) -> if f.kind != "room" then
            change (World.tell body "Only a room is made private.") tx
          else
            tx
            |> change (World.set_allowed f.target (Driver.Only []))
            |> (match f.owner with
              | Some o -> change (World.notice o "A Keymaster made your room %{f.target} private: %{f.reason}.%{why}")
              | None -> fn t -> t)
            |> _close body f said "%{f.target} is private now."
        | ("remove", _) -> if f.kind != "object" then
            change (World.tell body "Only a thing is removed. A room is made private.") tx
          else if List.any? (fn x -> player? x tx.w) (World.contents f.target tx.w) then
            change (World.tell body "A player is in %{f.target}; it stays.") tx
          else (
            let removed =
              tx
              |> change (World.remove f.target)
              |> (match f.owner with
                | Some o -> change (World.notice o "A Keymaster removed your object %{f.target}: %{f.reason}.%{why}")
                | None -> fn t -> t);
            List.fold_left
              (fn acc (g: World.Flag) -> _close body g said "Flag #%{g.id} resolved." acc)
              removed
              (World.open_flags f.target removed.w)
          )
        | ("warn", Some o) ->
          tx
          |> change (World.notice o "A Keymaster warns you about %{_about f}: %{f.reason}.%{why}")
          |> _close body f said "%{o} is warned."
        | ("pause", Some _) when !(_keymaster? body tx.w) ->
          change (World.tell body "Only a Keymaster pauses an account.") tx
        | ("pause", Some o) ->
          tx
          |> _pause o "%{f.reason}.%{why}"
          |> _event World.Event(at = "", event = "pause", actor = body, name = Some o)
          |> _close body f said "%{o} is paused. /unpause %{o} lets them back."
        | ("warn", None) -> change (World.tell body "The Keymasters own %{f.target}; there is no one to warn.") tx
        | ("pause", None) -> change (World.tell body "The Keymasters own %{f.target}; there is no one to pause.") tx
        | _ -> change (World.tell body usage) tx
      )
    )
    | _ -> change (World.tell body usage) tx
)

-- /pause <name> and /unpause <name>, for a Keymaster.
let _set_paused body words paused (tx: Tx) =
  if !(_keymaster? body tx.w) then
    change (World.tell body "Only a Keymaster pauses an account.") tx
  else match World.account words tx.w with
    | None -> change (World.tell body "There is no one called %{words}.") tx
    | Some a -> (
      let changed =
        if paused then _pause a.name "a Keymaster will tell you why." tx
        else change (World.set_paused a.name false) tx;
      changed
      |> _event World.Event(
        at = "",
        event = if paused then "pause" else "unpause",
        actor = body,
        name = Some a.name
      )
      |> change
        (World.tell
          body
          (if paused then "%{a.name} is paused." else "%{a.name} may log in again."))
    )

-- The verbs whose lines a report can show.
let _speech = ["say", "pose"]

-- /pull, for a Keymaster: the git fiber comes up to the game's repo, and
-- the files that came in load as /update loads them.
let _pull body (tx: Tx) =
  if !(_keymaster? body tx.w) then
    change (World.tell body "Only a Keymaster pulls the Library.") tx
  else if !tx.w.git then
    change (World.tell body "This server does not keep its Library in git.") tx
  else
    tx
    |> change (World.ask_pull body)
    |> change (World.tell body "Pulling the Library from its repo.")

-- /help: the topics, or one of them.
let _help body words (w: World.Current) = (
  let topics =
    "Help topics: %{String.join ", " (List.sort (Map.keys w.help))}. Type /help and a topic.";
  if words == "" then World.tell body topics w
  else match Map.get (String.lower words) w.help with
    | Some text -> World.tell body (String.trim text) w
    | None -> World.tell body "There is no help on '%{words}'. %{topics}" w
)

-- A command line from a session that is logged in.
let _command_line sid body at line (tx: Tx) =
  if line == "" then tx
  else (
    let full = _expand line;
    let verb = String.lower (Option.default "" (String.word 0 full));
    let noted =
      _event
        World.Event(
          at = at,
          event = "command",
          actor = body,
          name = Some (short_of body tx.w),
          verb = Some verb,
          room = Some (room_of body tx.w),
          text = if verb == "say" then
              Some (String.trim (String.slice 3 (String.length full) full))
            else None
        )
        tx;
    -- What a body says is kept for a while, in case someone reports it.
    let said =
      if List.any? (fn v -> v == verb) _speech then change (World.said_by body full) noted
      else noted;
    -- A body whose account has not signed the current rules is taken to the
    -- Rules Hall, and the realms of where it stands say which commands work.
    let logged = if signed? body tx.w then said else _to_hall body said;
    match _command_ok body verb logged.w with
    | Error why -> change (World.tell body why) logged
    | Ok _ -> (
      match verb with
      | "/quit" ->
        logged |> change (World.tell body "Goodbye.") |> change (World.close_soon sid)
      | "/who" -> (
        match String.word 1 full with
        | Some name -> change (_who_is body name) logged
        | None -> change (_who body) logged
      )
      | "/examine" -> change (_examine body (_after_verb full)) logged
      | "/stat" -> _stat body (_after_verb full) logged
      | "/verbs" -> change (_verbs body (_after_verb full)) logged
      | "/copy" -> _copy body (_after_verb full) logged
      | "/dig" -> _dig body (_after_verb full) logged
      | "/files" ->
        change (World.tell body (_files body (_after_verb full) logged.w)) logged
      | "/help" -> change (_help body (_after_verb full)) logged
      | "/flag" -> _flag body (_after_verb full) logged
      | "/report" -> _report body (_after_verb full) logged
      | "/flags" -> change (_flags body (_after_verb full)) logged
      | "/resolve" -> _resolve body (_after_verb full) logged
      | "/pause" -> _set_paused body (_after_verb full) true logged
      | "/unpause" -> _set_paused body (_after_verb full) false logged
      | "/public" -> _set_public body (_after_verb full) true logged
      | "/private" -> _set_public body (_after_verb full) false logged
      | "/invite" -> _invite body (_after_verb full) true logged
      | "/uninvite" -> _invite body (_after_verb full) false logged
      | "/ban" -> _ban body (_after_verb full) true logged
      | "/unban" -> _ban body (_after_verb full) false logged
      | "/review" -> _review body (_after_verb full) logged
      | "/reviews" ->
        change (World.tell body (_reviews body (_after_verb full) logged.w)) logged
      | "/visit" -> _visit body (_after_verb full) logged
      | "/back" -> _back body logged
      | "/approve" -> _approve body (_after_verb full) logged
      | "/decline" -> _decline body (_after_verb full) logged
      | "/withdraw" -> _withdraw body (_after_verb full) logged
      | "/link" -> _link body (_after_verb full) logged
      | "/lock" -> _set_locked body (_after_verb full) true logged
      | "/unlock" -> _set_locked body (_after_verb full) false logged
      | "/edit" -> _edit body (_after_verb full) logged
      | "/update" -> _update body (_after_verb full) logged
      | "/pull" -> _pull body logged
      | "/reset" -> _reset body (_after_verb full) logged
      | "/eval" -> (
        match _after_verb full with
        | "" -> _eval_buffer body logged
        | expr -> eval body expr logged
      )
      | "/sethome" -> (
        let room = room_of body tx.w;
        logged
        |> change (World.set_home body room)
        |> change (World.tell body "%{short_of room tx.w} is your home now.")
      )
      | _ -> command body full logged
    )
  )

-- The input hook of the room `body` is in, when it takes `line`: every
-- line while the room takes raw text, as the editor does after `a`, and
-- otherwise every line but a driver command.
let _input_of body line (w: World.Current) =
  match World.instance (room_of body w) w with
  | None -> None
  | Some i -> (
    match i.object.input with
    | None -> None
    | Some f -> (
      let raw =
        (match i.object.props with
         | Some p -> (
           match Map.get "raw" (p (_seen w body i.id)) with
           | Some j -> Result.default false (JSON.get_bool j)
           | None -> false
         )
         | None -> false);
      if raw || !(String.starts_with? "/" (String.trim line)) then Some (i.id, f) else None
    )
  )

-- A line from a session that is logged in. A room with an input hook
-- gets it as typed, spaces and all; anything else is a command.
let _play sid body at line (tx: Tx) =
  match _input_of body line tx.w with
  | Some(room, f) -> (let ctx = ctx_for tx.w room body; run ctx (fn () -> f ctx line) tx)
  | None -> _command_line sid body at (String.trim line) tx

-- A line from a session that has not logged in goes to /std/login, whole.
let _to_login sid line (tx: Tx) =
  match World.instance (login_id tx.w) tx.w with
  | None -> tx
  | Some i -> (
    match i.object.input with
    | None -> tx
    | Some f -> (
      let ctx =
        Driver.Context(
          self = login_id tx.w,
          actor = sid,
          here = login_id tx.w,
          world = view tx.w sid,
          time = tx.w.now
        );
      run ctx (fn () -> f ctx line) tx
    )
  )

-- ── Git ────────────────────────────────────────────────────────────────

-- The blueprint path of a file under the Library, as /r/home/bo/lamp for
-- r/home/bo/lamp.wand, when it is a Library file the driver loads.
let _pulled_path file =
  if !(String.ends_with? ".wand" file) || file == "init.wand" then None
  else Some "/%{String.slice 0 (String.length file - 5) file}"

-- `n` of `thing`, as 1 blueprint or 2 blueprints.
let _count n thing = if n == 1 then "1 %{thing}" else "%{n} %{thing}s"

-- The files under the Library that changed under the driver, from it. Each
-- blueprint that is there loads again as /update loads it, and the help
-- topics are read again. `actor` is told what came in.
let pulled actor (files: List String) (tx: Tx) =
  let who = Option.default "" actor;
  let loads =
    List.filter
      (fn p -> Scan.claims? "Blueprint" (Option.default "" (Files.read tx.w.lib_root p)))
      (List.filter_map _pulled_path files);
  let help = Result.default tx.w.help (try Library.help! tx.w.lib_root);
  let helped =
    if List.any? (fn f -> String.starts_with? "help/" f) files then
      change (fn w -> World.Current(w, help = help)) tx
    else tx;
  let restart =
    if List.any? (fn f -> f == "init.wand") files then
      " init.wand changed: restart the server to load it."
    else "";
  let told =
    if files == [] then "The Library is up to date."
    else "Pulled %{_count (List.length files) "changed file"}, and loaded %{_count (List.length loads) "blueprint"} again.%{restart}";
  List.fold_left (fn acc p -> update who p acc) helped loads
  |> _event World.Event(
    at = "",
    event = "pull",
    actor = who,
    text = Some (String.join " " files)
  )
  |> change (World.tell who told)

let run_input (i: World.Input) (tx: Tx) =
  match i with
  | World.Connect sid _ -> verb (login_id tx.w) sid "connect" tx
  | World.Line sid at line -> (
    match World.session sid tx.w with
    | None -> tx
    -- A session that is closing, after /quit say, runs nothing more: the
    -- reader may have queued lines the client sent after it.
    | Some s when s.closing -> tx
    | Some s -> (
      match s.body with
      | None -> _to_login sid line tx
      | Some body -> _play sid body at line tx
    )
  )
  | World.Gone sid _ body -> (
    match body with
    | Some b ->
      tx
      |> _tell_room (room_of b tx.w) b "%{short_of b tx.w} falls asleep."
      |> change (World.seen b tx.at)
    | None -> verb (login_id tx.w) sid "done" tx
  )
  | World.Pulled _ actor files -> pulled actor files tx

-- ── The loop ───────────────────────────────────────────────────────────

-- The rooms, services and realms that exist before anyone connects.
let boot state at =
  let now = Shared.get state;
  let start = begin now at |> _ensure (login_id now) |> _ensure (arrival now);
  let honored = List.filter (fn p -> file_owner p start.w == None) (Map.keys start.w.realms);
  let tx = List.fold_left (fn t p -> _ensure (realm_id p) t) start honored;
  Shared.update state (commit tx)

-- Take every queued input, in order. Each is applied in its own update,
-- and taken off the queue in the same update, so a session can see when
-- the driver has finished with everything it sent.
let step state =
  let (w: World.Current) = Shared.get state;
  List.each
    (fn i ->
      let tx = run_input i (begin (Shared.get state) (World.at_of i));
      Shared.update state (fn cur -> World.dequeued 1 (commit tx cur)))
    w.inputs

-- ── Time ───────────────────────────────────────────────────────────────

-- Whether the owner of `id` has Inspiration left for its heartbeat and
-- call-outs. Until it refills, they wait.
let _owner_inspired? id (w: World.Current) =
  let owner = World.owner_of id w;
  _exempt? owner w || Result.ok? (_inspired (Option.default "" owner) 1 w)

-- Call `id` on its own, with itself as the actor, and charge its owner the
-- steps the call took.
let _on_its_own id body (tx: Tx) =
  let ctx = ctx_for tx.w id id;
  let (ran, steps) = run_counted ctx (fn () -> body ctx) tx;
  _spend (World.owner_of id tx.w) (Inspiration.of_steps steps) ran

let _beat id (tx: Tx) =
  match World.instance id tx.w with
  | Some i -> (
    match i.object.heartbeat with
    | Some h when _owner_inspired? id tx.w -> _on_its_own id (fn ctx -> h ctx) tx
    | _ -> tx
  )
  | None -> tx

-- Run call-out `c`, or None when it must wait for its owner's Inspiration.
-- One whose object is gone, or has no such verb, is dropped.
let _call_out (c: World.Callout) (tx: Tx) =
  match World.instance c.target tx.w with
  | None -> Some (change (World.ran c.id) tx)
  | Some i -> (
    if !(_owner_inspired? c.target tx.w) then None
    else match List.find
      (fn (v: Driver.Verb) -> List.any? (fn n -> Driver.names? n c.verb) v.names)
      i.object.verbs with
      | None ->
        Some
          (tx
          |> change (World.ran c.id)
          |> _event World.Event(
            at = "",
            event = "refused",
            actor = c.target,
            text = Some "call-out: no verb %{c.verb}"
          ))
      | Some v ->
        Some
          (tx
          |> change (World.ran c.id)
          |> _on_its_own c.target (fn ctx -> v.run ctx Driver.Parsed(verb = c.verb)))
  )

-- One tick: call every object with a heartbeat, then run every call-out
-- whose time has come, oldest first. Each is applied in its own update, as
-- an input is. What a heartbeat or a call-out starts waits for the next
-- tick.
let tick state at = (
  let (w: World.Current) = Shared.get state;
  List.each
    (fn id ->
      let tx = _beat id (begin (Shared.get state) at);
      Shared.update state (commit tx))
    (Map.keys w.beating);
  List.each
    (fn (c: World.Callout) -> (
      let tx = begin (Shared.get state) at;
      -- A heartbeat or an earlier call-out may have removed it.
      let ran = if World.pending_callout? c.id tx.w then _call_out c tx else None;
      match ran with
      | Some done -> (let _ = Shared.update state (commit done); ())
      | None -> ()
    ))
    (World.due (begin w at).w.now w)
)

-- ── Snapshots ──────────────────────────────────────────────────────────

-- Call `save` on every object that changed since the last snapshot, and
-- write the file. The driver fiber runs this between inputs, and it is the
-- only fiber that changes an object, so no object is caught halfway
-- through a change. A `save` that faults is logged, and that object is
-- left out of the file.
let snapshot! state path at = (
  let (w: World.Current) = Shared.get state;
  let results =
    List.filter_map
      (fn (i: World.Instance) -> match i.saved with
        | Some _ -> None
        | None -> Some (
          i.id,
          Result.and_then
            (fn j ->
              let size = String.length (JSON.stringify j);
              if size > max_saved i.blueprint w then
                Error
                  "its saved state is %{size} bytes, and the most is %{max_saved i.blueprint w}"
              else Ok j)
            (_call (fn () -> i.object.save ()))
        )
      )
      (Map.values w.instances);
  let kept (cur: World.Current) =
    List.fold_left
      (fn acc (id, r) -> match r with
        | Ok j -> World.keep_saved id j acc
        | Error why ->
          World.emit
            World.Event(at = at, event = "fault", actor = id, text = Some "save: %{why}")
            acc
      )
      cur
      results;
  Shared.update state (fn cur -> World.snapshot_taken (kept cur));
  Snapshot.write! path (Snapshot.of_world (Shared.get state))
)

-- Who owns an object a snapshot kept. A version 1 file did not keep
-- owners, so there a body is its account's and anything else is the owner
-- of its file.
let _restored_owner (f: Snapshot.File) (s: Snapshot.Saved) (w: World.Current) =
  if f.version >= 2 then s.owner
  else match List.find (fn (a: World.Account) -> a.body == s.id) f.accounts with
    | Some a -> Some (String.lower a.name)
    | None -> file_owner s.blueprint w

-- Who may enter a room a snapshot kept: everyone when it was public, and
-- otherwise whom it invited. Before rooms were private, a room the Keymasters
-- owned was public.
let _restored_allowed (f: Snapshot.File) (s: Snapshot.Saved) (w: World.Current) =
  if Option.default (_restored_owner f s w == None) s.public then Driver.Everyone
  else Driver.Only s.invited

-- An account a snapshot kept, in today's terms. Before the roles were
-- named, a Keymaster was "admin" and a Citizen "builder", and an account
-- did not keep when it was made: then it is when its body was made.
let _restored_account (f: Snapshot.File) (a: World.Account) =
  let role =
    match a.role with
    | "admin" -> "keymaster"
    | "builder" -> "citizen"
    | r -> r
  in
  let made =
    Option.and_then
      (fn (s: Snapshot.Saved) -> Option.and_then
        (fn c -> Result.to_option (String.to_datetime c))
        s.created)
      (List.find (fn (s: Snapshot.Saved) -> s.id == a.body) f.instances);
  World.Account(a, role = role, created = if a.created == None then made else a.created)

-- Bring back what a snapshot kept: the accounts, then every object, made
-- again by its blueprint's `create` from its saved state, and the
-- call-outs. One that came due while the server was down runs at the
-- first tick.
let restore state (f: Snapshot.File) at =
  let accounts =
    List.fold_left
      (fn t (a: World.Account) -> change (World.add_account (_restored_account f a)) t)
      (begin (Shared.get state) at
      |> change (fn w ->
        World.Current(
          w,
          flags = f.flags,
          requests = f.requests,
          adopted = f.adopted,
          built = f.built
        ))
      |> change (World.restore_callouts f.callouts))
      f.accounts;
  let tx =
    List.fold_left
      (fn t (s: Snapshot.Saved) -> t
      |> _create s.id s.blueprint (Some s.state) s.env (_restored_owner f s t.w)
      |> change (World.set_made s.id s.creator s.created s.modified)
      |> change (World.keep_saved s.id s.state)
      |> change (World.set_access s.id (_restored_allowed f s t.w) s.locked)
      |> change (World.set_held s.id s.held))
      accounts
      f.instances;
  Shared.update state (commit tx)

-- Make an account and its body in the arrival room, with no session: how
-- `wmd init` makes the first Keymaster.
let make_account state name typed role at =
  let t = begin (Shared.get state) at;
  let body = "%{player_bp t.w}#%{World.next_number (player_bp t.w) t.w}";
  let saved = JSON.of_map (Map.from_list [("name", JSON.of_string name)]);
  let hashed = Password.hash t.w.pepper (Random.hex 32) typed;
  let tx =
    t
    |> _ensure (arrival t.w)
    |> _create
      body
      (player_bp t.w)
      (Some saved)
      (Some (arrival t.w))
      (Some (String.lower name))
    |> change
      (World.add_account World.Account(
        name = name,
        body = body,
        password = hashed,
        role = role,
        created = Some t.w.now
      ));
  Shared.update state (commit tx)
