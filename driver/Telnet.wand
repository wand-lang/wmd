-- What a telnet client sends that is not text.
--
-- The driver does no option negotiation. It drops every IAC sequence and the
-- `\r` that ends each line, and keeps the rest.

import Regex
import String

-- IAC (byte 255) starts a command. Three shapes are dropped, longest first:
-- a subnegotiation (IAC SB ... IAC SE), an option (IAC WILL, WONT, DO or
-- DONT, then one byte), and any other two-byte command.
let _iac = r/\xff\xfa.*?\xff\xf0|\xff[\xfb-\xfe].|\xff./

-- A line as the player typed it: no IAC sequences, no trailing `\r`.
let clean line = Regex.replace_all _iac "" line |> String.trim_right
