uses {FS.Read, FS.Write}

-- world.json: what survives a restart. The accounts, and every object's
-- blueprint, place and saved state. Sessions are not in it, so after a
-- restart everyone logs in again and finds their body where they left it.
-- The pepper is not in it either.

import FS
import JSON
import List
import Map
import Option
import Result

import ./World

-- One object as the file keeps it.
type Saved(
  id: String,
  blueprint: String,
  env: Option String = None,
  state: JSON,
  creator: Option String = None,
  created: Option String = None,
  modified: Option String = None,
  owner: Option String = None,
  -- None in a file from before rooms were private: a room is then public
  -- when the admins own it.
  public: Option Bool = None,
  invited: List String = [],
  locked: Bool = true,
  held: Bool = false
)

-- Version 1 did not keep owners. A file with no version is version 1.
type File(
  version: Int = 1,
  accounts: List World.Account,
  instances: List Saved,
  flags: List World.Flag = []
)

-- The file for a world whose every instance has its saved state. An
-- instance with none -- its `save` faulted -- is left out, rather than
-- written as something it never said.
let of_world (w: World.World) =
  File(
    version = 2,
    accounts = Map.values w.accounts,
    flags = w.flags,
    instances =
      List.filter_map
        (fn (i: World.Instance) -> Option.map
          (fn s -> Saved(
            id = i.id,
            blueprint = i.blueprint,
            env = i.env,
            state = s,
            creator = i.creator,
            created = i.created,
            modified = i.modified,
            owner = i.owner,
            public = Some i.public,
            invited = i.invited,
            locked = i.locked,
            held = i.held
          ))
          i.saved)
        (Map.values w.instances)
  )

-- Written whole to a temporary file and moved into place, so a crash while
-- writing leaves the last snapshot, never half of this one.
let write! path (f: File) = FS.write_atomic! path (JSON.stringify_pretty (File.encoder f))

-- The file at `path`, or None when there is none: a world that has never
-- been saved.
let read! path =
  if FS.exists? path then
    Some (Result.get! (JSON.decode File.decoder (JSON.read_file! path)))
  else None
