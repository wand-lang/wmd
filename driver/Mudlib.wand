uses {FS.Read}

-- Loading the mudlib: every file under the mudlib directory that claims
-- Core.Blueprint, as its module, and every one that also claims Core.Realm,
-- as a realm. Each file is checked and gated as it loads, so a file that
-- fails is left out and says why, and the rest of the world still starts.

import FS
import List
import Path
import String
import Map
import Wand

let Core = import ../lib/std/core
import ./Scan
import ./World

-- The blueprints and realms that loaded, by path, and each file that did
-- not, with why.
type Loaded(
  lib: Map Core.Blueprint = {},
  realms: Map Core.Realm = {},
  failed: List (String, String) = []
)

let _realm (l: Loaded) (b: Scan.Blueprint) =
  if !b.realm then l
  else match Wand.load Core.Realm.loader b.file with
    | Ok r -> Loaded(l, realms = Map.set b.path r l.realms)
    | Error why -> Loaded(l, failed = List.concat l.failed [(b.path, why)])

let load_all! root =
  List.fold_left
    (fn (l: Loaded) (b: Scan.Blueprint) -> match Wand.load Core.Blueprint.loader b.file with
      | Ok bp -> _realm Loaded(l, lib = Map.set b.path bp l.lib) b
      | Error why -> Loaded(l, failed = List.concat l.failed [(b.path, why)])
    )
    Loaded()
    (Scan.blueprints! root)

-- `w` with the blueprints and realms of the mudlib at `root`.
let with_lib! root (w: World.World) =
  let loaded = load_all! root;
  World.World(w, lib = loaded.lib, realms = loaded.realms)

-- The help topics: each text file in the mudlib's help/, by its name, as
-- rules for help/rules.txt. No help/ is no topics.
let help! root =
  let dir = Path.join root ./help;
  if !(FS.dir? dir) then Map.empty
  else
    Map.from_list
      (List.map
        (fn f ->
          let name = Path.to_string (Path.basename f);
          (String.slice 0 (String.length name - 4) name, FS.read_file! f))
        (FS.glob_in *.txt dir))
