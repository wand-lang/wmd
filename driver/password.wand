-- Passwords, as the driver keeps them: "hmac-sha256$<salt>$<hex>".
--
-- The salt is made fresh for each password and is not secret; it makes two
-- equal passwords hash differently. The pepper is the server's secret, from
-- WMD_PEPPER, and is never written to a file, so a copy of world.json
-- alone cannot be used to test guesses. The method is written first, so a
-- stronger one can be added beside it.

import Digest
import Hash
import String

let _method = "hmac-sha256"

let _digest pepper salt password = Hash.hmac Digest.Sha256 pepper "%{salt}:%{password}"

let hash pepper salt password =
  "%{_method}$%{salt}$%{Digest.hex (_digest pepper salt password)}"

-- Whether `password` is the one `stored` was made from. The digests are
-- compared in constant time: the stored one came from the password's owner,
-- and the other from whoever is typing.
let matches? pepper stored password =
  match String.split "$" stored with
  | [method, salt, hex] -> (
    if method != _method then false
    else match Digest.of_hex Digest.Sha256 hex with
      | Ok want -> Hash.equal? want (_digest pepper salt password)
      | Error _ -> false
  )
  | _ -> false
