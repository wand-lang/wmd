uses {FS.Read, FS.Write}

-- /eval: an expression, run as mudlib code runs.
--
-- The expression becomes the body of `run ctx`, in a module written for it
-- that implements core.Evaluation. The module is checked first, which
-- gives the expression's type, and then loaded as a mudlib file is: held
-- to the effects `evaluate` allows. A list of actions comes back as
-- actions; anything else comes back as text, with its type.

import FS
import List
import Path
import Regex
import Result
import String
import Wand

let core = import ../lib/std/core

-- The lines before the expression, which it is indented under: the pure
-- standard modules, Random, which mudlib code may use, and the contract.
let _head core_path = [
  "import Int",
  "import JSON",
  "import List",
  "import Map",
  "import Option",
  "import Random",
  "import Result",
  "import String",
  "let core = import %{core_path}",
  "",
  "let run (ctx: core.Ctx) = ("
]

let _indent expr = String.join "\n" (List.map (fn l -> "  %{l}") (String.lines expr))

-- `run` itself, and nothing that uses it: what the check reads.
let _body core_path expr = "%{String.join "\n" (_head core_path)}\n%{_indent expr}\n)\n"

-- The type an /eval shows: `run`'s result, without the `Ctx -> ` before it,
-- and without what `run` performs, which a type writes at its end. When
-- the result is a function, the effects at the end are the function's own.
let result_type t =
  let shown =
    if String.starts_with? "Ctx -> " t then String.slice 7 (String.length t) t else t;
  if String.contains? "->" shown then shown
  else String.trim (Regex.replace r/ ! \{[^}]*\}$/ "" shown)

-- Text as a string literal says it.
let _quoted s = String.replace `"` `\"` (String.replace `\` `\\` s)

-- The module for `expr`, whose result has type `t`.
let source core_path expr t =
  let evaluate =
    if t == "List Action" then "core.Acts (run ctx)"
    else "core.Shown \"\%{run ctx} : %{_quoted t}\"";
  "%{_body core_path expr}\nimplement core.Evaluation =\n  let evaluate ctx = %{evaluate}\n"

-- What the check found wrong with the expression, each error at its line
-- in the expression rather than in the module written for it. An error
-- about the whole expression points at the `(` around it, and is shown
-- with no position.
let _errors (c: Wand.Checked) =
  List.filter_map
    (fn (d: Wand.Diagnostic) -> if d.severity == "error" then
        Some
          (if d.line > List.length (_head "") then
            "%{d.line - List.length (_head "")}:%{d.col}: %{d.message}"
          else d.message)
      else None)
    c.diagnostics

-- The expression's module, loaded, or what was wrong with it. `lib` is the
-- mudlib root, whose std/core.wand the module imports, so its types are
-- the driver's.
let load (lib: Path) expr = (
  let core_path =
    Path.to_string
      (Path.normalize
        (Path.join (if Path.absolute? lib then lib else Path.join (FS.cwd ()) lib) ./std/core));
  -- The module's file is needed only while it loads.
  let loaded =
    try with FS.temp_dir "wmd_eval_" as dir -> (
      let file = Path.join dir ./eval.wand;
      match Wand.check_at file "%{_body core_path expr}run\n" with
      | Error why -> Error [why]
      | Ok c -> (
        match (_errors c, c.type) with
        | ([], Some t) -> (
          match FS.write_file file (source core_path expr (result_type t)) with
          | Error why -> Error [why]
          | Ok _ ->
            Result.map_error (fn why -> [why]) (Wand.load core.Evaluation.loader file)
        )
        | ([], None) -> Error ["the expression has no type"]
        | (errors, _) -> Error errors
      )
    );
  match loaded with
  | Ok r -> r
  | Error why -> Error [why]
)
