uses {Random}

-- The Rules Hall: where an account that has not signed the current rules
-- wakes. Its description is the rules, and `sign rules` is the way out.

import JSON
import Option

let Core = import ../../std/core

let _rules (ctx: Core.Context) =
  Option.default
    "The rules should be written here, but the wall is blank. Tell an admin."
    (ctx.world.help_of "rules")

let hall =
  Core.Object(
    names = [],
    short = fn _ -> "The Rules Hall",
    long = fn ctx -> `
A quiet hall. The rules are written on the wall:

%{_rules ctx}

When you have read them, type: sign rules`,
    verbs = [
      Core.Verb(names = ["read"], run = fn ctx _ -> Core.tell ctx (_rules ctx)),
      Core.Verb(
        names = ["sign"],
        run = fn ctx p -> if p.rest != "rules" then Core.tell ctx "Type: sign rules"
          else Core.Reply(
            actions = [
              Core.Tell ctx.actor "You sign the rules. Thank you, and welcome.",
              Core.Acknowledge ctx.actor
            ]
          )
      )
    ],
    save = fn () -> JSON.null
  )

implement Core.Blueprint =
  let create _ _ = Core.Init(object = hall)
