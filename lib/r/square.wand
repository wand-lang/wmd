uses {Random}

-- The arrival room: where everyone first stands.

let Core = import ../std/core
let Room = import ../std/room

let square =
  Core.Object(
    Room.room
      "The Commons"
      "A wide, quiet square. Doors of every size stand along its edges, all of them shut for now, but for one to the west, with LEARNING painted over it.",
    exits = {
      north = Room.exit "/r/garden",
      -- What `look west` shows: the exit's own view, as through a window.
      west =
        Core.Exit(
          Room.exit "/r/learning/hall",
          view = Some "Through the open door to the west, a long hall lined with numbered doors."
        )
    },
    details = {
      doors = Room.text
        "Doors of wood, of iron, of glass; one is no taller than your knee. Only the one to the west will open.",
      door = Room.text "Which one? There are dozens, and all of them are shut."
    }
  )

-- A new square gets its lever. A restored one already has it.
implement Core.Blueprint =
  let create self saved = match saved with
  | None -> Core.Init(object = square, actions = [Core.Spawn "/r/lever" self])
  | Some _ -> Core.Init(object = square)
