uses {Random}

-- The room of lesson 3. Its example is the cat, which may have wandered
-- off.

let Core = import ../../std/core
let Room = import ../../std/room

let cats =
  Core.Object(
    Room.room
      "Lesson 3: The Cat Room"
      "A sunny room with a basket in one corner. A grey cat lives here, when it is not out wandering. Read /help lesson3, then /copy cat to make it yours.",
    exits = {hall = Room.exit "/r/learning/hall"},
    details = {basket = Room.text "A wicker basket, full of grey hair."}
  )

implement Core.Blueprint =
  let create self saved = match saved with
  | None -> Core.Init(object = cats, actions = [Core.Spawn "/r/learning/cat" self])
  | Some _ -> Core.Init(object = cats)
