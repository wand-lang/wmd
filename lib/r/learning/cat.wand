uses {Random}

-- Lesson 3: a cat that wanders.
--
-- `heartbeat` is called every 2 seconds. Most of the time the cat does
-- nothing. Random.int picks a number, and `match` picks what to do with it:
-- wash, yawn, or walk out of the room through one of its exits.

import JSON
import List
import Map
import Random
import String

let Core = import ../../std/core
let Text = import ../../std/text

-- The ways out of the room the cat is in. It stays in the Learning Hall
-- and its lessons.
let _ways (ctx: Core.Context) =
  List.filter
    (fn (_, e) -> String.starts_with? "/r/learning/" e.to)
    (Map.to_list (ctx.world.exits_of ctx.here))

-- Leave by a way picked at random. The first Say is heard in the room the
-- cat leaves. The Move takes it away, so the second Say is heard where it
-- arrives.
let _wander (ctx: Core.Context) =
  match Random.choose (_ways ctx) with
  | Some(name, e) -> Core.Reply(
    actions = [
      Core.Say "The grey cat pads off to the %{name}.",
      Core.Move ctx.self e.to,
      Core.Say "A grey cat pads in and looks around."
    ]
  )
  | None -> Core.nothing

let cat =
  Core.Object(
    names = ["cat", "grey cat"],
    short = fn _ -> "grey cat",
    long = fn _ -> "A grey cat with one white paw. It looks at you as if you were late.",
    verbs = [
      Core.Verb(
        names = ["pet", "stroke"],
        dobj = Core.This,
        run = fn ctx _ -> Core.Reply(
          actions =
            Text.act
              ctx
              "You stroke the grey cat. It purrs."
              "%{ctx.world.short_of ctx.actor} strokes the grey cat. It purrs."
        )
      )
    ],
    heartbeat = Some (fn ctx ->
      match Random.int 0 29 with
      | 0 -> Core.Reply(actions = [Core.Say "The grey cat washes its white paw."])
      | 1 -> Core.Reply(actions = [Core.Say "The grey cat yawns."])
      | 2 -> _wander ctx
      | _ -> Core.nothing),
    save = fn () -> JSON.null
  )

implement Core.Blueprint =
  let create _ _ = Core.Init(object = cat)
