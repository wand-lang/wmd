uses {Random}

-- A player's body. The everyday commands are verbs here, so anyone can read
-- how they work. The driver only parses a line, matches it to a verb and
-- applies the actions the verb gives back.

import JSON
import List
import Map
import Option
import Result
import String

let Core = import ./core
let Text = import ./text

type State(name: String = "someone")

-- The people already in `room`, who see someone arrive.
let _in (ctx: Core.Context) room = List.filter ctx.world.player? (ctx.world.contents room)

-- ── look ───────────────────────────────────────────────────────────────

-- The line about a room's exits. A room whose way out is not an exit, such
-- as the editor, which `q` leaves, says so with an `exits` prop.
let _way_out (w: Core.World) room exits =
  match Option.and_then (fn j -> Result.to_option (JSON.get_string j)) (w.prop room "exits") with
  | Some line -> line
  | None -> if exits == [] then "There is no way out."
    else "Exits: %{String.join ", " exits}."

let _room (ctx: Core.Context) =
  let w = ctx.world;
  let here = List.filter (fn o -> o != ctx.actor) (w.contents ctx.here);
  let people = List.filter w.player? here;
  let things = List.filter (fn o -> !(w.player? o)) here;
  let exits = Map.keys (w.exits_of ctx.here);
  let lines =
    List.flatten [
      [w.short_of ctx.here, w.long_of ctx.here],
      if things == [] then []
      else ["You see %{Text.listing (List.map (fn o -> Text.a (w.short_of o)) things)}."],
      [_way_out w ctx.here exits],
      List.map
        (fn p -> if w.awake? p then "%{w.short_of p} is here."
          else "%{w.short_of p} is here, asleep.")
        people
    ];
  Core.tell ctx (String.join "\n" lines)

-- `look at window`: a detail of the room, or of something in it or held.
let _detail (ctx: Core.Context) words = (
  let w = ctx.world;
  let places = List.flatten [[ctx.here], w.contents ctx.here, w.contents ctx.actor];
  match List.head (List.filter_map (fn o -> w.detail_of o words) places) with
  | Some d -> Core.tell ctx d
  | None -> Core.tell ctx "You don't see a '%{words}' here."
)

-- `look`, `look lever`, `look at lever`, `look at window`.
let _look (ctx: Core.Context) (p: Core.Parsed) = (
  let words =
    String.trim
      (if String.starts_with? "at " p.rest then String.slice 3 (String.length p.rest) p.rest
      else p.rest);
  match (p.dobj, p.iobj) with
  | (Some o, _) -> Core.tell ctx (ctx.world.long_of o)
  | (None, Some o) -> Core.tell ctx (ctx.world.long_of o)
  | _ -> if words == "" || words == "here" then _room ctx else _detail ctx words
)

-- ── home ───────────────────────────────────────────────────────────────

let _home (s: State) (ctx: Core.Context) _ =
  let home = ctx.world.home_of ctx.actor;
  if home == ctx.here then Core.tell ctx "You are home already."
  else Core.Reply(
    actions = List.flatten [
      List.map (fn o -> Core.Tell o "%{s.name} goes home.") (Text.others ctx),
      List.map (fn o -> Core.Tell o "%{s.name} comes home.") (_in ctx home),
      [Core.Move ctx.actor home]
    ]
  )

-- ── go ─────────────────────────────────────────────────────────────────

let _opposites = Map.from_list [
  ("north", "the south"),
  ("south", "the north"),
  ("east", "the west"),
  ("west", "the east"),
  ("up", "below"),
  ("down", "above")
]

let _arrival name dir =
  match Map.get dir _opposites with
  | Some from -> "%{name} arrives from %{from}."
  | None -> "%{name} arrives."

let _go (s: State) (ctx: Core.Context) (p: Core.Parsed) = (
  let dir = String.lower (String.trim p.rest);
  match Map.get dir (ctx.world.exits_of ctx.here) with
  | None -> Core.tell ctx (if dir == "" then "Go where?" else "You can't go that way.")
  | Some e -> (
    let check = Option.default (fn _ -> Ok()) e.check;
    match check ctx with
    | Error why -> Core.tell ctx why
    | Ok _ -> Core.Reply(
      actions = List.flatten [
        List.map
          (fn o -> Core.Tell o (Option.default "%{s.name} leaves %{dir}." e.leave))
          (Text.others ctx),
        List.map
          (fn o -> Core.Tell o (Option.default (_arrival s.name dir) e.arrive))
          (_in ctx e.to),
        [Core.Move ctx.actor e.to]
      ]
    )
  )
)

-- ── talk ───────────────────────────────────────────────────────────────

let _say (s: State) (ctx: Core.Context) (p: Core.Parsed) =
  if p.rest == "" then Core.tell ctx "Say what?"
  else Core.Reply(actions = Text.act ctx `You say "%{p.rest}"` `%{s.name} says "%{p.rest}"`)

-- `pose sits down.` shows "Ann sits down." to everyone, Ann too.
let _pose (s: State) (ctx: Core.Context) (p: Core.Parsed) =
  if p.rest == "" then Core.tell ctx "Pose what?"
  else Core.Reply(actions = Text.act ctx "%{s.name} %{p.rest}" "%{s.name} %{p.rest}")

-- `semipose 's cat purrs.` shows "Ann's cat purrs.": no space after the name.
let _semipose (s: State) (ctx: Core.Context) (p: Core.Parsed) =
  if p.rest == "" then Core.tell ctx "Semipose what?"
  else Core.Reply(actions = Text.act ctx "%{s.name}%{p.rest}" "%{s.name}%{p.rest}")

-- ── socials ────────────────────────────────────────────────────────────

-- A social is a short action with a fixed text: what the actor sees, what
-- the room sees, and, `at` someone, what that one sees.
type Social(you: String, them: String)

let _socials = Map.from_list [
  ("smile", Social(you = "smile", them = "smiles")),
  ("grin", Social(you = "grin", them = "grins")),
  ("laugh", Social(you = "laugh", them = "laughs")),
  ("nod", Social(you = "nod", them = "nods")),
  ("wave", Social(you = "wave", them = "waves")),
  ("bow", Social(you = "bow", them = "bows")),
  ("shrug", Social(you = "shrug", them = "shrugs")),
  ("sigh", Social(you = "sigh", them = "sighs")),
  ("frown", Social(you = "frown", them = "frowns")),
  ("wink", Social(you = "wink", them = "winks"))
]

-- `wave` or `wave at Bo`. Bo sees "Ann waves at you.".
let _social (s: State) (ctx: Core.Context) (p: Core.Parsed) =
  match Map.get p.verb _socials with
  | None -> Core.nothing
  | Some so -> (
    let target =
      (match p.iobj with
       | Some o -> Some o
       | None -> p.dobj);
    match target with
    | None when p.prep == Some "at" ->
      Core.tell
        ctx
        "You don't see a '%{String.trim (String.slice 3 (String.length p.rest) p.rest)}' here."
    | None -> Core.Reply(actions = Text.act ctx "You %{so.you}." "%{s.name} %{so.them}.")
    | Some t when t == ctx.actor -> Core.Reply(
      actions =
        Text.act ctx "You %{so.you} at yourself." "%{s.name} %{so.them} at themself."
    )
    | Some t -> (
      let name = ctx.world.short_of t;
      Core.Reply(
        actions =
          Core.Tell ctx.actor "You %{so.you} at %{name}." :: List.map
            (fn o -> Core.Tell
              o
              (if o == t then "%{s.name} %{so.them} at you."
              else "%{s.name} %{so.them} at %{name}."))
            (Text.others ctx)
      )
    )
  )

-- ── the body ───────────────────────────────────────────────────────────

let _verb names run = Core.Verb(names, run)

let make (s: State) =
  Core.Object(
    names = [String.lower s.name],
    short = fn _ -> s.name,
    long = fn _ -> "%{s.name} looks like a person.",
    verbs = [
      _verb ["look", "l"] _look,
      _verb ["go"] (_go s),
      _verb ["say"] (_say s),
      _verb ["pose"] (_pose s),
      _verb ["semipose"] (_semipose s),
      _verb ["home"] (_home s),
      _verb (Map.keys _socials) (_social s)
    ],
    save = fn () -> State.encoder s
  )

-- The driver spawns a body with its name already in `saved`.
implement Core.Blueprint =
  let create _ saved = match saved with
  | None -> Core.Init(object = make State())
  | Some j -> Core.Init(object = make (Result.get! (JSON.decode State.decoder j)))
