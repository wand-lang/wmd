-- Helpers for a realm's file. A realm implements Driver.Blueprint, for its
-- one object, and Driver.Realm, for its rules:
--
--   implement Driver.Blueprint =
--     let create _ _ = Driver.Init(object = Realm.object "the Learning realm" [])
--
--   implement Driver.Realm =
--     let commands = Realm.anything;
--     let allows = Realm.anything;
--     let allowed = Driver.Everyone;
--     let contracts = [];
--     let charter = Realm.no_charter

import JSON

let Driver = import ./driver

-- A realm's object: what to call it, and the verbs every room in the realm
-- answers to after its own. No one stands in it, and it keeps nothing.
let object short verbs =
  Driver.Object(
    names = [],
    short = fn _ -> short,
    long = fn _ -> short,
    verbs = verbs,
    save = fn () -> JSON.null
  )

-- A rule that allows every command or action.
let anything _ _ = Ok()

-- The charter of a realm with no realms inside it, or of one the realm
-- says nothing of: the Keymasters own its files, and it has no Stewards
-- and no grants.
let no_charter _ = Driver.Charter()
