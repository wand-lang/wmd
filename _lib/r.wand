uses {Random}

-- The Commons: the root realm, and the hub of the world. Every other realm
-- is in it, behind its doors, and its verbs and rules hold everywhere
-- under /r unless a realm nearer a room has its own. It has no realm above
-- it, so no one can name its Stewards: it is the Keymasters' alone, and so
-- are the charters it gives the realms in it.
--
-- `look` and `go` are its verbs, after the player's own and the room's, so
-- a realm can have its own: a dark realm's `look` that sees nothing, say.

import JSON
import List
import Map
import Option
import Result
import String

let Driver = import github.com/wand-lang/wmd/driver
let Realm = import ./std/realm
let Text = import ./std/text

-- The people already in `room`, who see someone arrive.
let _in (ctx: Driver.Context) room = List.filter ctx.world.player? (ctx.world.contents room)

-- ── look ───────────────────────────────────────────────────────────────

-- The directions an exit can point, in the order the exits paragraph
-- names them.
let _directions = ["north", "south", "east", "west", "up", "down"]

let _compass? name = List.any? (fn d -> d == name) (List.take 4 _directions)

let _direction? name = List.any? (fn d -> d == name) _directions

-- How a sentence about a direction starts: "To the north", "Above" or
-- "Below".
let _toward name =
  if name == "up" then "Above" else if name == "down" then "Below" else "To the %{name}"

-- What lies past an exit, as words in a sentence: its view, or else the
-- name of the room it leads to, to whoever may go in. None when nothing
-- past it can be seen.
let _beyond (w: Driver.WorldView) actor (e: Driver.Exit) =
  match e.view with
  | Some v -> Some v
  | None -> if w.may_enter? actor e.to && w.made? e.to then Some (w.short_of e.to) else None

-- A view as a sentence of its own: "Door one, with a loud tick behind it."
-- A view that ends a sentence already, as one /approve writes, keeps its
-- own stop.
let _sentence phrase =
  let stop =
    if List.any? (fn p -> String.ends_with? p phrase) [".", "!", "?"] then "" else ".";
  "%{String.upper (String.slice 0 1 phrase)}%{String.slice 1 (String.length phrase) phrase}%{stop}"

-- The paragraph about a room's exits. Each direction past which something
-- can be seen has a sentence, as "To the north you see The Garden.", in
-- compass order. One more names the rest: the other exits, such as the
-- Learning Hall's doors, in the order of the rooms they lead to, and the
-- directions with nothing to see. A room whose way out is not an exit,
-- such as the editor, which `q` leaves, says so with an `exits` prop.
let _way_out (ctx: Driver.Context) = (
  let w = ctx.world;
  let exits =
    List.map (fn (n, e) -> (Driver.name_of n, e)) (Map.to_list (w.exits_of ctx.here));
  let directions =
    List.filter_map (fn d -> List.find (fn (n, _) -> n == d) exits) _directions;
  let seen =
    List.filter_map
      (fn (n, e) -> Option.map (fn b -> "%{_toward n} you see %{b}.") (_beyond w ctx.actor e))
      directions;
  let unseen =
    List.filter_map
      (fn (n, e) -> if _beyond w ctx.actor e == None then Some n else None)
      directions;
  let others =
    List.map
      (fn (n, _) -> n)
      (List.sort_by
        (fn (n, (e: Driver.Exit)) -> "%{w.short_of e.to} %{n}")
        (List.filter (fn (n, _) -> !(_direction? n)) exits));
  let rest = List.concat unseen others;
  let one = List.length rest == 1;
  let last =
    if rest == [] then []
    else if List.all? _compass? rest then
      ["You see %{if one then "an exit" else "exits"} to the %{Text.listing rest}."]
    else ["You see %{if one then "the exit" else "the exits"} %{Text.listing rest}."];
  match Option.and_then (fn j -> Result.to_option (JSON.get_string j)) (w.prop ctx.here "exits") with
  | Some line -> line
  | None -> if exits == [] then "There is no way out."
    else String.join " " (List.concat seen last)
)

-- A room: its name, its description, and what and who is in it; then a
-- paragraph about its exits.
let _room (ctx: Driver.Context) =
  let w = ctx.world;
  let file = Option.default ctx.here (List.head (String.split "#" ctx.here));
  let here = List.filter (fn o -> o != ctx.actor) (w.contents ctx.here);
  let people = List.filter w.player? here;
  let things = List.filter (fn o -> !(w.player? o)) here;
  -- Whoever may edit the room sees which file it is, after its name.
  let title =
    if w.may_edit? ctx.actor file then "%{w.short_of ctx.here} (%{file})"
    else w.short_of ctx.here;
  let lines =
    List.flatten [
      -- A blank line first, so the room stands apart from what was typed.
      ["", title, w.long_of ctx.here],
      if things == [] then []
      else ["You see %{Text.listing (List.map (fn o -> Text.a (w.short_of o)) things)}."],
      List.map
        (fn p -> if w.awake? p then "%{w.short_of p} is here."
          else "%{w.short_of p} is here, asleep.")
        people,
      ["", _way_out ctx]
    ];
  Driver.tell ctx (String.join "\n" lines)

-- `look at window`: a detail of the room, or of something in it or held.
let _detail (ctx: Driver.Context) words = (
  let w = ctx.world;
  let places = List.flatten [[ctx.here], w.contents ctx.here, w.contents ctx.actor];
  match List.head (List.filter_map (fn o -> w.detail_of o words) places) with
  | Some d -> Driver.tell ctx d
  | None -> Driver.tell ctx "You don't see a '%{words}' here."
)

-- `look east`: what lies that way, as through a window. The exit's view, as
-- "To the west you see ..." for a direction and as a sentence of its own
-- for another exit, as `look one`; and otherwise the room on the other
-- side, to anyone who may go in. A force hides a room you
-- may not enter, so no one sees into a private room, or one they are
-- banned from.
let _through (ctx: Driver.Context) name (e: Driver.Exit) = (
  let w = ctx.world;
  -- A view starts with a blank line, as a room does.
  match e.view with
  | Some v ->
    Driver.tell
      ctx
      (if _direction? name then "\n%{_toward name} you see %{v}." else "\n%{_sentence v}")
  | None -> if !(w.may_enter? ctx.actor e.to) then
      Driver.tell ctx "A force hides what lies that way."
    else if !(w.made? e.to) then Driver.tell ctx "You can't make out what lies that way."
    else Driver.tell ctx "\n%{w.short_of e.to}\n%{w.long_of e.to}"
)

-- `look`, `look lever`, `look at lever`, `look at window`, and `look east`.
let _look (ctx: Driver.Context) (p: Driver.Parsed) = (
  let words =
    String.trim
      (if String.starts_with? "at " p.rest then String.slice 3 (String.length p.rest) p.rest
      else p.rest);
  match (p.dobj, p.iobj) with
  | (Some o, _) -> Driver.tell ctx (ctx.world.long_of o)
  | (None, Some o) -> Driver.tell ctx (ctx.world.long_of o)
  | _ -> (
    if words == "" || words == "here" then _room ctx
    else match Driver.exit_named (String.lower words) (ctx.world.exits_of ctx.here) with
      | Some(name, e) -> _through ctx name e
      | None -> _detail ctx words
  )
)

-- ── go ─────────────────────────────────────────────────────────────────

let _opposites = Map.from_list [
  ("north", "the south"),
  ("south", "the north"),
  ("east", "the west"),
  ("west", "the east"),
  ("up", "below"),
  ("down", "above")
]

let _arrival name dir =
  match Map.get dir _opposites with
  | Some from -> "%{name} arrives from %{from}."
  | None -> "%{name} arrives."

-- `go north`, and a bare exit name, which the driver makes `go north`.
let _go (ctx: Driver.Context) (p: Driver.Parsed) = (
  let name = ctx.world.short_of ctx.actor;
  let typed = String.lower (String.trim p.rest);
  match Driver.exit_named typed (ctx.world.exits_of ctx.here) with
  | None -> Driver.tell ctx (if typed == "" then "Go where?" else "You can't go that way.")
  | Some(dir, e) -> (
    let check = Option.default (fn _ -> Ok()) e.check;
    if !(ctx.world.may_enter? ctx.actor e.to) then
      Driver.tell ctx "A force keeps you from going that way."
    else match check ctx with
      | Error why -> Driver.tell ctx why
      | Ok _ -> Driver.Reply(
        actions = List.flatten [
          List.map
            (fn o -> Driver.Tell o (Option.default "%{name} leaves %{dir}." e.leave))
            (Text.others ctx),
          List.map
            (fn o -> Driver.Tell o (Option.default (_arrival name dir) e.arrive))
            (_in ctx e.to),
          [Driver.Move ctx.actor e.to]
        ]
      )
  )
)

-- ── charters ───────────────────────────────────────────────────────────

-- Each Citizen owns the files in their own home: ann owns /r/home/ann/lamp.
let _home_owner path =
  match String.split "/" path with
  | ["" :: "r" :: "home" :: name :: _ :: _] -> Some (String.lower name)
  | _ -> None

-- The charters of the realms in the Commons. Only the Rules Hall may say a
-- player signed the rules, and only the editor may check and save files.
let _charter path =
  match path with
  | "/r/home" -> Driver.Charter(owner = Some _home_owner)
  | "/r/rules" -> Driver.Charter(grants = [Driver.MayAcknowledge])
  | "/r/editor" -> Driver.Charter(grants = [Driver.MayCheckSave])
  | _ -> Driver.Charter()

implement Driver.Blueprint =
  let create _ _ = Driver.Init(
    object = Realm.object "the Commons" [
      Driver.Verb(names = ["l*ook"], run = _look),
      Driver.Verb(names = ["go"], run = _go)
    ]
  )

implement Driver.Realm =
  let commands = Realm.anything;
  let allows = Realm.anything;
  let allowed = Driver.Everyone;
  let contracts = [];
  let charter = _charter
