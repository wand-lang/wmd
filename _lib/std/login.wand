uses {Random}

-- The login dialogue. One instance, /std/login#0, talks to every session
-- that has not logged in; the actor is the session. It never sees a
-- password once it is given: it asks the driver to log in or to register,
-- and the driver checks and keeps the hash.

import DateTime
import JSON
import Map
import Option
import Regex
import String

let Driver = import github.com/wand-lang/wmd/driver

-- Where one session is in the dialogue.
type Stage =
  AskName
  | AskPassword String
  | AskBirth String
  | NewPassword String
  | Confirm String String
  | Refused

-- 255 251 1 and 255 252 1: the server will and will not echo, so a
-- telnet client stops showing what is typed while a password is.
let _hide = "\xff\xfb\x01"

let _show = "\xff\xfc\x01"

let _ask = "What is your name?"

-- What a new connection sees first: a wall of doors, each a different
-- kind, and the last one open on the stars.
let _banner = `
  .=======================================================================.
  ||  _______     ___________      .-'''-.      __________      ______   ||
  || |#######|   |  _______  |    /  _ _  \    | |      | |    /      \  ||
  || |#|   |#|   | |       | |   |  | | |  |   |=|======|=|   / .  *   \ ||
  || |#|   |#|   | |  (@)  | |   |  | | |  |   | |      | |  | *   .   | ||
  || |#| o |#|   | |       | |   |  | | | o|   | |   o  | |  |o   *  . | ||
  || |#|   |#|   | |_______| |   |  | | |  |   |=|======|=|  |  .   *  | ||
  || |#|   |#|   |          o|   |  |_|_|  |   | |      | |  | *  .    | ||
  ||_|#######|___|___________|___|_________|___|_|______|_|__|_________|_||
  '======================================================================='

        W  O  R  L  D     O  F     M  A  N  Y     D  O  O  R  S

`

-- 2 to 16 letters, so a name is easy to type and cannot look like an id.
let _valid? name = Regex.match? r/^[A-Za-z]{2,16}$/ name

let _capitalize name =
  String.upper (String.slice 0 1 name) ++ String.lower (String.slice 1 (String.length name) name)

-- A date as written, YYYY-MM-DD, into its three numbers.
let _date text =
  match Regex.capture r/^(\d{4})-(\d{2})-(\d{2})$/ (String.trim text) with
  | [_, y, m, d] -> (
    match (String.to_int y, String.to_int m, String.to_int d) with
    | (Ok yy, Ok mm, Ok dd) -> Some(yy, mm, dd)
    | _ -> None
  )
  | _ -> None

-- Whether someone born on (y, m, d) is 13 or older at `now`: their
-- thirteenth birthday is on or before that day.
let _thirteen? (y, m, d) now =
  let ny = DateTime.year now;
  let nm = DateTime.month now;
  let nd = DateTime.day now;
  y + 13 < ny || y + 13 == ny && (m < nm || m == nm && d <= nd)

-- The dialogue, over where each session is in it.
let make (stages: Map Stage) = (
  let at (ctx: Driver.Context) stage = make (Map.set ctx.actor stage stages);
  let tell (ctx: Driver.Context) text next =
    Driver.Reply(actions = [Driver.Tell ctx.actor text], next = Some next);
  let line (ctx: Driver.Context) typed = (
    let text = String.trim typed;
    match Option.default AskName (Map.get ctx.actor stages) with
    | AskName ->
      if !(_valid? text) then tell ctx "A name is 2 to 16 letters. %{_ask}" (at ctx AskName)
      else (
        let name = _capitalize text;
        if ctx.world.account? name then tell ctx "%{_hide}Password:" (at ctx (AskPassword name))
        else
          tell
            ctx
            "Welcome, %{name}. What is your date of birth? Write it as YYYY-MM-DD."
            (at ctx (AskBirth name))
      )
    | AskPassword name ->
      Driver.Reply(
        actions = [Driver.Tell ctx.actor _show, Driver.Login ctx.actor name typed],
        next = Some (at ctx AskName)
      )
    | AskBirth name -> (
      match _date text with
      | None -> tell ctx "Write it as YYYY-MM-DD, as 2010-04-30." (at ctx (AskBirth name))
      | Some birth ->
        if _thirteen? birth ctx.time then
          tell ctx "Choose a password.\n%{_hide}Password:" (at ctx (NewPassword name))
        else
          Driver.Reply(
            actions = [
              Driver.Tell ctx.actor "Sorry, WMD is for people 13 and older. Goodbye.",
              Driver.Hangup ctx.actor
            ],
            next = Some (at ctx Refused)
          )
    )
    | NewPassword name ->
      if String.length typed < 8 then tell ctx "At least 8 characters.\nPassword:" (at ctx (NewPassword name))
      else tell ctx "Again:" (at ctx (Confirm name typed))
    | Confirm name first ->
      if typed != first then
        tell ctx "They did not match. Choose a password.\nPassword:" (at ctx (NewPassword name))
      else
        Driver.Reply(
          actions = [Driver.Tell ctx.actor _show, Driver.Register ctx.actor name first],
          next = Some (at ctx AskName)
        )
    | Refused -> Driver.nothing
  );
  -- The driver runs `connect` when a session connects, and `done` when it
  -- logs in or goes away, so no stage outlives its session.
  let connect (ctx: Driver.Context) _ =
    tell ctx "%{_banner}%{_ask}" (at ctx AskName);
  let done (ctx: Driver.Context) _ = Driver.Reply(next = Some (make (Map.delete ctx.actor stages)));
  Driver.Object(
    names = [],
    short = fn _ -> "the login",
    long = fn _ -> "Where a connection waits to log in.",
    verbs = [Driver.Verb(names = ["connect"], run = connect), Driver.Verb(names = ["done"], run = done)],
    input = Some line,
    -- A dialogue belongs to a connection, and connections are not saved.
    save = fn () -> JSON.null
  )
)

implement Driver.Blueprint =
  let create _ _ = Driver.Init(object = make Map.empty)
