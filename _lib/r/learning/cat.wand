uses {Random}

-- Lesson 3: a cat that wanders.
--
-- `heartbeat` is called every 2 seconds. Most of the time the cat does
-- nothing. Random.int picks a number, and `match` picks what to do with it:
-- wash, yawn, or walk out of the room through one of its exits.

import JSON
import List
import Map
import Random
import String

let Driver = import github.com/wand-lang/wmd/driver
let Text = import ../../std/text

-- The ways out of the room the cat is in. It stays in the Learning Hall
-- and its lessons.
let _ways (ctx: Driver.Context) =
  List.filter
    (fn (_, e) -> String.starts_with? "/r/learning/" e.to)
    (Map.to_list (ctx.world.exits_of ctx.here))

-- Which way the cat goes, in words: "to the north" for a direction, and
-- otherwise toward the room the exit leads to, as "toward The Learning
-- Hall", since an exit such as `six` or `through` is no place.
let _whither (ctx: Driver.Context) name (e: Driver.Exit) =
  let way = Driver.name_of name;
  if List.any? (fn d -> d == way) ["north", "south", "east", "west"] then "to the %{way}"
  else if way == "up" || way == "down" then way
  else "toward %{ctx.world.short_of e.to}"

-- Leave by a way picked at random. The first Say is heard in the room the
-- cat leaves. The Move takes it away, so the second Say is heard where it
-- arrives.
let _wander (ctx: Driver.Context) =
  match Random.choose (_ways ctx) with
  | Some(name, e) -> Driver.Reply(
    actions = [
      Driver.Say "The grey cat pads off %{_whither ctx name e}.",
      Driver.Move ctx.self e.to,
      Driver.Say "A grey cat pads in and looks around."
    ]
  )
  | None -> Driver.nothing

let cat =
  Driver.Object(
    names = ["cat", "grey cat"],
    short = fn _ -> "grey cat",
    long = fn _ -> "A grey cat with one white paw. It looks at you as if you were late.",
    verbs = [
      Driver.Verb(
        names = ["pet", "stroke"],
        dobj = Driver.This,
        run = fn ctx _ -> Driver.Reply(
          actions =
            Text.act
              ctx
              "You stroke the grey cat. It purrs."
              "%{ctx.world.short_of ctx.actor} strokes the grey cat. It purrs."
        )
      )
    ],
    heartbeat = Some (fn ctx ->
      match Random.int 0 29 with
      | 0 -> Driver.Reply(actions = [Driver.Say "The grey cat washes its white paw."])
      | 1 -> Driver.Reply(actions = [Driver.Say "The grey cat yawns."])
      | 2 -> _wander ctx
      | _ -> Driver.nothing),
    save = fn () -> JSON.null
  )

implement Driver.Blueprint =
  let create _ _ = Driver.Init(object = cat)
