uses {Random}

-- Lesson 6: a dark cave.
--
-- The cave has no light of its own. Its long text adds up the `light` prop
-- of everything in it with ctx.world.prop, so a lit lamp lights it and an
-- unlit one does not. The cave cannot change the lamp; it can only look.

import JSON
import List
import Option
import Result

let Driver = import github.com/wand-lang/wmd/driver
let Room = import ../../std/room

let _light (ctx: Driver.Context) id =
  Option.default
    0
    (Option.and_then (fn j -> Result.to_option (JSON.get_int j)) (ctx.world.prop id "light"))

let _lit (ctx: Driver.Context) =
  List.fold_left (fn n id -> n + _light ctx id) 0 (ctx.world.contents ctx.self)

let cave =
  Driver.Object(
    names = [],
    short = Room.text "Lesson 6: The Dark Cave",
    long = fn ctx -> if _lit ctx > 0 then
        "Lamplight shines on wet stone walls. Water drips somewhere further in. Read /help lesson6, then /copy here and /copy lamp to make them yours."
      else "It is pitch dark. Something metal clinks at your feet: a lamp, by the feel of it. Try light lamp.",
    exits = {hall = Room.exit "/r/learning/hall"},
    save = fn () -> JSON.null
  )

implement Driver.Blueprint =
  let create self saved = match saved with
  | None -> Driver.Init(object = cave, actions = [Driver.Spawn "/r/learning/lamp" self])
  | Some _ -> Driver.Init(object = cave)
