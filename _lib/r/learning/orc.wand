uses {Random}

-- The orc that lesson 5's room makes. A friendly one.

import JSON

let Driver = import github.com/wand-lang/wmd/driver
let Text = import ../../std/text

let orc =
  Driver.Object(
    names = ["orc"],
    short = fn _ -> "orc",
    long = fn _ -> "A short green orc in a knitted hat. It is eating cabbage.",
    verbs = [
      Driver.Verb(
        names = ["poke"],
        dobj = Driver.This,
        run = fn ctx _ -> Driver.Reply(
          actions =
            Text.act
              ctx
              "You poke the orc. It grunts and offers you some cabbage."
              "%{ctx.world.short_of ctx.actor} pokes the orc. It grunts."
        )
      )
    ],
    save = fn () -> JSON.null
  )

implement Driver.Blueprint =
  let create _ _ = Driver.Init(object = orc)
