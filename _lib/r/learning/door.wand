uses {Random}

-- Lesson 4: a door that closes itself.
--
-- Opening the door also gives back the action After 30s "close": a
-- call-out. The driver keeps it, and 30 seconds later it runs this door's
-- own verb `close`, with the door as the actor. If someone closed the door
-- first, the call-out finds it shut and does nothing.

import JSON
import List
import Result

let Driver = import ../../std/driver
let Text = import ../../std/text

type State(open: Bool = false)

let make (s: State) =
  Driver.Object(
    names = ["door", "green door"],
    short = fn _ -> "green door",
    long = fn _ -> if s.open then "A green door, standing open." else "A green door, shut.",
    -- What others may read: the room's exit asks whether the door is open.
    props = Some (fn _ -> {open = JSON.of_bool s.open}),
    verbs = [
      Driver.Verb(
        names = ["open"],
        dobj = Driver.This,
        run = fn ctx _ -> if s.open then Driver.tell ctx "It is open already."
          else Driver.Reply(
            actions =
              List.concat
                (Text.act
                  ctx
                  "You open the green door."
                  "%{ctx.world.short_of ctx.actor} opens the green door.")
                [Driver.After 30s "close"],
            next = Some (make State(open = true))
          )
      ),
      Driver.Verb(
        names = ["close", "shut"],
        dobj = Driver.This,
        run = fn ctx _ -> if !s.open then Driver.tell ctx "It is shut already."
          else Driver.Reply(
            actions = [Driver.Say "The green door swings shut."],
            next = Some (make State(open = false))
          )
      )
    ],
    save = fn () -> State.encoder s
  )

implement Driver.Blueprint =
  let create _ saved = match saved with
  | None -> Driver.Init(object = make State())
  | Some j -> Driver.Init(object = make (Result.get! (JSON.decode State.decoder j)))
