uses {Clock, Net.Listen, Shared}

-- A session runs in a test with no socket. A handler answers Net!listen
-- with fake connections, Net!read_line from a script, and Net!write into a
-- list. This is how sessions are tested, because wand cannot open a
-- connection to a port.

import Clock
import List
import Map
import Net
import Par
import Shared

let {test, group} = import Test

-- One fiber: read lines until the other end finishes, and echo each one.
let echo! conn =
  match Net.read_line conn with
  | Some line -> (Net.write! "you said: %{line}\n" conn; echo! conn)
  | None -> ()

-- Run `serve` on one fake connection whose input is `lines`, and give back
-- everything written to it.
let scripted! lines serve =
  with Shared.make lines as input ->
  with Shared.make [] as output -> (
    handle Net.listen :4000 |> Par.each_stream 1 serve with
    | Net!listen _ k -> k [()]
    | Net!read_line _ k -> (
      match Shared.get input with
      | [] -> k None
      | [l :: rest] -> (Shared.update input (fn _ -> rest); k (Some l))
    )
    | Net!write (_, text) k -> (Shared.update output (fn o -> List.concat o [text]); k Ok());
    Shared.get output
  )

group "one fiber" (fn () -> [
  test "reads the script and writes the replies" (fn t ->
    t.eq ["you said: hi\n", "you said: bye\n"] (scripted! ["hi", "bye"] echo!))
])

-- Two fibers: the reader puts replies in an outbox, and
-- the writer is the only one that writes to the socket.
let reader outbox conn =
  match Net.read_line conn with
  | Some line -> (
    Shared.update outbox (fn o -> List.concat o ["you said: %{line}\n"]);
    reader outbox conn
  )
  | None -> ()

-- Write what is in the outbox now. Only this fiber removes lines, so
-- dropping the ones it took loses none that the reader added since.
let drain! outbox conn = (
  let lines = Shared.get outbox;
  Shared.update outbox (fn o -> List.drop (List.length lines) o);
  List.each (fn l -> Net.write! l conn) lines
)

let writer! outbox conn = (drain! outbox conn; Clock.sleep 50ms; writer! outbox conn)

let pair_without_flush! conn =
  with Shared.make [] as outbox ->
  Par.all! [fn () -> reader outbox conn, fn () -> writer! outbox conn]

let pair! conn =
  with Shared.make [] as outbox -> (
    Par.all! [fn () -> reader outbox conn, fn () -> writer! outbox conn];
    drain! outbox conn
  )

group "a reader and a writer" (fn () -> [
  test "the writer's lines reach the handler" (fn t ->
    t.eq ["you said: hi\n", "you said: bye\n"] (scripted! ["hi", "bye"] pair!)),
  test "without a last drain, Par.all! stops the writer before it writes" (fn t ->
    t.eq [] (scripted! ["hi", "bye"] pair_without_flush!))
])

-- Several fake connections, each with its own script. A fake connection is
-- whatever Net!listen answers with; "%{conn}" shows it, so the handler can
-- tell the connections apart.
let scripted_many! scripts serve =
  with Shared.make scripts as input ->
  with Shared.make Map.empty as output -> (
    handle Net.listen :4000 |> Par.each_stream 8 serve with
    | Net!listen _ k -> k (Map.keys scripts)
    | Net!read_line conn k -> (
      let name = "%{conn}";
      match Map.get name (Shared.get input) with
      | Some [l :: rest] -> (Shared.update input (Map.set name rest); k (Some l))
      | _ -> k None
    )
    | Net!write (conn, text) k -> (
      Shared.update output (Map.update "%{conn}" [] (fn o -> List.concat o [text]));
      k Ok()
    );
    Shared.get output
  )

group "two connections" (fn () -> [
  test "each gets the replies to its own lines" (fn t ->
    t.eq
      (Map.from_list [
        ("ann", ["you said: hi\n"]),
        ("bo", ["you said: yo\n", "you said: bye\n"])
      ])
      (scripted_many! (Map.from_list [("ann", ["hi"]), ("bo", ["yo", "bye"])]) pair!))
])
