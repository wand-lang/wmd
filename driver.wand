-- The contract between the driver and every Library file.
--
-- A Library file is a blueprint: it implements Blueprint, and the driver
-- calls its `create` once for each instance it spawns. An object never
-- changes the world. It returns Actions, and the next version of itself,
-- and the driver checks and applies them.

import List
import Map
import Option
import String

-- An object's id: its blueprint's path and an instance number, as in
-- /r/lever#0. A connection that has not logged in yet is a
-- session id, such as session:3fa9c2d1b07e, which never starts with /.
type ObjId = String

-- What a verb takes as its direct or indirect object: nothing, the object
-- the verb is on, or any object.
type Arg = NoArg | This | AnyObj

-- A parsed line. `put lever in box` is verb "put", dobj the lever, prep
-- "in", iobj the box. `rest` is the text after the verb, as typed, for
-- verbs that take free text, such as say.
type Parsed(
  verb: String,
  dobj: Option ObjId = None,
  prep: Option String = None,
  iobj: Option ObjId = None,
  rest: String = ""
)

-- A read-only view of the world as it is when the call starts. Reading
-- stays pure: each function answers from the same moment.
type WorldView(
  contents: ObjId -> List ObjId,
  env_of: ObjId -> Option ObjId,
  short_of: ObjId -> String,
  long_of: ObjId -> String,
  exits_of: ObjId -> Map Exit,
  player?: ObjId -> Bool,
  players: Unit -> List ObjId,
  -- Whether an account of this name exists. Nothing else about an account
  -- is readable: no Library code sees a password hash.
  account?: String -> Bool,
  -- A detail of an object: scenery to look at that is not an object of its
  -- own, as "window" in a room.
  detail_of: ObjId -> String -> Option String,
  -- A value an object shows the world, as a lamp shows whether it is lit.
  -- Objects can only look: changing another object is still an action.
  prop: ObjId -> String -> Option JSON,
  -- Whether a body has a session. One without is asleep.
  awake?: ObjId -> Bool,
  -- Where a body goes home to.
  home_of: ObjId -> ObjId,
  -- Whether a body may go into a room. A private room is closed to all
  -- but its owner, whoever it invites, and the admins.
  may_enter?: ObjId -> ObjId -> Bool,
  -- Whether a player may edit the file of a blueprint path, as /r/home/ann/lamp.
  may_edit?: ObjId -> String -> Bool,
  -- Whether an object has been made yet. A room is made the first time
  -- someone goes there.
  made?: ObjId -> Bool,
  -- A help topic, as /help shows it: "rules" is the community rules.
  help_of: String -> Option String
)

-- Who is asking, about what, where and when. `self` is the object the call
-- is on. `actor` is the player who typed the command, or `self` when the
-- driver calls an object on its own, as for a heartbeat. `time` is when the
-- command arrived, or when the driver made the call: Library code reads no
-- clock of its own.
type Context(self: ObjId, actor: ObjId, here: ObjId, world: WorldView, time: DateTime)

-- A way out of a room. A message left as None gets the driver's default.
-- `check` refuses with the message the mover sees, as in
-- Error "The door is locked."
type Exit(
  to: ObjId,
  leave: Option String = None,
  arrive: Option String = None,
  check: Option (Context -> Result String Unit) = None,
  -- What `look` that way shows, as through a window. With none, it shows
  -- the room on the other side, to anyone who may go in.
  view: Option String = None
)

-- Everything an object can ask of the world.
type Action =
  -- Show a line to everyone in the room the object is in.
  Say String
  -- Show a line to one player.
  | Tell ObjId String
  -- Move an object into another.
  | Move ObjId ObjId
  -- Make a new instance of a blueprint, inside an object.
  | Spawn String ObjId
  -- Log a session in as an account, with the password it gave. Only
  -- /std/login may ask this; the driver checks the password.
  | Login ObjId String String
  -- Make an account for a session, with its name and password. Only
  -- /std/login may ask this.
  | Register ObjId String String
  -- End a session. Only /std/login may ask this.
  | Hangup ObjId
  -- Take an object out of the world: the object itself, or something it
  -- holds. A player's body cannot be removed, nor anything that holds one.
  | Remove ObjId
  -- Check the source of the Library file for a blueprint path, such as
  -- /r/home/ann/lamp, without saving it. Only /r/editor may ask this, and
  -- only for a file the actor may edit. The driver answers through the
  -- asking object's `result` verb, with an Outcome as JSON in `rest`.
  | Check String String
  -- Format, check and gate the source, and save it when all three pass.
  -- The same rules and answer as Check.
  | Save String String
  -- Save the source as it is, checked or not, to keep unfinished work. It
  -- is formatted when it parses. The same rules and answer as Check.
  | Draft String String
  -- Run source as /eval runs an expression: the editor's buffer, when it
  -- was opened with /eval and no expression. Only /r/editor may ask
  -- this.
  | Run String
  -- Say that a player has read and signed the current rules. Only the
  -- Rules Hall, /r/rules, may ask this; the driver keeps the signing on
  -- the account and moves the body to the Commons.
  | Acknowledge ObjId
  -- Run the object's own verb of this name once, with no arguments, after
  -- this long: a call-out. The driver keeps it in world.json, so it
  -- survives a restart, and drops it when the object is removed.
  | After Duration String

-- A command the object answers to. `run` gets the parsed command, with
-- dobj and iobj already matched to objects.
type Verb(
  names: List String,
  dobj: Arg = NoArg,
  iobj: Arg = NoArg,
  run: Context -> Parsed -> Reply ! {Random, Raise}
)

type Object(
  names: List String,
  short: Context -> String,
  long: Context -> String,
  verbs: List Verb = [],
  exits: Map Exit = {},
  -- Scenery by name: `look at window` reads `details.window`.
  details: Map (Context -> String) = {},
  -- What the object shows the world, read by others with `prop`. A room
  -- with an `exits` prop, a string, shows it where `look` would list its
  -- exits.
  props: Option (Context -> Map JSON) = None,
  -- Called after something arrives in the object, or leaves it, by any
  -- route: an exit, a spawn, being picked up. A move a hook makes does not
  -- call hooks again in the same step, so hooks cannot loop.
  on_enter: Option (Context -> ObjId -> Reply ! {Random, Raise}) = None,
  on_leave: Option (Context -> ObjId -> Reply ! {Random, Raise}) = None,
  -- While the room a player is in has one, the player's lines come here
  -- unparsed.
  input: Option (Context -> String -> Reply ! {Random, Raise}) = None,
  -- Called every 2 seconds, for what an object does on its own: a cat
  -- that wanders, a fire that dies down.
  heartbeat: Option (Context -> Reply ! {Random, Raise}) = None,
  -- The state to keep: what `create` gets back as `saved`.
  save: Unit -> JSON
)

-- One thing a check found, at a line and column of the source.
-- `severity` is "error" or "warning". Only errors stop a save.
type Problem(severity: String, line: Int, col: Int, message: String)

-- The driver's answer to Check, Save or Draft. `action` names which.
-- `effects` is what the source performs, when it checks. `text` is the
-- source as saved, formatted, when the action saved it.
type Outcome(
  action: String,
  path: String,
  ok: Bool,
  problems: List Problem = [],
  effects: List String = [],
  text: Option String = None
)

-- What an /eval gives back: actions for the driver to check and apply, as
-- any object's are, or a value to show, written with its type.
type Evaluated = Shown String | Acts (List Action)

-- What /eval runs. The driver writes a module for each expression, which
-- implements this, and loads it as a Library file loads: checked, and held
-- to the effects `evaluate` allows.
interface Evaluation(evaluate: Context -> Evaluated ! {Random, Raise})

-- What a verb gives back: actions for the driver, and the next version of
-- the object, when it changed.
type Reply(actions: List Action = [], next: Option Object = None)

-- What `create` gives back: the object, and actions to apply once it
-- exists. A restored object gets no starting actions, or a restart would
-- spawn its contents again.
type Init(object: Object, actions: List Action = [])

-- What every Library file implements, as `implement Driver.Blueprint`.
-- `create self saved` builds the instance `self`, from its saved state or,
-- when `saved` is None, new.
interface Blueprint(create: ObjId -> Option JSON -> Init ! {Random, Raise})

-- Who may enter a room: everyone, which is a public room, or only the
-- accounts in the list, by key, which is a private one. A room's owner and
-- the admins may always enter.
type Allowed = Everyone | Only (List String)

-- What only the objects of some realms may ask for.
type Grant =
  -- Say a player signed the rules: Acknowledge.
  MayAcknowledge
  -- Check, save and run source for the player at the editor: Check, Save,
  -- Draft and Run.
  | MayCheckSave

-- What the realm above says of a realm inside it: who owns each of the
-- realm's files, by account key, as ann for /r/home/ann/lamp, with no
-- rule, or a rule that says None, for the Keymasters; the Citizens, by key, who keep it for the Keymasters, its
-- Stewards; and what its own objects may ask for that others may not. A
-- realm's Stewards may change its own file, so none of this is in it:
-- they could name more Stewards, or give themselves grants.
type Charter(
  owner: Option (String -> Option String) = None,
  stewards: List String = [],
  grants: List Grant = []
)

-- A Steward's contract with a Citizen, by key, to build for the realm in
-- the directory `path`, as /r/guild/forge: the Citizen may edit the files
-- there, which the realm owns, until the contract is taken out.
type Contract(path: String, builder: String)

-- An area of the world with rules of its own, such as the Home realm or the
-- Rules Hall. A realm is the file beside its directory: /r/home is the
-- realm of the rooms in /r/home/, and /r, the Commons, of every room under
-- /r. It also implements Blueprint: its one instance holds the verbs every
-- room in the realm answers to, after the room's own.
--
-- The driver asks the nearest realm above a file, and each realm above
-- that, up to the Commons. A rule can only refuse more than the driver's
-- own policy does, and every realm in the chain must allow a command or an
-- action. A realm's charter comes from the realm above it; the Commons,
-- which has none above it, is the Keymasters' alone. The driver honors a
-- realm only when the Keymasters own its file.
interface Realm(
  -- Whether a command works here: a verb, or a / command such as /edit.
  -- Error says why not, to the player who typed it.
  commands: Context -> String -> Result String Unit ! {Random, Raise},
  -- Whether an object here may ask for an action. Error says why not.
  allows: Context -> Action -> Result String Unit ! {Random, Raise},
  -- Who may enter a new room of the realm, until its owner says otherwise.
  allowed: Allowed,
  -- The Citizens building for the realm, which its Stewards write.
  contracts: List Contract,
  -- The charter of each realm inside this one, by the path of its file.
  charter: String -> Charter ! {Random, Raise}
)

-- A reply that changes nothing.
let nothing = Reply()

-- A reply that only shows the actor a line.
let tell (ctx: Context) line = Reply(actions = [Tell ctx.actor line])

-- What a game tells the driver as it starts: the blueprints of its login,
-- a player's body, the room a new body arrives in, the room where the
-- rules are signed, and the editor; the directory of the examples /copy
-- copies from, and of every Citizen's home; how a file at the root of its
-- lib/ imports this contract, as ./std/driver or github.com/wand-lang/wmd/driver;
-- and the source of a room /dig makes at a path, with an exit back by a
-- name to the room it was dug from. That source has a line that is
-- `dig_marker`, with its exits below it, which /dig adds to.
type Start(
  login: String,
  player: String,
  arrival: String,
  rules: String,
  editor: String,
  examples: String,
  homes: String,
  driver: String,
  dig: String -> String -> String -> String
)

-- What every game implements, in its lib/init.wand, as
-- `implement Driver.Library`.
interface Library(start: Start)

-- The line above a room's exits that /dig and /link may add to.
let dig_marker = "-- The exits. /dig adds one here, and you can change them by hand."

-- ── Names ──────────────────────────────────────────────────────────────

-- A verb's, an exit's or a thing's name may have a `*` in it: then it can
-- be shortened to any start of it as long as the part before the `*`.
-- `l*ook` is l, lo, loo or look, and `n*orth` is n to north. A verb or an
-- exit with no `*` is written in full. A thing with none can be named by
-- any start of its name.

-- A name as it is shown: look for `l*ook`.
let name_of n = String.replace "*" "" n

-- Whether `word` names `n`: the whole name, or a start of it at least as
-- long as the part before its `*`.
let names? n word =
  match String.split "*" n with
  | [least, rest] ->
    String.starts_with? least word && String.starts_with? word "%{least}%{rest}"
  | _ -> word == n

-- The exit that `words` name, with its name as shown: ("north", e) for n
-- in `{"n*orth" = e}`. A name may be several words, as "the commons", and
-- case and the spaces between words do not count. A name in full beats a
-- start of one.
let exit_named words (exits: Map Exit) = (
  let plain s = String.join " " (String.words (String.lower s));
  let typed = plain words;
  let all = Map.to_list exits;
  let shown (n, e) = (name_of n, e);
  match List.find (fn (n, _) -> plain (name_of n) == typed) all with
  | Some found -> Some (shown found)
  | None -> Option.map shown (List.find (fn (n, _) -> names? (plain n) typed) all)
)

-- The name /dig gives an exit: the six directions with their short forms,
-- n*orth to d*own, and any other name as it is.
let starred name =
  match name with
  | "north" -> "n*orth"
  | "south" -> "s*outh"
  | "east" -> "e*ast"
  | "west" -> "w*est"
  | "up" -> "u*p"
  | "down" -> "d*own"
  | _ -> name

-- The directories a blueprint's file is in, from the Library root: r and
-- learning for /r/learning/lever.
let _dir path =
  List.reverse
    (List.drop 1 (List.reverse (List.filter (fn s -> s != "") (String.split "/" path))))

-- How many leading directories two lists share.
let _common xs ys =
  match (xs, ys) with
  | ([x :: xt], [y :: yt]) when x == y -> 1 + _common xt yt
  | _ -> 0

-- The relative import from the file of blueprint path `from` to the file
-- of blueprint path `to`: ../std/room from /r/square to /std/room, and
-- ./orc from /r/learning/orcs to /r/learning/orc.
let import_from from to =
  let dir = _dir from;
  let target = List.filter (fn s -> s != "") (String.split "/" to);
  let shared = _common dir target;
  let rest = String.join "/" (List.drop shared target);
  let up = List.length dir - shared;
  if up == 0 then "./%{rest}" else "%{String.repeat up "../"}%{rest}"
